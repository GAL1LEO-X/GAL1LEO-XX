+			t.Fatalf("archive case%d: %v", i, err)
+		}
+	}
+	starCases := []*pb.SetMessageStarRequest{
+		nil,
+		{Session: session, IntentId: "I", TimestampMs: intent},
+		{Session: session, Key: &pb.ABMessageKey{Chat: "900001@lid"}, IntentId: "I", TimestampMs: intent},
+		{Session: session, Key: &pb.ABMessageKey{Chat: "900001@lid", Id: "M", Participant: "900002@lid"}, IntentId: "I", TimestampMs: intent},
+		{Session: session, Key: &pb.ABMessageKey{Chat: "12025550101-123@g.us", Id: "M"}, IntentId: "I", TimestampMs: intent},
+		{Session: session, Key: &pb.ABMessageKey{Chat: "12025550101-123@g.us", Id: "M", FromMe: true}, IntentId: "I", TimestampMs: intent},
+	}
+	for i, request := range starCases {
+		if _, err := service.SetMessageStar(context.Background(), request); status.Code(err) != codes.InvalidArgument {
+			t.Fatalf("star case%d: %v", i, err)
+		}
