diff --git a/src/storage/message_key.go b/src/storage/message_key.go
new file mode 100644
index 0000000000000000000000000000000000000000..989eab4a8df11322672fafb9b37d51e57d05615b
--- /dev/null
+++ b/src/storage/message_key.go
@@ -0,0 +1,142 @@
+package storage
+
+import (
+	"errors"
+	"fmt"
+
+	"go.mau.fi/whatsmeow/proto/waCommon"
+	"go.mau.fi/whatsmeow/proto/waE2E"
+	"go.mau.fi/whatsmeow/proto/waWeb"
+	"go.mau.fi/whatsmeow/types"
+	"go.mau.fi/whatsmeow/types/events"
+)
+
+var ErrMessageKeyConflict = errors.New("message key conflicts with stored message")
+var ErrInvalidMessageKey = errors.New("incomplete message key")
+var ErrMessageMutationConflict = errors.New("conflicting edits with the same timestamp")
+
+// MessageKey is the identity required to change a cached message. The legacy
+// lookup API accepts only an ID, so collisions must be rejected, never merged.
+type MessageKey struct {
+	Chat        string
+	ID          string
+	FromMe      bool
+	Participant string
+}
+
+func MessageKeyFromInfo(info types.MessageInfo) (MessageKey, error) {
+	key := MessageKey{Chat: info.Chat.ToNonAD().String(), ID: info.ID, FromMe: info.IsFromMe}
+	if info.Chat.IsEmpty() || info.ID == "" {
+		return key, ErrInvalidMessageKey
+	}
+	if info.Chat.Server == types.GroupServer {
+		if info.Sender.IsEmpty() {
+			return key, fmt.Errorf("%w: group participant is missing", ErrInvalidMessageKey)
+		}
+		key.Participant = info.Sender.ToNonAD().String()
+	}
+	return key, nil
+}
+
+func RequireMessageKey(msg *StoredMessage, expected MessageKey) error {
+	if msg == nil || msg.Message == nil {
+		return ErrInvalidMessageKey
+	}
+	actual, err := MessageKeyFromInfo(msg.Info)
+	if err != nil {
+		return err
+	}
+	if actual != expected {
+		return ErrMessageKeyConflict
+	}
+	return nil
+}
+
+func MutationProtocol(content *waE2E.Message) *waE2E.ProtocolMessage {
+	for depth := 0; content != nil && depth < 8; depth++ {
+		switch {
+		case content.GetProtocolMessage() != nil:
+			return content.GetProtocolMessage()
+		case content.GetEditedMessage() != nil:
+			content = content.GetEditedMessage().GetMessage()
+		case content.GetEphemeralMessage() != nil:
+			content = content.GetEphemeralMessage().GetMessage()
+		case content.GetDeviceSentMessage() != nil:
+			content = content.GetDeviceSentMessage().GetMessage()
+		default:
+			return nil
+		}
+	}
+	return nil
+}
+
+func EventMutationProtocol(event *events.Message) *waE2E.ProtocolMessage {
+	if event.SourceWebMsg != nil && (event.SourceWebMsg.GetMessageStubType() == waWeb.WebMessageInfo_REVOKE || event.SourceWebMsg.GetRevokeMessageTimestamp() != 0) {
+		// Storage consumes the full-key history tombstone directly.
+		return nil
+	}
+	if p := MutationProtocol(event.Message); p != nil {
+		return p
+	}
+	// ParseWebMessage unwraps history edits into their edited content and moves
+	// Info.ID to the original ID. The retained raw envelope still has the key.
+	return MutationProtocol(event.RawMessage)
+}
+
+// ResolveMutationKey follows whatsmeow's sender-relative key semantics. The
+// authenticated envelope determines the local chat. For an incoming DM the
+// wire RemoteJID is our own JID, not the envelope's chat JID.
+func ResolveMutationKey(info types.MessageInfo, wire *waCommon.MessageKey, ownIDs ...types.JID) (MessageKey, error) {
+	key := MessageKey{Chat: info.Chat.ToNonAD().String()}
+	if wire == nil || wire.GetID() == "" || wire.FromMe == nil || info.Chat.IsEmpty() {
+		return key, ErrInvalidMessageKey
+	}
+	key.ID = wire.GetID()
+	if (info.IsFromMe || info.Chat.Server == types.GroupServer) && wire.GetRemoteJID() != "" {
+		remote, err := types.ParseJID(wire.GetRemoteJID())
+		if err != nil || remote.ToNonAD() != info.Chat.ToNonAD() {
+			return key, ErrMessageKeyConflict
+		}
+	}
+	if wire.GetFromMe() {
+		key.FromMe = info.IsFromMe
+		if info.Chat.Server == types.GroupServer {
+			if info.Sender.IsEmpty() {
+				return key, ErrInvalidMessageKey
+			}
+			key.Participant = info.Sender.ToNonAD().String()
+			if wire.GetParticipant() != "" {
+				participant, err := types.ParseJID(wire.GetParticipant())
+				if err != nil || participant.ToNonAD().String() != key.Participant {
+					return key, ErrMessageKeyConflict
+				}
+			}
+		}
+		return key, nil
+	}
+	if info.Chat.Server != types.GroupServer {
+		key.FromMe = !info.IsFromMe
+		return key, nil
+	}
+	participant, err := types.ParseJID(wire.GetParticipant())
+	if err != nil || participant.IsEmpty() || participant.ToNonAD() == info.Sender.ToNonAD() {
+		return key, ErrInvalidMessageKey
+	}
+	key.Participant = participant.ToNonAD().String()
+	if info.IsFromMe {
+		return key, nil // Outgoing admin revoke of another participant.
+	}
+	knownOwn := false
+	for _, own := range ownIDs {
+		if !own.IsEmpty() {
+			knownOwn = true
+			if own.ToNonAD() == participant.ToNonAD() {
+				key.FromMe = true
+			}
+		}
+	}
+	if !knownOwn {
+		return key, fmt.Errorf("%w: own identity required for incoming admin revoke", ErrInvalidMessageKey)
+	}
+	return key, nil
+}
