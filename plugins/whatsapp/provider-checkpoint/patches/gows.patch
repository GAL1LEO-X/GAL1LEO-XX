+func TestABArchiveRangeFixtureAndIsolation(t *testing.T) {
+	chat := abStateJID("12025550101-123@g.us")
+	key := ABMessageKey{Chat: chat, ID: "GROUP_MESSAGE", FromMe: false, Participant: abStateJID("900001@lid")}
+	anchor := ABMessageRange{Key: key, TimestampMS: abStateIntent.TimestampMS - 10000}
+	patch, err := BuildABArchivePatch(chat, true, abStateIntent, []ABMessageRange{anchor})
+	if err != nil {
+		t.Fatal(err)
+	}
+	messageRange := patch.Mutations[0].Value.GetArchiveChatAction().GetMessageRange()
+	if len(messageRange.GetMessages()) != 1 || messageRange.GetLastMessageTimestamp() != anchor.TimestampMS/1000 {
+		t.Fatal("anchor fixture range mismatch")
+	}
+	message := messageRange.GetMessages()[0]
+	if message.GetTimestamp() != anchor.TimestampMS/1000 || message.GetKey().GetRemoteJID() != chat.String() || message.GetKey().GetParticipant() != key.Participant.String() || message.GetKey().GetID() != key.ID || message.GetKey().GetFromMe() {
+		t.Fatal("anchor fixture identity mismatch")
+	}
+	bad := []struct {
+		name   string
+		intent ABIntent
+		ranges []ABMessageRange
+	}{
+		{"wrong chat", abStateIntent, []ABMessageRange{{Key: ABMessageKey{Chat: abStateJID("12025550102@s.whatsapp.net"), ID: "OTHER"}, TimestampMS: anchor.TimestampMS}}},
+		{"zero timestamp", abStateIntent, []ABMessageRange{{Key: key}}},
+		{"future anchor", abStateIntent, []ABMessageRange{{Key: key, TimestampMS: abStateIntent.TimestampMS + 1}}},
+		{"multiple anchors", abStateIntent, []ABMessageRange{anchor, anchor}},
+		{"no frozen timestamp", ABIntent{ID: "missing_timestamp"}, nil},
+		{"no intent", ABIntent{TimestampMS: abStateIntent.TimestampMS}, nil},
+	}
+	for _, tc := range bad {
+		t.Run(tc.name, func(t *testing.T) {
+			if _, err := BuildABArchivePatch(chat, true, tc.intent, tc.ranges); !errors.Is(err, ErrABInvalidArgument) {
+				t.Fatalf("expected validation error, got %v", err)
