diff --git a/checkpoints/offline-ab/vertical.cjs b/checkpoints/offline-ab/vertical.cjs
new file mode 100644
index 0000000000000000000000000000000000000000..73d99edfadfc7d4ad17707fa06a087e18d00f73b
--- /dev/null
+++ b/checkpoints/offline-ab/vertical.cjs
@@ -0,0 +1,44 @@
+// Uses the real adapter and generated client against the separate Go fake backend.
+const assert = require('node:assert/strict');
+const grpc = require('@grpc/grpc-js');
+const { messages } = require('./build/grpc/gows');
+const { GowsABAdapter, ABMutationUncertainError } = require('./build/ab.adapter');
+const { withABIntentHeaders } = require('./build/ab.intent');
+
+const address = process.argv[2];
+if (!/^127\.0\.0\.1:[1-9][0-9]*$/.test(address ?? '')) {
+  throw new Error('Pass the Go offline fixture loopback address');
+}
+const client = new messages.MessageServiceClient(address, grpc.credentials.createInsecure(), { 'grpc.enable_retries': 0 });
+let session = new messages.Session({ id: 'fixture-a' });
+let calls = 0;
+const adapter = new GowsABAdapter({
+  client: function () { calls++; return client; },
+  session: function () { return session; },
+});
+
+async function main() {
+  const contract = await adapter.getABCapabilities();
+  assert.equal(contract.version, 'gows-ab-v1');
+  assert.equal(new Set(contract.operations).size, 8);
+  assert.deepEqual(await adapter.getContactAbout('1@c.us'), { about: 'fixture-about-✓' });
+  assert.deepEqual(await adapter.getContactAbout('2@c.us'), { about: '' });
+  assert.deepEqual(await adapter.getContactAbout('3@c.us'), { about: null });
+  await assert.rejects(adapter.getContactAbout('4@c.us'));
+  const accepted = await withABIntentHeaders('vertical-durable-123', '1792400000123', function () { return adapter.blockContact('1@c.us'); });
+  assert.equal(accepted.intentId, 'vertical-durable-123');
+  await adapter.unblockContact('1@c.us');
+  await adapter.chatsArchiveChat('1@c.us');
+  await adapter.chatsUnarchiveChat('1@c.us');
+  await adapter.setStar({ chatId: '1@c.us', messageId: 'false_1@c.us_SOURCE', star: true });
+  await adapter.setStar({ chatId: '1@c.us', messageId: 'false_1@c.us_SOURCE', star: false });
+  assert.equal(await adapter.pinMessage('1@c.us', 'false_1@c.us_SOURCE', 86400), true);
+  assert.equal(await adapter.unpinMessage('1@c.us', 'false_1@c.us_SOURCE'), true);
+  const before = calls;
+  await assert.rejects(adapter.blockContact('5@c.us'), ABMutationUncertainError);
+  assert.equal(calls, before + 1);
+  session = new messages.Session({ id: 'invalid-session' });
+  await assert.rejects(adapter.blockContact('1@c.us'), function (error) { return error.code === grpc.status.NOT_FOUND; });
+  process.stdout.write(JSON.stringify({ result: 'pass', operations: 8, rpcCalls: calls, adapter: 'src/core/engines/gows/ab.adapter.ts', transport: 'real loopback gRPC / Go fake backend', whatsappNetwork: false }) + '\n');
+}
+main().finally(function () { client.close(); }).catch(function (error) { process.stderr.write(error.stack + '\n'); process.exitCode = 1; });
