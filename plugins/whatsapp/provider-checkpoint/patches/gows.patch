+package server
+
+import (
+	"context"
+
+	"github.com/devlikeapro/gows/gows"
+	pb "github.com/devlikeapro/gows/proto"
+	"go.mau.fi/whatsmeow/types"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/status"
+)
+
+// SetMessagePin is a typed message-pin operation, not an arbitrary protobuf
+// send RPC. Accepted confirms the transport result, not phone visibility.
+func (s *Server) SetMessagePin(ctx context.Context, req *pb.SetMessagePinRequest) (*pb.ABMutationResponse, error) {
+	key, err := abParseMessageKey(req.GetKey())
+	if err != nil {
+		return nil, err
+	}
+	if key.Chat.Server == types.GroupServer && key.Participant.IsEmpty() {
+		return nil, status.Error(codes.InvalidArgument, "complete group message participant required")
+	}
+	duration := gows.ABPinDuration(req.GetDuration())
+	if err = gows.ValidateABPinDuration(duration, req.GetPinned()); err != nil {
+		return nil, abError(err)
+	}
+	intent, err := abParseIntent(req.GetIntentId(), req.GetTimestampMs())
+	if err != nil {
+		return nil, err
+	}
+	client, err := s.abClient(req.GetSession())
+	if err != nil {
+		return nil, err
+	}
+	result, err := client.SetMessagePin(ctx, key, req.GetPinned(), duration, intent)
+	return abMutationResponse(result, err)
+}
