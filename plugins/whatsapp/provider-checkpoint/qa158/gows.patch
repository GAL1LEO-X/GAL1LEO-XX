+func TestReceiptAliasQueryParametersErrorsAndLimits(t *testing.T) {
+	for _, tc := range []struct {
+		name   string
+		script *aliasScript
+		want   storage.ReceiptAliasRelation
+	}{
+		{"pair", &aliasScript{values: [][]driver.Value{{aliasLID.User, aliasPN.User}}}, storage.AliasPair},
+		{"sql-error", &aliasScript{err: errors.New("PRIVATE-SQL-ERROR")}, storage.AliasReadError},
+		{"scan-error", &aliasScript{values: [][]driver.Value{{nil, aliasPN.User}}}, storage.AliasReadError},
+		{"iteration-error", &aliasScript{values: [][]driver.Value{{aliasLID.User, aliasPN.User}}, rowError: true}, storage.AliasReadError},
+		{"bounded-rows", &aliasScript{values: [][]driver.Value{{aliasLID.User, aliasPN.User}, {aliasLID.User, aliasPN.User}, {aliasLID.User, aliasPN.User}, {nil, nil}}}, storage.AliasConflict},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			script := tc.script
+			s := aliasFake(t, script)
+			if got := s.ObserveReceiptAlias(context.Background(), aliasPN, aliasLID); got != tc.want {
+				t.Fatalf("got %s", got)
+			}
+			script.mu.Lock()
+			defer script.mu.Unlock()
+			if script.calls != 1 || script.query != receiptAliasQuery || len(script.args) != 2 || script.args[0].Value != aliasLID.User || script.args[1].Value != aliasPN.User || script.missingDeadline {
+				t.Fatal("query contract/retry/deadline changed")
+			}
+		})
+	}
+}
