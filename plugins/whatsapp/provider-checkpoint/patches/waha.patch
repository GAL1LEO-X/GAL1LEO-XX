diff --git a/src/core/engines/gows/message.identity.ts b/src/core/engines/gows/message.identity.ts
new file mode 100644
index 0000000000000000000000000000000000000000..df69192b9fd2fa836ef47e12afff70a9875378b0
--- /dev/null
+++ b/src/core/engines/gows/message.identity.ts
@@ -0,0 +1,111 @@
+import { UnprocessableEntityException } from '@nestjs/common';
+
+export interface GowsMessageIdentity {
+  chat: string;
+  id: string;
+  fromMe?: boolean;
+  participant?: string;
+}
+
+/**
+ * The legacy RPC looks up short IDs only. Keep its supported short-ID and
+ * three/four-part serialized inputs, but bind the lookup to the requested chat.
+ * Historical identifiers must not run phone/alias hooks.
+ */
+export function parseGowsMessageIdentity(
+  chatId: string,
+  messageId: string,
+  edit: boolean = false,
+): GowsMessageIdentity {
+  const chat = canonicalJid(chatId, true);
+  if (typeof messageId !== 'string' || !messageId || /\s/.test(messageId)) {
+    throw new UnprocessableEntityException('Invalid message identity');
+  }
+  const parts = messageId.split('_');
+  if (parts.length === 1) {
+    return { chat: chat, id: messageId, fromMe: edit ? true : undefined };
+  }
+  if (
+    (parts.length !== 3 && parts.length !== 4) ||
+    !['true', 'false'].includes(parts[0]) ||
+    !parts[2] ||
+    (parts.length === 4 && !parts[3])
+  ) {
+    throw new UnprocessableEntityException('Invalid serialized message identity');
+  }
+  if (canonicalJid(parts[1]) !== chat) {
+    throw new UnprocessableEntityException(
+      'Message identity does not match the requested chat',
+    );
+  }
+  const fromMe = parts[0] === 'true';
+  if (edit && !fromMe) {
+    throw new UnprocessableEntityException('Only own messages can be edited');
+  }
+  const participant =
+    parts.length === 4 ? canonicalJid(parts[3]) : undefined;
+  if (
+    participant !== undefined &&
+    !/^[1-9][0-9]*@(s\.whatsapp\.net|lid)$/.test(participant)
+  ) {
+    throw new UnprocessableEntityException('Invalid message participant');
+  }
+  return {
+    chat: chat,
+    id: parts[2],
+    fromMe: fromMe,
+    participant: participant,
+  };
+}
+
+/**
+ * Validate raw provider data before normalization, content/media processing or
+ * mutation. No returned identifiers or content appear in rejection messages.
+ */
+export function assertGowsMessageIdentity(
+  expected: GowsMessageIdentity,
+  message: unknown,
+): void {
+  const info = (message as { Info?: Record<string, unknown> } | null)?.Info;
+  let matches = false;
+  try {
+    matches =
+      !!info &&
+      info.ID === expected.id &&
+      canonicalJid(info.Chat) === expected.chat &&
+      typeof info.IsFromMe === 'boolean' &&
+      (expected.fromMe === undefined || info.IsFromMe === expected.fromMe) &&
+      (expected.participant === undefined ||
+        canonicalJid(info.Sender) === expected.participant);
+  } catch {
+    matches = false;
+  }
+  if (!matches) {
+    throw new UnprocessableEntityException(
+      'Stored message does not match the requested message identity',
+    );
+  }
+}
+
+function canonicalJid(value: unknown, bare: boolean = false): string {
+  if (typeof value !== 'string' || !value || /\s/.test(value)) {
+    throw new UnprocessableEntityException('Invalid WhatsApp identifier');
+  }
+  let jid = value.replace(/@c\.us$/, '@s.whatsapp.net');
+  if (bare && /^[1-9][0-9]*$/.test(jid)) {
+    jid += '@s.whatsapp.net';
+  }
+  // Match GOWS JID.ToNonAD without changing the user part or PN/LID namespace.
+  jid = jid.replace(
+    /^([1-9][0-9]*):[0-9]+@(s\.whatsapp\.net|lid)$/,
+    '$1@$2',
+  );
+  if (
+    !/^[1-9][0-9]*@(s\.whatsapp\.net|lid|newsletter|meta\.ai)$/.test(jid) &&
+    !/^[1-9][0-9]*(-[0-9]+)?@g\.us$/.test(jid) &&
+    !/^(status|[1-9][0-9]*)@broadcast$/.test(jid)
+  ) {
+    throw new UnprocessableEntityException('Invalid WhatsApp identifier');
+  }
+  return jid;
+}
