+	require.NoError(t, s.UpsertOneMessage(original))
+	keyOnly := mutationOriginal("123@s.whatsapp.net", "123@s.whatsapp.net", false)
+	keyOnly.IsReal = false
+	keyOnly.Message.Message = &waE2E.Message{}
+	require.NoError(t, s.UpsertOneMessage(keyOnly))
+	requireCachedText(t, s, "original")
