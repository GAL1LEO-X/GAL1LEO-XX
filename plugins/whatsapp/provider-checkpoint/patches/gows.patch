@@ -0,0 +1,95 @@
+package gows
+
+import (
+	"errors"
+
+	"github.com/devlikeapro/gows/storage"
+	"go.mau.fi/whatsmeow/proto/waE2E"
+	"go.mau.fi/whatsmeow/proto/waWeb"
+	"go.mau.fi/whatsmeow/types"
+	"go.mau.fi/whatsmeow/types/events"
+	"google.golang.org/protobuf/proto"
+)
+
+func (gows *GoWS) validateOutgoingMutation(chat types.JID, content *waE2E.Message) error {
+	_, _, err := gows.prepareOutgoingMutation(chat, content)
+	return err
+}
+
+func (gows *GoWS) prepareOutgoingMutation(chat types.JID, content *waE2E.Message) (*waE2E.Message, types.JID, error) {
+	sender := gows.GetOwnId()
+	p := storage.MutationProtocol(content)
+	if p == nil || (p.GetType() != waE2E.ProtocolMessage_MESSAGE_EDIT && p.GetType() != waE2E.ProtocolMessage_REVOKE) {
+		return content, sender, nil
+	}
+	info := types.MessageInfo{MessageSource: types.MessageSource{Chat: chat, Sender: sender, IsFromMe: true, IsGroup: chat.Server == types.GroupServer}}
+	info, wire, err := gows.ownMutationSource(info, p.GetKey())
+	if err != nil {
+		return nil, sender, err
+	}
+	prepared := proto.Clone(content).(*waE2E.Message)
+	storage.MutationProtocol(prepared).Key = wire
+	event := &events.Message{
+		Info: info, Message: prepared,
+	}
+	stored := &storage.StoredMessage{Message: event}
+	if err := gows.resolveStoredMutation(stored); err != nil {
+		return nil, sender, err
+	}
+	original, err := gows.Storage.Messages.GetMessage(stored.MutationKey.ID)
+	if err != nil {
+		if p.GetType() == waE2E.ProtocolMessage_REVOKE && (errors.Is(err, storage.ErrNotFound) || errors.Is(err, storage.ErrStorageDisabled)) {
+			return prepared, info.Sender, nil
+		}
+		return nil, sender, err
+	}
+	return prepared, info.Sender, storage.RequireMessageKey(original, *stored.MutationKey)
+}
+
+// Mutation sends must update the original before their RPC returns. The later
+// asynchronous storage event repeats the same mutation idempotently.
+func (gows *GoWS) persistOutgoingMutation(event *events.Message) error {
+	p := storage.EventMutationProtocol(event)
+	if p == nil || (p.GetType() != waE2E.ProtocolMessage_MESSAGE_EDIT && p.GetType() != waE2E.ProtocolMessage_REVOKE) {
+		return nil
+	}
+	status := storage.StatusServerAck
+	stored := &storage.StoredMessage{Message: event, Status: &status}
+	if err := gows.resolveStoredMutation(stored); err != nil {
+		return err
+	}
+	return gows.Storage.Messages.UpsertOneMessage(stored)
+}
+
+func (gows *GoWS) resolveStoredMutation(stored *storage.StoredMessage) error {
+	stored.OwnRevokeKeys = nil
+	if stored.SourceWebMsg != nil && (stored.SourceWebMsg.GetMessageStubType() == waWeb.WebMessageInfo_REVOKE || stored.SourceWebMsg.GetRevokeMessageTimestamp() != 0) {
+		key, err := storage.MessageKeyFromInfo(stored.Info)
+		if err != nil {
+			return err
+		}
+		stored.OwnRevokeKeys = gows.ownRevocationKeys(key)
+		return nil
+	}
+	p := storage.EventMutationProtocol(stored.Message)
+	if p == nil || (p.GetType() != waE2E.ProtocolMessage_MESSAGE_EDIT && p.GetType() != waE2E.ProtocolMessage_REVOKE) {
+		return nil
+	}
+	var ownIDs []types.JID
+	if gows != nil && gows.Client != nil && gows.Store != nil {
+		ownIDs = append(ownIDs, gows.Store.GetJID(), gows.Store.GetLID())
+	}
+	info, wire, err := gows.ownMutationSource(stored.Info, p.GetKey())
+	if err != nil {
+		return err
+	}
+	key, err := storage.ResolveMutationKey(info, wire, ownIDs...)
+	if err != nil {
+		return err
+	}
+	stored.MutationKey = &key
+	if p.GetType() == waE2E.ProtocolMessage_REVOKE {
+		stored.OwnRevokeKeys = gows.ownRevocationKeys(key)
+	}
+	return nil
+}
diff --git a/src/gows/message_mutations_test.go b/src/gows/message_mutations_test.go
