@@ -0,0 +1,45 @@
+package storage
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/require"
+	"go.mau.fi/whatsmeow/proto/waCommon"
+	"go.mau.fi/whatsmeow/types"
+	"google.golang.org/protobuf/proto"
+)
+
+func TestResolveMutationKeySenderRelativeDirection(t *testing.T) {
+	own, _ := types.ParseJID("999@s.whatsapp.net")
+	remote, _ := types.ParseJID("123@s.whatsapp.net")
+	group, _ := types.ParseJID("456@g.us")
+	third, _ := types.ParseJID("555@s.whatsapp.net")
+	for _, tc := range []struct {
+		name       string
+		source     types.MessageSource
+		wire       *waCommon.MessageKey
+		wantFromMe bool
+		wantSender string
+	}{
+		{"incoming DM edit", types.MessageSource{Chat: remote, Sender: remote},
+			&waCommon.MessageKey{FromMe: proto.Bool(true), ID: proto.String("id"), RemoteJID: proto.String(own.String())}, false, ""},
+		{"outgoing DM edit", types.MessageSource{Chat: remote, Sender: own, IsFromMe: true},
+			&waCommon.MessageKey{FromMe: proto.Bool(true), ID: proto.String("id"), RemoteJID: proto.String(remote.String())}, true, ""},
+		{"incoming group edit without participant", types.MessageSource{Chat: group, Sender: remote, IsGroup: true},
+			&waCommon.MessageKey{FromMe: proto.Bool(true), ID: proto.String("id"), RemoteJID: proto.String(group.String())}, false, remote.String()},
+		{"incoming admin revoke own", types.MessageSource{Chat: group, Sender: remote, IsGroup: true},
+			&waCommon.MessageKey{FromMe: proto.Bool(false), ID: proto.String("id"), RemoteJID: proto.String(group.String()), Participant: proto.String(own.String())}, true, own.String()},
+		{"incoming admin revoke third", types.MessageSource{Chat: group, Sender: remote, IsGroup: true},
+			&waCommon.MessageKey{FromMe: proto.Bool(false), ID: proto.String("id"), RemoteJID: proto.String(group.String()), Participant: proto.String(third.String())}, false, third.String()},
+		{"outgoing admin revoke", types.MessageSource{Chat: group, Sender: own, IsGroup: true, IsFromMe: true},
+			&waCommon.MessageKey{FromMe: proto.Bool(false), ID: proto.String("id"), RemoteJID: proto.String(group.String()), Participant: proto.String(remote.String())}, false, remote.String()},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			key, err := ResolveMutationKey(types.MessageInfo{MessageSource: tc.source}, tc.wire, own)
+			require.NoError(t, err)
+			require.Equal(t, tc.source.Chat.String(), key.Chat)
+			require.Equal(t, tc.wantFromMe, key.FromMe)
+			require.Equal(t, tc.wantSender, key.Participant)
+		})
+	}
+}
diff --git a/src/storage/sqlstorage/collision_ledger_regression_test.go b/src/storage/sqlstorage/collision_ledger_regression_test.go
new file mode 100644
