@@ -0,0 +1,64 @@
+// Private A/B checkpoint, 2026-10-19. No change to engine API signatures.
+import {
+  BadGatewayException,
+  BadRequestException,
+  HttpException,
+} from '@nestjs/common';
+import * as grpc from '@grpc/grpc-js';
+import {
+  ABInputError,
+  withABIntentHeaders,
+} from '../core/engines/gows/ab.intent';
+import { ABMutationUncertainError } from '../core/engines/gows/ab.adapter';
+
+export async function withABRequestIntent<T>(
+  intentId: string | undefined,
+  timestamp: string | undefined,
+  operation: () => Promise<T> | T,
+): Promise<T> {
+  return withABErrors(() =>
+    withABIntentHeaders(intentId, timestamp, operation),
+  );
+}
+
+export async function withABErrors<T>(
+  operation: () => Promise<T> | T,
+): Promise<T> {
+  try {
+    return await operation();
+  } catch (error) {
+    if (error instanceof ABMutationUncertainError) {
+      throw new BadGatewayException({
+        message: error.message,
+        outcome: error.outcome,
+        intentId: error.intentId,
+      });
+    }
+    if (error instanceof ABInputError) {
+      throw new BadRequestException(error.message);
+    }
+    // The typed provider guarantees these statuses occur before dispatch.
+    // Require gRPC metadata so unrelated engines' error codes are untouched.
+    const serviceError = error as grpc.ServiceError;
+    if (serviceError?.metadata instanceof grpc.Metadata) {
+      const statuses = new Map<number, number>([
+        [grpc.status.INVALID_ARGUMENT, 400],
+        [grpc.status.NOT_FOUND, 404],
+        [grpc.status.FAILED_PRECONDITION, 412],
+        [grpc.status.PERMISSION_DENIED, 403],
+        [grpc.status.UNAUTHENTICATED, 401],
+      ]);
+      const status = statuses.get(serviceError.code);
+      if (status) {
+        throw new HttpException(
+          {
+            message: serviceError.details,
+            outcome: 'failed_before_send',
+          },
+          status,
+        );
+      }
+    }
+    throw error;
+  }
+}
