+	return gows.ABChatArchiveState{}, gows.ErrABUnavailable
+}
+func (*abContactFake) SetMessageStar(context.Context, gows.ABMessageKey, bool, gows.ABIntent) (gows.ABMutationResult, error) {
+	return gows.ABMutationResult{}, gows.ErrABUnavailable
+}
+func (*abContactFake) SetMessagePin(context.Context, gows.ABMessageKey, bool, gows.ABPinDuration, gows.ABIntent) (gows.ABMutationResult, error) {
+	return gows.ABMutationResult{}, gows.ErrABUnavailable
+}
+
+func TestABContactsOverGRPCSessionPresenceValidationAndUncertainty(t *testing.T) {
+	a, b := &abContactFake{label: "owner-a ✓"}, &abContactFake{label: "owner-b"}
+	resolveCalls := 0
+	var resolveMu sync.Mutex
+	s := &Server{ABClientResolver: func(session string) (gows.ABClient, error) {
+		resolveMu.Lock()
+		defer resolveMu.Unlock()
+		resolveCalls++
+		switch session {
+		case "a":
+			return a, nil
+		case "b":
+			return b, nil
+		default:
+			return nil, status.Error(codes.NotFound, "session not found")
+		}
+	}}
+	lis := bufconn.Listen(1024 * 1024)
+	gs := grpc.NewServer()
+	pb.RegisterMessageServiceServer(gs, s)
+	go gs.Serve(lis)
+	defer gs.Stop()
+	conn, err := grpc.NewClient("passthrough:///offline", grpc.WithContextDialer(func(context.Context, string) (net.Conn, error) { return lis.Dial() }), grpc.WithTransportCredentials(insecure.NewCredentials()))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer conn.Close()
+	client := pb.NewMessageServiceClient(conn)
+	ctx := context.Background()
+	contract, err := client.GetABContract(ctx, &pb.Empty{})
+	if err != nil || contract.GetVersion() != "gows-ab-v1" || !reflect.DeepEqual(contract.GetOperations(), []string{
+		"contacts_get_about", "contacts_block", "contacts_unblock", "messages_set_star",
+		"chats_pin_message", "chats_unpin_message", "chats_archive_chat", "chats_unarchive_chat",
+	}) {
+		t.Fatalf("static contract=%v error=%v", contract, err)
+	}
+	if resolveCalls != 0 {
+		t.Fatal("static contract resolved a session")
+	}
+	for _, tc := range []struct {
+		session, jid, want string
+		present            bool
+		code               codes.Code
+	}{
+		{"a", "1@s.whatsapp.net", "owner-a ✓", true, codes.OK}, {"b", "1@s.whatsapp.net", "owner-b", true, codes.OK},
+		{"a", "2@s.whatsapp.net", "", true, codes.OK}, {"a", "3@s.whatsapp.net", "", false, codes.OK},
+		{"a", "4@s.whatsapp.net", "", false, codes.DeadlineExceeded}, {"missing", "1@s.whatsapp.net", "", false, codes.NotFound},
+	} {
+		response, err := client.GetContactAbout(ctx, &pb.JidRequest{Session: &pb.Session{Id: tc.session}, Jid: tc.jid})
+		if status.Code(err) != tc.code {
+			t.Fatalf("about %v code=%v error=%v", tc, status.Code(err), err)
+		}
+		if err == nil && ((response.About != nil) != tc.present || response.GetAbout().GetValue() != tc.want) {
+			t.Fatalf("presence/value lost: %v", response)
+		}
+	}
+	resolveMu.Lock()
+	before := resolveCalls
+	resolveMu.Unlock()
+	for _, jid := range []string{"", "123", "1@g.us", "1@newsletter", "1@broadcast", "123:1@s.whatsapp.net", "1@unknown"} {
+		_, err := client.GetContactAbout(ctx, &pb.JidRequest{Session: &pb.Session{Id: "a"}, Jid: jid})
+		if status.Code(err) != codes.InvalidArgument {
+			t.Fatalf("jid %q accepted: %v", jid, err)
+		}
+	}
+	resolveMu.Lock()
+	after := resolveCalls
+	resolveMu.Unlock()
+	if after != before {
+		t.Fatal("invalid JIDs resolved a session")
+	}
+	for i, blocked := range []bool{true, false} {
+		response, err := client.SetContactBlocked(ctx, &pb.SetContactBlockedRequest{Session: &pb.Session{Id: "a"}, Jid: "100@lid", Blocked: blocked, IntentId: "stable", TimestampMs: 1700000000000})
+		if err != nil || response.GetOutcome() != pb.ABMutationOutcome_AB_MUTATION_ACCEPTED || response.GetIntentId() != "stable" {
+			t.Fatalf("mutation%d=%v %v", i, response, err)
+		}
+	}
+	response, err := client.SetContactBlocked(ctx, &pb.SetContactBlockedRequest{Session: &pb.Session{Id: "b"}, Jid: "5@s.whatsapp.net", Blocked: true, IntentId: "timed-out", TimestampMs: 1700000000000})
+	if err != nil || response.GetOutcome() != pb.ABMutationOutcome_AB_MUTATION_UNCERTAIN || response.GetIntentId() != "timed-out" {
+		t.Fatalf("uncertainty lost=%v %v", response, err)
+	}
+	if a.calls != 2 || b.calls != 1 || !a.blocked[0] || a.blocked[1] {
+		t.Fatalf("cross-session/retry error a=%v b=%v", a.blocked, b.blocked)
+	}
+	_, err = client.SetContactBlocked(ctx, &pb.SetContactBlockedRequest{Session: &pb.Session{Id: "a"}, Jid: "1@s.whatsapp.net", IntentId: "", TimestampMs: 1700000000000})
+	if status.Code(err) != codes.InvalidArgument || a.calls != 2 {
+		t.Fatal("invalid intent dispatched")
+	}
+	_, err = client.GetContactAbout(ctx, &pb.JidRequest{Jid: "1@s.whatsapp.net"})
+	if status.Code(err) != codes.InvalidArgument {
+		t.Fatal("missing session accepted")
+	}
+}
