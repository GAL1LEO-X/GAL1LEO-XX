+)
+
+type editTestSecretStore struct{}
+
+func (editTestSecretStore) PutMessageSecrets(context.Context, []waStore.MessageSecretInsert) error {
+	return nil
+}
+func (editTestSecretStore) PutMessageSecret(context.Context, types.JID, types.JID, types.MessageID, []byte) error {
+	return nil
+}
+func (editTestSecretStore) GetMessageSecret(_ context.Context, _ types.JID, sender types.JID, _ types.MessageID) ([]byte, types.JID, error) {
+	// Synthetic fixture, never a real account or message secret.
+	return []byte("0123456789abcdef0123456789abcdef"), sender, nil
+}
+
+func editTestGoWS(t *testing.T) (*GoWS, *storage.StoredMessage) {
+	t.Helper()
+	db, err := sqlstorage.New("sqlite3", filepath.Join(t.TempDir(), "edit.db")+"?_busy_timeout=10000&_foreign_keys=on", waLog.Noop)
+	require.NoError(t, err)
+	t.Cleanup(func() { db.Close() })
+	own := types.NewJID("999", types.DefaultUserServer)
+	remote := types.NewJID("123", types.DefaultUserServer)
+	g := &GoWS{
+		Client:  &whatsmeow.Client{Store: &waStore.Device{ID: &own, MsgSecrets: editTestSecretStore{}}, Log: waLog.Noop},
+		Context: context.Background(), events: make(chan interface{}, 1),
+		Storage: &storage.Storage{Messages: db.NewMessageStorage()},
+	}
+	g.storageEventHandler = &StorageEventHandler{gows: g, log: waLog.Noop, storage: g.Storage}
+	original := &storage.StoredMessage{
+		Message: &events.Message{
+			Info:    types.MessageInfo{MessageSource: types.MessageSource{Chat: remote, Sender: remote}, ID: "original", Timestamp: time.Unix(100, 0)},
+			Message: &waE2E.Message{Conversation: proto.String("old")},
+		}, IsReal: true,
+	}
+	return g, original
+}
+
+func TestSecretMessageEditDecryptsAndPersistsBeforeEmission(t *testing.T) {
+	g, original := editTestGoWS(t)
+	require.NoError(t, g.Storage.Messages.UpsertOneMessage(original))
+	content := &waE2E.Message{Conversation: proto.String("decrypted edit")}
+	plaintext, err := proto.Marshal(content)
+	require.NoError(t, err)
+	ciphertext, iv, err := g.Client.DangerousInternals().EncryptMsgSecret(
+		g.Context, original.Info.Sender, original.Info.Chat, original.Info.Sender, original.Info.ID,
+		whatsmeow.EncSecretMessageEdit, plaintext)
+	require.NoError(t, err)
+	event := &events.Message{
+		Info: types.MessageInfo{MessageSource: original.Info.MessageSource, ID: "encrypted-event", Timestamp: time.Unix(200, 0)},
+		Message: &waE2E.Message{SecretEncryptedMessage: &waE2E.SecretEncryptedMessage{
+			TargetMessageKey: &waCommon.MessageKey{ID: proto.String(original.Info.ID), FromMe: proto.Bool(true), RemoteJID: proto.String(g.GetOwnId().String())},
+			SecretEncType:    waE2E.SecretEncryptedMessage_MESSAGE_EDIT.Enum(), EncPayload: ciphertext, EncIV: iv,
+		}},
+	}
+	g.handleSecretMessageEdit(g.Context, event)
+	require.NotNil(t, event.Message.GetSecretEncryptedMessage(), "the shared encrypted event must remain unchanged")
+	emitted := (<-g.events).(*events.Message)
+	require.Equal(t, "decrypted edit", emitted.Message.GetProtocolMessage().GetEditedMessage().GetConversation())
+	stored, err := g.Storage.Messages.GetMessage(original.Info.ID)
+	require.NoError(t, err)
+	require.Equal(t, "decrypted edit", stored.Message.Message.GetConversation())
+	require.Equal(t, int64(100), stored.Info.Timestamp.Unix())
+	require.False(t, stored.Info.IsFromMe, "wire FromMe=true is relative to the incoming sender")
+}
+
+func TestOutgoingEditPersistsSynchronouslyAndReplayIsIdempotent(t *testing.T) {
+	g, original := editTestGoWS(t)
+	original.Info.IsFromMe = true
+	original.Info.Sender = g.GetOwnId()
+	require.NoError(t, g.Storage.Messages.UpsertOneMessage(original))
+	event := &events.Message{
+		Info:    types.MessageInfo{MessageSource: original.Info.MessageSource, ID: "sent-event", Timestamp: time.Unix(200, 0)},
+		Message: g.BuildEdit(original.Info.Chat, original.Info.ID, &waE2E.Message{Conversation: proto.String("outgoing edit")}),
+	}
+	require.NoError(t, g.validateOutgoingMutation(original.Info.Chat, event.Message))
+	require.NoError(t, g.persistOutgoingMutation(event))
+	stored, err := g.Storage.Messages.GetMessage(original.Info.ID)
+	require.NoError(t, err)
+	require.Equal(t, "outgoing edit", stored.Message.Message.GetConversation())
+	// This is the later asynchronous event path used by SendMessage.
+	g.storageEventHandler.handleSaveMessage(event, nil)
+	require.NoError(t, g.Storage.Messages.UpsertOneMessage(original))
+	stored, err = g.Storage.Messages.GetMessage(original.Info.ID)
+	require.NoError(t, err)
+	require.Equal(t, "outgoing edit", stored.Message.Message.GetConversation())
+}
+
+func TestOutgoingMutationRefusesCrossChatBeforeSend(t *testing.T) {
+	g, original := editTestGoWS(t)
+	original.Info.IsFromMe = true
+	original.Info.Sender = g.GetOwnId()
+	require.NoError(t, g.Storage.Messages.UpsertOneMessage(original))
+	other := types.NewJID("555", types.DefaultUserServer)
+	edit := g.BuildEdit(other, original.Info.ID, &waE2E.Message{Conversation: proto.String("wrong chat")})
+	require.ErrorIs(t, g.validateOutgoingMutation(other, edit), storage.ErrMessageKeyConflict)
+	revoke := g.Client.BuildRevoke(other, g.GetOwnId(), original.Info.ID)
+	require.ErrorIs(t, g.validateOutgoingMutation(other, revoke), storage.ErrMessageKeyConflict)
+}
+
+func TestReceiptCannotUpdateAnotherChatSameID(t *testing.T) {
+	g, original := editTestGoWS(t)
+	original.Info.IsFromMe = true
+	original.Info.Sender = g.GetOwnId()
+	status := storage.StatusServerAck
+	original.Status = &status
+	require.NoError(t, g.Storage.Messages.UpsertOneMessage(original))
+	g.storageEventHandler.handleReceipt(&events.Receipt{
+		MessageSource: types.MessageSource{Chat: types.NewJID("555", types.DefaultUserServer)},
+		MessageIDs:    []types.MessageID{original.Info.ID}, Type: types.ReceiptTypeRead,
+	})
+	stored, err := g.Storage.Messages.GetMessage(original.Info.ID)
+	require.NoError(t, err)
+	require.Equal(t, storage.StatusServerAck, *stored.Status)
+	require.Nil(t, g.storageEventHandler.GetMessageForRetry(
+		types.NewJID("555", types.DefaultUserServer), types.NewJID("555", types.DefaultUserServer), original.Info.ID))
+}
