diff --git a/src/server/ab_common.go b/src/server/ab_common.go
new file mode 100644
index 0000000000000000000000000000000000000000..672d63a068066dc893a82c75fa2d175376e0e4f7
--- /dev/null
+++ b/src/server/ab_common.go
@@ -0,0 +1,131 @@
+package server
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"strings"
+
+	"github.com/devlikeapro/gows/gows"
+	pb "github.com/devlikeapro/gows/proto"
+	"go.mau.fi/whatsmeow/types"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/status"
+)
+
+func (s *Server) abClient(session *pb.Session) (gows.ABClient, error) {
+	if session == nil || strings.TrimSpace(session.GetId()) == "" || len(session.GetId()) > 256 {
+		return nil, status.Error(codes.InvalidArgument, "session id required")
+	}
+	if s.ABClientResolver != nil {
+		cli, err := s.ABClientResolver(session.GetId())
+		if err != nil {
+			return nil, abError(err)
+		}
+		if cli == nil {
+			return nil, status.Error(codes.NotFound, "session not found")
+		}
+		return cli, nil
+	}
+	if s.Sm == nil {
+		return nil, status.Error(codes.NotFound, "session not found")
+	}
+	cli, err := s.Sm.Get(session.GetId())
+	if err != nil {
+		return nil, status.Error(codes.NotFound, "session not found")
+	}
+	return cli, nil
+}
+
+// Validate before resolving a session or invoking a backend. ParseJID alone
+// accepts bare local parts and unknown servers; the A/B API does not.
+func abParseContactJID(value string) (types.JID, error) {
+	jid, err := abParseJID(value)
+	if err == nil {
+		err = gows.ValidateABContactJID(jid)
+	}
+	return jid, abError(err)
+}
+
+func abParseChatJID(value string) (types.JID, error) {
+	jid, err := abParseJID(value)
+	if err == nil {
+		err = gows.ValidateABChatJID(jid)
+	}
+	return jid, abError(err)
+}
+
+func abParseJID(value string) (types.JID, error) {
+	if value == "" || len(value) > 256 || strings.TrimSpace(value) != value || strings.Count(value, "@") != 1 {
+		return types.EmptyJID, fmt.Errorf("%w: canonical JID required", gows.ErrABInvalidArgument)
+	}
+	jid, err := types.ParseJID(value)
+	if err != nil || jid.String() != value {
+		return types.EmptyJID, fmt.Errorf("%w: canonical JID required", gows.ErrABInvalidArgument)
+	}
+	return jid, nil
+}
+
+func abParseIntent(id string, timestampMS int64) (gows.ABIntent, error) {
+	intent := gows.ABIntent{ID: id, TimestampMS: timestampMS}
+	return intent, abError(gows.ValidateABIntent(intent))
+}
+
+func abParseMessageKey(value *pb.ABMessageKey) (gows.ABMessageKey, error) {
+	if value == nil {
+		return gows.ABMessageKey{}, status.Error(codes.InvalidArgument, "message key required")
+	}
+	chat, err := abParseChatJID(value.GetChat())
+	if err != nil {
+		return gows.ABMessageKey{}, err
+	}
+	key := gows.ABMessageKey{Chat: chat, ID: value.GetId(), FromMe: value.GetFromMe()}
+	if value.GetParticipant() != "" {
+		key.Participant, err = abParseContactJID(value.GetParticipant())
+		if err != nil {
+			return gows.ABMessageKey{}, err
+		}
+	}
+	return key, abError(gows.ValidateABMessageKey(key))
+}
+
+func abMutationResponse(result gows.ABMutationResult, err error) (*pb.ABMutationResponse, error) {
+	// Once invocation may have reached WhatsApp, errors must not suggest that
+	// retry is safe. Preserve the stable intent id and suppress private details.
+	if result.Outcome == gows.ABMutationUncertain {
+		if result.IntentID == "" {
+			return nil, status.Error(codes.Internal, "invalid mutation result")
+		}
+		return &pb.ABMutationResponse{Outcome: pb.ABMutationOutcome_AB_MUTATION_UNCERTAIN, IntentId: result.IntentID}, nil
+	}
+	if err != nil {
+		return nil, abError(err)
+	}
+	if result.Outcome != gows.ABMutationAccepted || result.IntentID == "" {
+		return nil, status.Error(codes.Internal, "invalid mutation result")
+	}
+	return &pb.ABMutationResponse{Outcome: pb.ABMutationOutcome_AB_MUTATION_ACCEPTED, IntentId: result.IntentID}, nil
+}
+
+func abError(err error) error {
+	if err == nil {
+		return nil
+	}
+	if _, ok := status.FromError(err); ok {
+		return err
+	}
+	switch {
+	case errors.Is(err, gows.ErrABInvalidArgument):
+		return status.Error(codes.InvalidArgument, "invalid A/B argument")
+	case errors.Is(err, gows.ErrABFailedPrecondition):
+		return status.Error(codes.FailedPrecondition, "A/B precondition failed")
+	case errors.Is(err, gows.ErrABUnavailable):
+		return status.Error(codes.Unavailable, "A/B client unavailable")
+	case errors.Is(err, context.Canceled):
+		return status.Error(codes.Canceled, "operation canceled")
+	case errors.Is(err, context.DeadlineExceeded):
+		return status.Error(codes.DeadlineExceeded, "operation timed out")
+	default:
+		return status.Error(codes.Internal, "A/B operation failed")
+	}
+}
