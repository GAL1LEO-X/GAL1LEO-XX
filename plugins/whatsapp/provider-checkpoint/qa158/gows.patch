+type aliasDriver struct{ script *aliasScript }
+type aliasConn struct{ script *aliasScript }
+type aliasRows struct {
+	values   [][]driver.Value
+	index    int
+	rowError bool
+}
+type aliasScript struct {
+	mu              sync.Mutex
+	calls           int
+	query           string
+	args            []driver.NamedValue
+	values          [][]driver.Value
+	err             error
+	rowError        bool
+	block           <-chan struct{}
+	started         chan struct{}
+	done            chan struct{}
+	missingDeadline bool
+}
+
+var aliasDriverID atomic.Int64
+
+func (d aliasDriver) Open(string) (driver.Conn, error) { return &aliasConn{d.script}, nil }
+func (c *aliasConn) Prepare(string) (driver.Stmt, error) {
+	return nil, errors.New("unexpected prepare")
+}
+func (c *aliasConn) Close() error              { return nil }
+func (c *aliasConn) Begin() (driver.Tx, error) { return nil, errors.New("unexpected transaction") }
+func (c *aliasConn) QueryContext(ctx context.Context, q string, a []driver.NamedValue) (driver.Rows, error) {
+	s := c.script
+	s.mu.Lock()
+	s.calls++
+	s.query = q
+	s.args = append([]driver.NamedValue(nil), a...)
+	if deadline, ok := ctx.Deadline(); !ok || time.Until(deadline) > storage.ReceiptAliasBudget {
+		s.missingDeadline = true
+	}
+	s.mu.Unlock()
+	if s.started != nil {
+		close(s.started)
+	}
+	if s.block != nil {
+		<-s.block
+	} // Deliberately ignore cancellation to test caller bound.
+	if s.done != nil {
+		defer close(s.done)
+	}
+	if s.err != nil {
+		return nil, s.err
+	}
+	return &aliasRows{values: s.values, rowError: s.rowError}, nil
+}
+func (r *aliasRows) Columns() []string { return []string{"lid", "pn"} }
+func (r *aliasRows) Close() error      { return nil }
+func (r *aliasRows) Next(v []driver.Value) error {
+	if r.index >= len(r.values) {
+		if r.rowError {
+			return errors.New("PRIVATE-ROW-ERROR")
+		}
+		return io.EOF
+	}
+	copy(v, r.values[r.index])
+	r.index++
+	return nil
+}
+func aliasFake(t *testing.T, s *aliasScript) *SqlLidmapStorage {
+	t.Helper()
+	name := fmt.Sprintf("receipt-alias-%d", aliasDriverID.Add(1))
+	sql.Register(name, aliasDriver{s})
+	db, err := sql.Open(name, "")
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { db.Close() })
+	return &SqlLidmapStorage{db: sqlx.NewDb(db, "sqlite3"), receiptDiagnosticGate: make(chan struct{}, 1)}
+}
