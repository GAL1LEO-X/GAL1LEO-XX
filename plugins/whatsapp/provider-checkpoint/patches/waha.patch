+function convertedMediaFilename(
+  filename: string,
+  extension: 'ogg' | 'mp4',
+): string {
+  const fallback = extension === 'ogg' ? 'audio' : 'video';
+  const basename = path
+    .basename((filename || '').replace(/\\/g, '/'))
+    .replace(/[\x00-\x1f\x7f<>:"|?*]/g, '_')
+    .replace(/^[.\s]+|[.\s]+$/g, '');
+  if (!basename) {
+    return `${fallback}.${extension}`;
+  }
+  if (path.extname(basename).toLowerCase() === `.${extension}`) {
+    return basename;
+  }
+  const name = path.parse(basename).name || fallback;
+  return `${name}.${extension}`;
+}
