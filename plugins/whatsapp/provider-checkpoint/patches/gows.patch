+func TestABMessagePinValidation(t *testing.T) {
+	for _, duration := range []ABPinDuration{-1, 0, 1, 3600, 86401, 604801, 2592001} {
+		if _, err := BuildABMessagePin(abPinTestKey(), true, duration, abPinTestIntent()); !errors.Is(err, ErrABInvalidArgument) {
