+func TestABStarRejectsIncompleteOrUnrelatedIdentity(t *testing.T) {
+	own := abStateJID("12025550999@s.whatsapp.net")
+	other := abStateJID("12025550102@s.whatsapp.net")
+	chat := abStateJID("12025550101@s.whatsapp.net")
+	cases := []ABMessageKey{
+		{Chat: chat, ID: "M", Participant: other},
+		{Chat: chat, ID: "M", FromMe: true, Participant: other},
+		{Chat: abStateJID("12025550101-123@g.us"), ID: "M"},
+		{Chat: abStateJID("12025550101-123@g.us"), ID: "M", FromMe: true},
+		{Chat: chat},
+		{Chat: abStateJID("12025550101@broadcast"), ID: "M"},
+	}
+	for i, key := range cases {
+		if _, err := BuildABStarPatch(key, true, abStateIntent, own, types.EmptyJID); !errors.Is(err, ErrABInvalidArgument) {
+			t.Fatalf("case %d expected invalid argument, got %v", i, err)
+		}
+	}
+	for _, fixture := range []struct {
+		chat    string
+		pn, lid types.JID
+	}{
+		{"900001@lid", own, types.EmptyJID},
+		{"12025550101@s.whatsapp.net", types.EmptyJID, abStateJID("900009@lid")},
+	} {
+		if _, err := BuildABStarPatch(ABMessageKey{Chat: abStateJID(fixture.chat), ID: "M", FromMe: true}, true, abStateIntent, fixture.pn, fixture.lid); !errors.Is(err, ErrABFailedPrecondition) {
+			t.Fatalf("missing own namespace must fail closed: %v", err)
+		}
+	}
+	// PN/LID namespaces with the same numeric user must not be collapsed to
+	// sender "0" by the pinned builder's User-only equality check.
+	ownLID := abStateJID("900009@lid")
+	if _, err := BuildABStarPatch(ABMessageKey{Chat: abStateJID("900009@s.whatsapp.net"), ID: "M", FromMe: true, Participant: ownLID}, true, abStateIntent, own, ownLID); !errors.Is(err, ErrABFailedPrecondition) {
+		t.Fatalf("cross-namespace sender collision must fail closed: %v", err)
+	}
+	if _, err := BuildABStarPatch(ABMessageKey{Chat: chat, ID: "M", FromMe: true}, true, abStateIntent, types.EmptyJID, types.EmptyJID); !errors.Is(err, ErrABFailedPrecondition) {
+		t.Fatalf("missing session identity: %v", err)
+	}
+}
