+func TestABMessagePinSendCapturesFrozenIntentAndPreservesOriginal(t *testing.T) {
+	for _, duration := range []ABPinDuration{ABPinDurationDay, ABPinDurationWeek, ABPinDurationMonth, ABPinDurationUnspecified} {
+		pinned := duration != ABPinDurationUnspecified
+		key := abPinTestKey()
+		original := abPinTestSource(key)
+		before := proto.Clone(original.Message.Message)
+		store := &abPinFakeStore{message: original}
+		sender := &abPinFakeSender{}
+		result, err := setABMessagePin(context.Background(), sender, store, key, pinned, duration, abPinTestIntent(), abPinTestNow)
+		if err != nil || result.Outcome != ABMutationAccepted || result.IntentID != abPinTestIntent().ID {
+			t.Fatalf("unexpected result: %+v %v", result, err)
+		}
+		if sender.calls != 1 || sender.to != key.Chat || sender.extra.ID != abPinTestIntent().ID || !reflect.DeepEqual(store.ids, []string{key.ID}) {
+			t.Fatalf("unexpected dispatch: %+v lookups=%v", sender, store.ids)
+		}
+		want, _ := BuildABMessagePin(key, pinned, duration, abPinTestIntent())
+		if !proto.Equal(want, sender.message) || !proto.Equal(before, original.Message.Message) {
+			t.Fatal("payload differs from typed builder or original was mutated")
+		}
+	}
+}
