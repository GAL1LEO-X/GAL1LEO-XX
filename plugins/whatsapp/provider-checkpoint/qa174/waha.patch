+// Loads the actual Nest build, without constructing a session or HTTP server.
+const test=require('node:test'), assert=require('node:assert/strict');
+const {plainToInstance}=require('class-transformer');
+const {validateSync}=require('class-validator');
+const {ReadChatMessagesQuery}=require('../../dist/structures/chats.dto');
+const {ChannelSearch}=require('../../dist/structures/channels.dto');
+const {LabelBody}=require('../../dist/structures/labels.dto');
+const {Contact}=require('../../dist/structures/chatting.dto');
+const {toVcardV3}=require('../../dist/core/vcard');
+const {ReadChatMessagesInput}=require('../../dist/apps/mcp/tools/chats.zod');
+const {ChannelSearchByTextInput}=require('../../dist/apps/mcp/tools/channels.zod');
+const {LabelBodyInput}=require('../../dist/apps/mcp/tools/labels.zod');
+const {messages}=require('../../dist/core/engines/gows/grpc/gows');
+const valid=(type,input)=>validateSync(plainToInstance(type,input)).length===0;
+test('QA174 compiled receipt DTO and native MCP agree on counts',()=>{
+ for(const count of [1,5,30,100]){
+  assert.equal(valid(ReadChatMessagesQuery,{messages:String(count),days:0.5}),true);
+  assert.equal(ReadChatMessagesInput.safeParse({session:'synthetic',chatId:'15550001234@c.us',messages:count,days:0.5}).success,true);
+ }
+ for(const count of [0,-1,0.5,101,null]){
+  assert.equal(valid(ReadChatMessagesQuery,{messages:count}),false);
+  assert.equal(ReadChatMessagesInput.safeParse({session:'synthetic',chatId:'15550001234@c.us',messages:count}).success,false);
+ }
+ assert.equal(valid(ReadChatMessagesQuery,{days:-1}),false);
+});
+test('QA174 compiled channel DTO/native MCP/wire bounds',()=>{
+ for(const limit of [1,100]){
+  const dto=plainToInstance(ChannelSearch,{limit});assert.equal(validateSync(dto).length,0);
+  const input=ChannelSearchByTextInput.parse({session:'synthetic',text:'Synthetic',categories:[],limit});
+  assert.equal(input.startCursor,'');assert.equal(messages.SearchPage.deserialize(new messages.SearchPage(dto).serialize()).limit,limit);
+ }
+ for(const limit of [-1,0,0.5,101]){
+  assert.equal(valid(ChannelSearch,{limit}),false);
+  assert.equal(ChannelSearchByTextInput.safeParse({session:'synthetic',text:'Synthetic',categories:[],limit}).success,false);
+ }
+});
+test('QA174 compiled label DTO/native MCP/protobuf preserve signed integer domain',()=>{
+ for(const color of [-2147483648,-1,0,19,20,2147483647]){
+  const dto=plainToInstance(LabelBody,{name:'Synthetic',color});assert.equal(validateSync(dto).length,0);
+  assert.equal(LabelBodyInput.safeParse({session:'synthetic',name:'Synthetic',color}).success,true);
+  assert.equal(messages.Label.deserialize(new messages.Label({...dto.toDTO(),id:'1'}).serialize()).color,color);
+ }
+ for(const color of [-2147483649,-0.5,1.5,2147483648]){
+  assert.equal(valid(LabelBody,{name:'Synthetic',color}),false);
+  assert.equal(LabelBodyInput.safeParse({session:'synthetic',name:'Synthetic',color}).success,false);
+ }
+});
+test('QA174 compiled structured contact generates vCard and advertises optional override',()=>{
+ const dto=plainToInstance(Contact,{fullName:'Synthetic Contact',phoneNumber:'+15550001234'});
+ assert.equal(dto.vcard,null);assert.match(toVcardV3(dto),/FN:Synthetic Contact/);
+ assert.match(toVcardV3(dto),/TEL;type=CELL;type=VOICE:\+15550001234/);
+ assert.equal(Reflect.getMetadata('swagger/apiModelProperties',Contact.prototype,'vcard').required,false);
+ const override='BEGIN:VCARD\nVERSION:3.0\nFN:Override\nEND:VCARD';dto.vcard=override;
+ assert.equal(toVcardV3(dto),override);
+});
+const {MessagesForRead}=require('../../dist/core/utils/convertors');
+const {ToGroupV2JoinEvent,ToGroupV2UpdateEvent,ToGroupV2LeaveEvent}=require('../../dist/core/engines/gows/groups.gows');
+test('QA174 actual compiled converters keep receipt counts and group permissions',()=>{
+ for(const chat of ['15550001234@c.us','123456789012345678@g.us']){
+  for(const count of [1,5,30,100])assert.equal(MessagesForRead(chat,{messages:count,days:7}).query.limit,count);
+  assert.equal(MessagesForRead(chat,{days:7}).query.limit,chat.endsWith('@g.us')?100:30);
+ }
+ for(const announce of [true,false]){
+  assert.equal(ToGroupV2JoinEvent({JID:'123@g.us',Participants:[],IsAnnounce:announce}).group.membersCanSendMessages,!announce);
+  assert.equal(ToGroupV2UpdateEvent({JID:'123@g.us',Announce:{IsAnnounce:announce}}).group.membersCanSendMessages,!announce);
+ }
+});
+test('QA174 actual compiled leave converter preserves own PN/LID and account isolation',()=>{
+ const me={id:'15550001111@c.us',lid:'123456789012345@lid'};
+ for(const identity of ['15550001111@s.whatsapp.net','15550001111:3@s.whatsapp.net','123456789012345@lid','123456789012345:5@lid']){
+  assert.equal(ToGroupV2LeaveEvent(me,{JID:'123@g.us',Leave:[identity]}).group.id,'123@g.us');
+  assert.equal(ToGroupV2LeaveEvent({id:'15550002222@c.us',lid:'888888888888888@lid'},{JID:'123@g.us',Leave:[identity]}),null);
+ }
+});
+test('QA174 admitted long lookbacks fit the unsigned timestamp wire', () => {
+  for (const days of [36500, 1e308, Number.MAX_VALUE]) {
+    const dto = plainToInstance(ReadChatMessagesQuery, { messages: 1, days: days });
+    assert.equal(validateSync(dto).length, 0);
+    const { query, filter } = MessagesForRead('15550001234@c.us', dto);
+    const timestamp = filter['filter.timestamp.gte'];
+    assert.equal(timestamp, 0);
+    assert.equal(query.limit, 1);
+    const wire = new messages.OptionalUInt64({ value: timestamp }).serialize();
+    assert.equal(messages.OptionalUInt64.deserialize(wire).value, 0);
+  }
+});
diff --git a/checkpoints/offline-ab/qa174.test.cjs b/checkpoints/offline-ab/qa174.test.cjs
