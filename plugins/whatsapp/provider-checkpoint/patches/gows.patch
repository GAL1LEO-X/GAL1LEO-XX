+func TestABArchiveCacheSnapshotIsSeparateFromAcceptance(t *testing.T) {
+	chat := abStateJID("12025550101@s.whatsapp.net")
+	for _, settings := range []types.LocalChatSettings{{}, {Found: true, Archived: true}, {Found: true, Archived: false}, {Archived: true}} {
+		fixture := &abStateCacheFixture{settings: settings}
+		state, err := abReadChatArchived(context.Background(), fixture, chat)
+		if err != nil || fixture.calls != 1 {
+			t.Fatal("cache read failed")
+		}
+		if state.Known != settings.Found || state.Archived != (settings.Found && settings.Archived) || state.PhoneFresh || state.Source != "whatsmeow_chat_settings_cache" {
+			t.Fatal("unknown/cache state represented as fresh phone observation")
+		}
+	}
+	state, err := abReadChatArchived(context.Background(), nil, chat)
+	if err != nil || state.Known || state.PhoneFresh {
+		t.Fatal("missing cache must remain unknown")
+	}
+	fixture := &abStateCacheFixture{err: errors.New("private cache details")}
+	if _, err = abReadChatArchived(context.Background(), fixture, chat); !errors.Is(err, ErrABUnavailable) {
+		t.Fatal("cache error must be sanitized")
+	}
+	var client *GoWS
+	if _, err = client.SetChatArchived(context.Background(), chat, true, ABIntent{ID: "x", TimestampMS: time.Unix(1, 0).UnixMilli()}, nil); !errors.Is(err, ErrABUnavailable) {
+		t.Fatal("nil client must fail before send")
+	}
+}
