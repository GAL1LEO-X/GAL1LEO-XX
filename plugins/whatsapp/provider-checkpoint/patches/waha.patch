+// Private A/B checkpoint, 2026-10-19: preserve caller-owned durable intentions.
+import { AsyncLocalStorage } from 'async_hooks';
+
+export class ABInputError extends TypeError {}
+
+export interface ABIntent {
+  readonly intentId: string;
+  readonly timestampMs: number;
+}
+
+const context = new AsyncLocalStorage<ABIntent>();
+
+export function currentABIntent(): ABIntent | undefined {
+  return context.getStore();
+}
+
+export function withABIntentHeaders<T>(
+  intentId: string | string[] | undefined,
+  timestamp: string | string[] | undefined,
+  operation: () => T,
+): T {
+  if (intentId === undefined && timestamp === undefined) {
+    return operation();
+  }
+  if (
+    typeof intentId !== 'string' ||
+    !/^[A-Za-z0-9_-]{1,128}$/.test(intentId) ||
+    typeof timestamp !== 'string' ||
+    !/^[1-9][0-9]{0,14}$/.test(timestamp)
+  ) {
+    throw new ABInputError('Both valid WhatsApp intent headers are required');
+  }
+  const timestampMs = Number(timestamp);
+  if (!Number.isSafeInteger(timestampMs) || timestampMs > 253402300799999) {
+    throw new ABInputError('Invalid WhatsApp intent timestamp');
+  }
+  return context.run(
+    Object.freeze({ intentId: intentId, timestampMs: timestampMs }),
+    operation,
+  );
+}
