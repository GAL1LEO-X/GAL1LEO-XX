+package gows
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"regexp"
+	"strings"
+	"unicode/utf8"
+
+	"go.mau.fi/whatsmeow/types"
+)
+
+// ABClient is the narrow checkpoint seam. Production resolves it from the
+// requested session; offline tests inject it without starting WhatsApp or a DB.
+type ABClient interface {
+	GetContactAbout(context.Context, types.JID) (*string, error)
+	SetContactBlocked(context.Context, types.JID, bool, ABIntent) (ABMutationResult, error)
+	SetChatArchived(context.Context, types.JID, bool, ABIntent, []ABMessageRange) (ABMutationResult, error)
+	ReadChatArchived(context.Context, types.JID) (ABChatArchiveState, error)
+	SetMessageStar(context.Context, ABMessageKey, bool, ABIntent) (ABMutationResult, error)
+	SetMessagePin(context.Context, ABMessageKey, bool, ABPinDuration, ABIntent) (ABMutationResult, error)
+}
+
+type ABIntent struct {
+	ID          string
+	TimestampMS int64
+}
+
+type ABMutationOutcome int32
+
+const (
+	ABMutationAccepted  ABMutationOutcome = 1
+	ABMutationUncertain ABMutationOutcome = 2
+)
+
+type ABMutationResult struct {
+	Outcome  ABMutationOutcome
+	IntentID string
+}
+
+type ABMessageKey struct {
+	Chat        types.JID
+	ID          string
+	FromMe      bool
+	Participant types.JID
+}
+
+type ABMessageRange struct {
+	Key         ABMessageKey
+	TimestampMS int64
+}
+
+type ABChatArchiveState struct {
+	Known      bool
+	Archived   bool
+	Source     string
+	PhoneFresh bool
+}
+
+type ABPinDuration int32
+
+const (
+	ABPinDurationUnspecified ABPinDuration = 0
+	ABPinDurationDay         ABPinDuration = 86400
+	ABPinDurationWeek        ABPinDuration = 604800
+	ABPinDurationMonth       ABPinDuration = 2592000
+)
+
+var (
+	ErrABInvalidArgument    = errors.New("invalid A/B argument")
+	ErrABFailedPrecondition = errors.New("A/B precondition failed")
+	ErrABUnavailable        = errors.New("A/B client unavailable")
+	abIntentID              = regexp.MustCompile(`^[A-Za-z0-9_-]{1,128}$`)
+	abNumericUser           = regexp.MustCompile(`^[0-9]+$`)
+	abGroupUser             = regexp.MustCompile(`^[0-9]+(-[0-9]+)?$`)
+)
+
+func ValidateABIntent(intent ABIntent) error {
+	if !abIntentID.MatchString(intent.ID) || intent.TimestampMS <= 0 || intent.TimestampMS > 253402300799999 {
+		return fmt.Errorf("%w: stable intent id and positive timestamp_ms required", ErrABInvalidArgument)
+	}
+	return nil
+}
+
+func ValidateABContactJID(jid types.JID) error {
+	if (jid.Server != types.DefaultUserServer && jid.Server != types.HiddenUserServer) || !abNumericUser.MatchString(jid.User) || jid.Device != 0 || jid.RawAgent != 0 || jid.Integrator != 0 {
+		return fmt.Errorf("%w: expected PN or LID contact JID", ErrABInvalidArgument)
+	}
+	return nil
+}
+
+func ValidateABChatJID(jid types.JID) error {
+	if jid.Server == types.GroupServer && abGroupUser.MatchString(jid.User) && jid.Device == 0 && jid.RawAgent == 0 && jid.Integrator == 0 {
+		return nil
+	}
+	return ValidateABContactJID(jid)
+}
+
+func ValidateABMessageKey(key ABMessageKey) error {
+	if err := ValidateABChatJID(key.Chat); err != nil {
+		return err
+	}
+	if key.ID == "" || len(key.ID) > 256 || !utf8.ValidString(key.ID) || strings.ContainsAny(key.ID, "\x00\r\n") {
+		return fmt.Errorf("%w: message id required", ErrABInvalidArgument)
+	}
+	if !key.Participant.IsEmpty() {
+		if err := ValidateABContactJID(key.Participant); err != nil {
+			return err
+		}
+	}
+	if key.Chat.Server == types.GroupServer && key.Participant.IsEmpty() {
+		return fmt.Errorf("%w: complete group message participant required", ErrABInvalidArgument)
+	}
+	if key.Chat.Server != types.GroupServer && !key.FromMe && !key.Participant.IsEmpty() && key.Participant != key.Chat {
+		return fmt.Errorf("%w: incoming direct message participant must match chat", ErrABInvalidArgument)
+	}
+	return nil
+}
+
+func ValidateABPinDuration(duration ABPinDuration, pinned bool) error {
+	if !pinned && duration == ABPinDurationUnspecified {
+		return nil
+	}
+	if pinned && (duration == ABPinDurationDay || duration == ABPinDurationWeek || duration == ABPinDurationMonth) {
+		return nil
+	}
+	return fmt.Errorf("%w: pin duration must be 24h, 7d or 30d; unpin has no duration", ErrABInvalidArgument)
+}
