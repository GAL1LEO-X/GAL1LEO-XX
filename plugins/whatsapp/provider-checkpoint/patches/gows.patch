@@ -0,0 +1,113 @@
+package sqlstorage
+
+import (
+	"path/filepath"
+	"testing"
+
+	"github.com/devlikeapro/gows/storage"
+	"github.com/stretchr/testify/require"
+	"go.mau.fi/whatsmeow/types"
+)
+
+func TestCollisionLedgerRevocationSurvivesRetentionAndRestart(t *testing.T) {
+	for _, field := range []string{"chat", "direction", "participant"} {
+		t.Run(field, func(t *testing.T) {
+			path := filepath.Join(t.TempDir(), "collision.db")
+			db, s := mutationTestStore(t, path)
+			first := mutationOriginal("123@g.us", "555@s.whatsapp.net", false)
+			second := mutationOriginal("123@g.us", "555@s.whatsapp.net", false)
+			switch field {
+			case "chat":
+				second.Info.Chat = types.NewJID("456", types.GroupServer)
+			case "direction":
+				second.Info.IsFromMe = true
+			case "participant":
+				second.Info.Sender = types.NewJID("777", types.DefaultUserServer)
+			}
+			require.NoError(t, s.UpsertOneMessage(first))
+			require.ErrorIs(t, s.UpsertOneMessage(mutationEvent(second, "", 200000, true)), storage.ErrMessageKeyConflict)
+			actual, err := s.GetMessage(first.Info.ID)
+			require.NoError(t, err)
+			firstKey, err := storage.MessageKeyFromInfo(first.Info)
+			require.NoError(t, err)
+			require.NoError(t, storage.RequireMessageKey(actual, firstKey), "collision must not mutate A")
+			require.Equal(t, "original", actual.Message.Message.GetConversation())
+			require.NoError(t, s.DeleteMessage(first.Info.ID))
+			require.NoError(t, db.Close())
+			_, s = mutationTestStore(t, path)
+			require.NoError(t, s.UpsertOneMessage(second))
+			require.NoError(t, s.UpsertOneMessage(mutationEvent(second, "late edit", 300000, false)))
+			_, err = s.GetMessage(second.Info.ID)
+			require.ErrorIs(t, err, storage.ErrNotFound, "B must not reappear after A retention")
+			require.NoError(t, s.UpsertOneMessage(first), "B tombstone must not suppress A")
+			actual, err = s.GetMessage(first.Info.ID)
+			require.NoError(t, err)
+			require.NoError(t, storage.RequireMessageKey(actual, firstKey))
+		})
+	}
+}
+
+func TestCollisionLedgerKeepsPendingEditForOtherIdentity(t *testing.T) {
+	_, s := mutationTestStore(t, filepath.Join(t.TempDir(), "pending-collision.db"))
+	first := mutationOriginal("123@s.whatsapp.net", "123@s.whatsapp.net", false)
+	second := mutationOriginal("456@s.whatsapp.net", "456@s.whatsapp.net", false)
+	require.NoError(t, s.UpsertOneMessage(first))
+	require.ErrorIs(t, s.UpsertOneMessage(mutationEvent(second, "pending B", 200000, false)), storage.ErrMessageKeyConflict)
+	require.NoError(t, s.DeleteMessage(first.Info.ID))
+	require.NoError(t, s.UpsertOneMessage(second))
+	requireCachedText(t, s, "pending B")
+}
+
+func TestOwnRevocationAliasesCommitAtomically(t *testing.T) {
+	_, s := mutationTestStore(t, filepath.Join(t.TempDir(), "atomic-alias.db"))
+	original := mutationOriginal("123@g.us", "999@s.whatsapp.net", true)
+	require.NoError(t, s.UpsertOneMessage(original))
+	key, err := storage.MessageKeyFromInfo(original.Info)
+	require.NoError(t, err)
+	alias := key
+	alias.Participant = "777@lid"
+	revoke := mutationEvent(original, "", 200000, true)
+	revoke.OwnRevokeKeys = []storage.MessageKey{key, alias}
+	_, err = s.db.Exec(`CREATE TRIGGER fail_alias BEFORE INSERT ON gows_message_mutations
+		WHEN NEW.participant='777@lid' BEGIN SELECT RAISE(ABORT, 'synthetic alias write failure'); END`)
+	require.NoError(t, err)
+	require.ErrorContains(t, s.UpsertOneMessage(revoke), "synthetic alias write failure")
+	requireCachedText(t, s, "original")
+	var count int
+	require.NoError(t, s.db.Get(&count, "SELECT COUNT(*) FROM gows_message_mutations"))
+	require.Zero(t, count, "failed second tombstone must roll back the first")
+	_, err = s.db.Exec("DROP TRIGGER fail_alias")
+	require.NoError(t, err)
+	require.NoError(t, s.UpsertOneMessage(revoke))
+	require.NoError(t, s.db.Get(&count, "SELECT COUNT(*) FROM gows_message_mutations WHERE kind='revoke'"))
+	require.Equal(t, 2, count)
+	_, err = s.GetMessage(original.Info.ID)
+	require.ErrorIs(t, err, storage.ErrNotFound)
+}
+
+func TestOwnRevocationAliasesRejectOtherMessageKeysAndEdits(t *testing.T) {
+	for _, field := range []string{"chat", "id", "direction", "participant", "edit"} {
+		t.Run(field, func(t *testing.T) {
+			_, s := mutationTestStore(t, filepath.Join(t.TempDir(), "invalid-alias.db"))
+			original := mutationOriginal("123@g.us", "999@s.whatsapp.net", true)
+			require.NoError(t, s.UpsertOneMessage(original))
+			alias, err := storage.MessageKeyFromInfo(original.Info)
+			require.NoError(t, err)
+			alias.Participant = "777@lid"
+			switch field {
+			case "chat":
+				alias.Chat = "456@g.us"
+			case "id":
+				alias.ID = "other-id"
+			case "direction":
+				alias.FromMe = false
+			case "participant":
+				alias.Participant = ""
+			}
+			mutation := mutationEvent(original, "forbidden", 200000, field != "edit")
+			mutation.OwnRevokeKeys = []storage.MessageKey{alias}
+			require.ErrorIs(t, s.UpsertOneMessage(mutation), storage.ErrMessageKeyConflict)
+			requireCachedText(t, s, "original")
+		})
+	}
+}
