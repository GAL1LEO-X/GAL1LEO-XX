index 0000000000000000000000000000000000000000..1760eb9ba244bb115a6c52adeecd510848677ca4
--- /dev/null
+++ b/checkpoints/offline-ab/adapter.test.cjs
@@ -0,0 +1,316 @@
+// Exercises the real compiled WAHA adapter and generated protobuf classes.
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const grpc = require('@grpc/grpc-js');
+const { messages } = require('./build/grpc/gows');
+const { GowsABAdapter, ABMutationUncertainError } = require('./build/ab.adapter');
+const { withABIntentHeaders } = require('./build/ab.intent');
+
+function fixture() {
+  const calls = [];
+  const resolutions = [];
+  const state = {
+    session: new messages.Session({ id: 'fixture-a' }),
+    next: null,
+    client: null,
+  };
+  const client = {};
+  for (const method of ['GetContactAbout', 'GetABContract', 'GetChatArchiveState', 'SetContactBlocked', 'SetChatArchived', 'SetMessageStar', 'SetMessagePin']) {
+    client[method] = function (request, callback) {
+      // A wire round trip catches omitted false/empty/default protobuf fields.
+      const decoded = request.constructor.deserialize(request.serialize());
+      calls.push({ method: method, request: decoded });
+      if (state.next) return state.next(decoded, callback);
+      if (method === 'GetABContract') {
+        callback(null, new messages.ABContractResponse({ version: 'gows-ab-v1', operations: ['contacts_get_about', 'contacts_block', 'contacts_unblock', 'chats_archive_chat', 'chats_unarchive_chat', 'messages_set_star', 'chats_pin_message', 'chats_unpin_message'] }));
+      } else if (method === 'GetChatArchiveState') {
+        callback(null, new messages.ABChatArchiveState({ known: true, archived: false, source: 'fixture-cache', phone_fresh: false }));
+      } else if (method === 'GetContactAbout') {
+        callback(null, new messages.ContactAboutResponse({ about: new messages.OptionalString({ value: 'fixture-about' }) }));
+      } else {
+        callback(null, new messages.ABMutationResponse({ outcome: messages.ABMutationOutcome.AB_MUTATION_ACCEPTED, intent_id: decoded.intent_id }));
+      }
+      return {};
+    };
+  }
+  state.client = client;
+  let counter = 0;
+  const adapter = new GowsABAdapter({
+    client: function () { return state.client; },
+    session: function () { return state.session; },
+    jid: async function (value, method) {
+      resolutions.push({ value: value, method: method });
+      if (value === 'alias') return '123@s.whatsapp.net';
+      return value.replace(/@c\.us$/, '@s.whatsapp.net');
+    },
+    intentId: function () { return `intent-${++counter}`; },
+    now: function () { return 1792440000000; },
+  });
+  return { adapter: adapter, calls: calls, resolutions: resolutions, state: state };
+}
+
+const dm = '123@c.us';
+const incoming = 'false_123@c.us_MSG1';
+const outgoing = 'true_123@c.us_MSG2';
+const group = '123-456@g.us';
+const groupKey = 'false_123-456@g.us_MSG3_789@lid';
+
+test('eight operations use typed RPCs and preserve false values, session, key and intent', async function () {
+  const f = fixture();
+  assert.deepEqual(await f.adapter.getContactAbout(dm), { about: 'fixture-about' });
+  assert.equal((await f.adapter.blockContact(dm)).outcome, 'accepted');
+  await f.adapter.unblockContact(dm);
+  await f.adapter.chatsArchiveChat(group);
+  await f.adapter.chatsUnarchiveChat(group);
+  await f.adapter.setStar({ chatId: group, messageId: groupKey, star: true });
+  assert.equal(await f.adapter.pinMessage(dm, incoming, 86400), true);
+  assert.equal(await f.adapter.unpinMessage(dm, outgoing), true);
+  assert.deepEqual(f.calls.map(function (x) { return x.method; }), [
+    'GetContactAbout', 'SetContactBlocked', 'SetContactBlocked', 'SetChatArchived',
+    'SetChatArchived', 'SetMessageStar', 'SetMessagePin', 'SetMessagePin',
+  ]);
+  assert.equal(f.calls[0].request.jid, '123@s.whatsapp.net');
+  assert.equal(f.calls[1].request.blocked, true);
+  assert.equal(f.calls[2].request.blocked, false);
+  assert.equal(f.calls[3].request.archived, true);
+  assert.equal(f.calls[4].request.archived, false);
+  assert.deepEqual(f.calls[3].request.messages, []);
+  assert.deepEqual(f.calls[5].request.key.toObject(), { chat: group, id: 'MSG3', from_me: false, participant: '789@lid' });
+  assert.equal(f.calls[6].request.pinned, true);
+  assert.equal(f.calls[6].request.duration, 86400);
+  assert.equal(f.calls[7].request.pinned, false);
+  assert.equal(f.calls[7].request.duration, 0);
+  assert.equal(f.calls[7].request.key.from_me, true);
+  for (const call of f.calls) assert.equal(call.request.session.id, 'fixture-a');
+  for (const call of f.calls.slice(1)) {
+    assert.match(call.request.intent_id, /^intent-[1-7]$/);
+    assert.equal(call.request.timestamp_ms, 1792440000000);
+  }
+  assert.equal(f.resolutions.length, 0);
+});
+
+test('About distinguishes empty text, missing value, and upstream error', async function () {
+  const f = fixture();
+  f.state.next = function (request, callback) { callback(null, new messages.ContactAboutResponse({ about: new messages.OptionalString({ value: '' }) })); };
+  assert.deepEqual(await f.adapter.getContactAbout(dm), { about: '' });
+  f.state.next = function (request, callback) { callback(null, new messages.ContactAboutResponse()); };
+  assert.deepEqual(await f.adapter.getContactAbout(dm), { about: null });
+  const error = Object.assign(new Error('about unavailable'), { code: grpc.status.UNAVAILABLE });
+  f.state.next = function (request, callback) { callback(error); };
+  await assert.rejects(f.adapter.getContactAbout(dm), function (actual) { return actual === error; });
+});
+
+test('session and client are resolved lazily after adapter construction', async function () {
+  const f = fixture();
+  f.state.session = new messages.Session({ id: 'fixture-b' });
+  await f.adapter.blockContact(dm);
+  assert.equal(f.calls[0].request.session.id, 'fixture-b');
+  let alternate = 0;
+  f.state.client = { GetContactAbout: function (request, callback) { alternate++; callback(null, new messages.ContactAboutResponse()); } };
+  await f.adapter.getContactAbout(dm);
+  assert.equal(alternate, 1);
+});
+
+test('invalid sessions and identifiers stop before RPC', async function () {
+  const f = fixture();
+  for (const session of [null, new messages.Session(), new messages.Session({ id: ' ' })]) {
+    f.state.session = session;
+    await assert.rejects(f.adapter.blockContact(dm), /session/);
+  }
+  f.state.session = new messages.Session({ id: 'fixture-a' });
+  for (const jid of ['', ' ', 'zero@c.us', '0@c.us', '123@newsletter', 'status@broadcast', '123@evil', null, undefined]) {
+    await assert.rejects(f.adapter.blockContact(jid), /identifier/);
+  }
+  await assert.rejects(f.adapter.blockContact(group), /identifier/);
+  assert.equal(f.calls.length, 0);
+});
+
+test('incomplete or mismatched message keys stop before RPC', async function () {
+  const f = fixture();
+  for (const key of ['', 'MSG1', 'maybe_123@c.us_MSG1', 'false_123@c.us_', 'false_123@c.us_MSG 1', 'false_123@c.us_MSG1_', 'false_999@c.us_MSG1', 'false_123-456@g.us_MSG3']) {
+    await assert.rejects(f.adapter.setStar({ chatId: dm, messageId: key, star: true }), /key|match|participant/);
+  }
+  await assert.rejects(f.adapter.setStar({ chatId: dm, messageId: incoming, star: 1 }), /boolean/);
+  await assert.rejects(f.adapter.setStar({ chatId: group, messageId: 'true_123-456@g.us_MSG4', star: true }), /participant/);
+  await assert.rejects(f.adapter.pinMessage(group, 'true_123-456@g.us_MSG4', 86400), /participant/);
+  assert.equal(f.calls.length, 0);
+});
+
+test('pin duration is the strict enum and unpin always sends zero', async function () {
+  const f = fixture();
+  for (const duration of [0, -1, 86400.1, 1, '86400', null, undefined, Infinity, NaN]) {
+    await assert.rejects(f.adapter.pinMessage(dm, incoming, duration), /duration/);
+  }
+  assert.equal(f.calls.length, 0);
+  for (const duration of [86400, 604800, 2592000]) await f.adapter.pinMessage(dm, incoming, duration);
+  await f.adapter.unpinMessage(dm, incoming);
+  assert.deepEqual(f.calls.map(function (x) { return x.request.duration; }), [86400, 604800, 2592000, 0]);
+});
+
+test('star false and mechanical customer format preserve the full key', async function () {
+  const f = fixture();
+  await f.adapter.setStar({ chatId: '123@s.whatsapp.net', messageId: 'true_123@c.us_MSG4', star: false });
+  assert.equal(f.calls[0].request.starred, false);
+  assert.equal(f.calls[0].request.key.chat, '123@s.whatsapp.net');
+  assert.equal(f.calls[0].request.key.from_me, true);
+});
+
+test('uncertain, empty, mismatched and transport outcomes reject with no retry', async function () {
+  for (const response of [
+    function (request) { return new messages.ABMutationResponse({ outcome: messages.ABMutationOutcome.AB_MUTATION_UNCERTAIN, intent_id: request.intent_id }); },
+    function (request) { return new messages.ABMutationResponse({ outcome: messages.ABMutationOutcome.AB_MUTATION_ACCEPTED, intent_id: 'wrong' }); },
+    function () { return new messages.ABMutationResponse(); },
+    function () { return undefined; },
+  ]) {
+    const f = fixture();
+    f.state.next = function (request, callback) { callback(null, response(request)); };
+    await assert.rejects(f.adapter.blockContact(dm), function (error) { return error instanceof ABMutationUncertainError && error.intentId === 'intent-1'; });
+    assert.equal(f.calls.length, 1);
+  }
+  for (const code of [grpc.status.DEADLINE_EXCEEDED, grpc.status.UNAVAILABLE, grpc.status.INTERNAL]) {
+    const f = fixture();
+    f.state.next = function (request, callback) { callback(Object.assign(new Error('transport'), { code: code })); };
+    await assert.rejects(f.adapter.pinMessage(dm, incoming, 86400), ABMutationUncertainError);
+    assert.equal(f.calls.length, 1);
+  }
+});
+
+test('typed predispatch rejection is retained and does not retry', async function () {
+  const f = fixture();
+  const error = Object.assign(new Error('session absent'), { code: grpc.status.NOT_FOUND });
+  f.state.next = function (request, callback) { callback(error); };
+  await assert.rejects(f.adapter.blockContact(dm), function (actual) { return actual === error; });
+  assert.equal(f.calls.length, 1);
+});
+
+test('durable HTTP intent id and timestamp reach every mutation unchanged', async function () {
+  const f = fixture();
+  const timestamp = '1792400000123';
+  await withABIntentHeaders('durable-job-123', timestamp, async function () {
+    await f.adapter.blockContact(dm);
+    await f.adapter.unblockContact(dm);
+    await f.adapter.chatsArchiveChat(dm);
+    await f.adapter.chatsUnarchiveChat(dm);
+    await f.adapter.setStar({ chatId: dm, messageId: incoming, star: false });
+    await f.adapter.pinMessage(dm, incoming, 604800);
+    await f.adapter.unpinMessage(dm, incoming);
+  });
