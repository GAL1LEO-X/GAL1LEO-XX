+func TestReceiptAliasSQLiteSnapshotAndReadOnly(t *testing.T) {
+	for _, tc := range []struct {
+		name  string
+		pairs [][2]string
+		want  storage.ReceiptAliasRelation
+	}{
+		{"missing", nil, storage.AliasMissing},
+		{"pair", [][2]string{{aliasLID.User, aliasPN.User}}, storage.AliasPair},
+		{"lid-other", [][2]string{{aliasLID.User, "15550002222"}}, storage.AliasElsewhere},
+		{"pn-other", [][2]string{{"654321", aliasPN.User}}, storage.AliasElsewhere},
+		{"two-other", [][2]string{{aliasLID.User, "15550002222"}, {"654321", aliasPN.User}}, storage.AliasElsewhere},
+		{"conflict", [][2]string{{aliasLID.User, aliasPN.User}, {aliasLID.User, "15550002222"}}, storage.AliasConflict},
+		{"duplicate", [][2]string{{aliasLID.User, aliasPN.User}, {aliasLID.User, aliasPN.User}}, storage.AliasConflict},
+		{"limit", [][2]string{{aliasLID.User, "15550002222"}, {aliasLID.User, "15550003333"}, {aliasLID.User, "15550004444"}, {aliasLID.User, "15550005555"}}, storage.AliasConflict},
+		{"unrelated-ignored", [][2]string{{"654321", "15550002222"}}, storage.AliasMissing},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			s, db, _ := aliasSQLite(t, tc.pairs)
+			var before, after int
+			if err := db.Get(&before, "SELECT total_changes()"); err != nil {
+				t.Fatal(err)
+			}
+			if got := s.ObserveReceiptAlias(context.Background(), aliasPN, aliasLID); got != tc.want {
+				t.Fatalf("got %s want %s", got, tc.want)
+			}
+			if err := db.Get(&after, "SELECT total_changes()"); err != nil {
+				t.Fatal(err)
+			}
+			if before != after {
+				t.Fatal("diagnostic wrote to database")
+			}
+			if _, err := db.Exec("DELETE FROM whatsmeow_lid_map"); err == nil {
+				t.Fatal("fixture not actually read-only")
+			}
+		})
+	}
+}
