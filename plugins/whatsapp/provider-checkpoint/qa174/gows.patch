+func TestGroupLeaveParserHandlerCache(t *testing.T) {
+	pn := types.NewJID("15550001111", types.DefaultUserServer)
+	lid := types.NewJID("123456789012345", types.HiddenUserServer)
+	pnDevice, lidDevice := pn, lid
+	pnDevice.Device, lidDevice.Device = 4, 7
+	for _, tc := range []struct {
+		name     string
+		identity types.JID
+		own      bool
+	}{
+		{"own PN", pn, true}, {"own LID", lid, true}, {"own PN device", pnDevice, true}, {"own LID device", lidDevice, true},
+		{"foreign PN", types.NewJID("15550002222", types.DefaultUserServer), false},
+		{"foreign LID", types.NewJID("999999999999999", types.HiddenUserServer), false},
+		{"PN token in LID namespace", types.NewJID(pn.User, types.HiddenUserServer), false},
+		{"LID token in PN namespace", types.NewJID(lid.User, types.DefaultUserServer), false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			g, db := captionTestOpen(t, filepath.Join(t.TempDir(), "groups.db"))
+			g.Store.ID = &pn
+			g.Store.LID = lid
+			raw, settings := db.NewGroupStorage(), db.NewChatEphemeralSettingStorage()
+			cache := NewGroupCacheStorage(g, raw, settings)
+			cache.lastTimeRefreshed = time.Now()
+			g.Storage.Groups = cache
+			group := &types.GroupInfo{JID: types.NewJID("123456789012345678", types.GroupServer), ParticipantVersionID: "before", GroupEphemeral: types.GroupEphemeral{IsEphemeral: true, DisappearingTimer: 3600}, Participants: []types.GroupParticipant{{JID: tc.identity}}}
+			require.NoError(t, cache.UpsertOneGroup(group))
+			_, err := settings.GetChatEphemeralSetting(group.JID)
+			require.NoError(t, err)
+			node := waBinary.Node{Tag: "notification", Attrs: waBinary.Attrs{"from": group.JID, "t": "1780000000"}, Content: []waBinary.Node{{Tag: "remove", Attrs: waBinary.Attrs{"prev_v_id": "before", "v_id": "after"}, Content: []waBinary.Node{{Tag: "participant", Attrs: waBinary.Attrs{"jid": tc.identity, "phone_number": pn}}}}}}
+			event, _, err := g.Client.DangerousInternals().ParseGroupChange(&node)
+			require.NoError(t, err)
+			require.Equal(t, []types.JID{tc.identity}, event.Leave, "parser retains the event namespace")
+			g.storageEventHandler.processEvent(event)
+			cached, err := raw.GetGroup(group.JID)
+			if tc.own {
+				require.ErrorIs(t, err, storage.ErrNotFound)
+				_, err = settings.GetChatEphemeralSetting(group.JID)
+				require.ErrorIs(t, err, storage.ErrNotFound)
+			} else {
+				require.NoError(t, err)
+				require.Empty(t, cached.Participants)
+				_, err = settings.GetChatEphemeralSetting(group.JID)
+				require.NoError(t, err)
+			}
+			require.Equal(t, []types.JID{tc.identity}, event.Leave, "handler must not rewrite the provider event")
+		})
+	}
+}
+
+func TestGroupLeaveRequiresThisSessionIdentity(t *testing.T) {
+	group := types.NewJID("123456789012345678", types.GroupServer)
+	event := &events.GroupInfo{JID: group, Leave: []types.JID{types.NewJID("777", types.HiddenUserServer)}}
+	for _, name := range []string{"matching session", "other session", "missing identity", "missing client"} {
+		t.Run(name, func(t *testing.T) {
+			g, db := captionTestOpen(t, filepath.Join(t.TempDir(), "isolated.db"))
+			raw := db.NewGroupStorage()
+			g.Storage.Groups = raw
+			require.NoError(t, raw.UpsertOneGroup(&types.GroupInfo{JID: group}))
+			switch name {
+			case "matching session":
+				g.Store.LID = event.Leave[0]
+			case "other session":
+				g.Store.LID = types.NewJID("888", types.HiddenUserServer)
+			case "missing identity":
+				g.Store.ID = nil
+			case "missing client":
+				g.Client = nil
+			}
+			handler := &StorageEventHandler{gows: g, log: waLog.Noop, storage: g.Storage}
+			require.Equal(t, name == "matching session", handler.handleMeLeftGroup(event))
+			_, err := raw.GetGroup(group)
+			if name == "matching session" {
+				require.ErrorIs(t, err, storage.ErrNotFound)
+			} else {
+				require.NoError(t, err)
+			}
+		})
+	}
+}
