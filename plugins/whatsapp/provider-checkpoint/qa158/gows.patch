+func TestReceiptAliasTimeoutKeepsOneInflightAndNeverRetries(t *testing.T) {
+	release := make(chan struct{})
+	script := &aliasScript{block: release, started: make(chan struct{}), done: make(chan struct{}), values: [][]driver.Value{{aliasLID.User, aliasPN.User}}}
+	s := aliasFake(t, script)
+	defer func() {
+		close(release)
+		select {
+		case <-script.done:
+		case <-time.After(time.Second):
+			t.Error("driver did not finish after release")
+		}
+	}()
+	start := time.Now()
+	if got := s.ObserveReceiptAlias(context.Background(), aliasPN, aliasLID); got != storage.AliasReadError {
+		t.Fatal("late query accepted")
+	}
+	if time.Since(start) > 500*time.Millisecond {
+		t.Fatal("unbounded driver wait")
+	}
+	for n := 0; n < 20; n++ {
+		if s.ObserveReceiptAlias(context.Background(), aliasPN, aliasLID) != storage.AliasReadError {
+			t.Fatal("inflight work bypassed")
+		}
+	}
+	script.mu.Lock()
+	defer script.mu.Unlock()
+	if script.calls != 1 {
+		t.Fatal("new queries accumulated while old read blocked")
+	}
+}
