diff --git a/src/storage/sqlstorage/receipt_update.go b/src/storage/sqlstorage/receipt_update.go
new file mode 100644
index 0000000..7f307da
--- /dev/null
+++ b/src/storage/sqlstorage/receipt_update.go
@@ -0,0 +1,126 @@
+package sqlstorage
+
+import (
+	"context"
+	"database/sql"
+	"database/sql/driver"
+	"fmt"
+
+	"github.com/devlikeapro/gows/storage"
+	"go.mau.fi/whatsmeow/types"
+)
+
+var _ storage.ReceiptAliasUpdater = (*SqlMessageStore)(nil)
+
+// AdvanceReceiptAlias retains the cached namespace, content, full key and
+// restrictions. It updates only a freshly loaded status in one SQLite write
+// transaction; mappings cannot change between verification and commit.
+func (s *SqlMessageStore) AdvanceReceiptAlias(ctx context.Context, expected storage.MessageKey, receiptChat types.JID, receiptFromMe bool, status storage.Status) storage.ReceiptUpdateResult {
+	chat, err := types.ParseJID(expected.Chat)
+	pn, lid, compatible := storage.ReceiptAliasPair(chat, receiptChat)
+	if err != nil || chat.ToNonAD().String() != expected.Chat || !compatible ||
+		!expected.FromMe || expected.Participant != "" || expected.ID == "" || receiptFromMe ||
+		status < storage.StatusDeliveryAck || status > storage.StatusPlayed {
+		return storage.ReceiptInvalid
+	}
+	if s == nil || s.EntityRepository == nil || s.db == nil || s.receiptUpdateGate == nil ||
+		s.db.DriverName() != "sqlite3" {
+		return storage.ReceiptStoreUnavailable
+	}
+	ctx, cancel := context.WithTimeout(ctx, storage.ReceiptAliasBudget)
+	defer cancel()
+	if ctx.Err() != nil {
+		return storage.ReceiptStoreBusy
+	}
+	select {
+	case s.receiptUpdateGate <- struct{}{}:
+		defer func() { <-s.receiptUpdateGate }()
+	default:
+		return storage.ReceiptStoreBusy
+	}
+	conn, err := s.db.Connx(ctx)
+	if err != nil {
+		return storage.ReceiptStoreError
+	}
+	defer conn.Close()
+	// The existing DSN can wait ten seconds on a SQLite lock even after
+	// cancellation. Use no busy wait on this exclusively checked-out connection
+	// and restore its exact setting before returning it to the pool. No global
+	// DB/transport configuration change, retry, or detached writing goroutine.
+	var busy int
+	if err = conn.GetContext(ctx, &busy, "PRAGMA busy_timeout"); err != nil {
+		return storage.ReceiptStoreError
+	}
+	if _, err = conn.ExecContext(ctx, "PRAGMA busy_timeout=0"); err != nil {
+		return storage.ReceiptStoreError
+	}
+	defer func() {
+		if _, err := conn.ExecContext(context.Background(), fmt.Sprintf("PRAGMA busy_timeout=%d", busy)); err != nil {
+			// Never return a connection with an un-restored setting to the pool.
+			_ = conn.Raw(func(any) error { return driver.ErrBadConn })
+		}
+	}()
+	tx, err := conn.BeginTxx(ctx, nil)
+	if err != nil {
+		return storage.ReceiptStoreError
+	}
+	defer tx.Rollback()
+	if _, err = tx.ExecContext(ctx, "UPDATE gows_message_mutation_lock SET id=id WHERE id=1"); err != nil {
+		return storage.ReceiptStoreError
+	}
+	var data string
+	if err = tx.GetContext(ctx, &data, "SELECT data FROM gows_messages WHERE id=$1", expected.ID); err != nil {
+		if err == sql.ErrNoRows {
+			return storage.ReceiptSourceUnavailable
+		}
+		return storage.ReceiptStoreError
+	}
+	original := &storage.StoredMessage{}
+	if err = s.mapper.Unmarshal([]byte(data), original); err != nil {
+		return storage.ReceiptStoreError
+	}
+	if storage.RequireMessageKey(original, expected) != nil {
+		return storage.ReceiptInvalid
+	}
+	rows, err := tx.QueryxContext(ctx, receiptAliasQuery, lid.User, pn.User)
+	if err != nil {
+		return storage.ReceiptStoreError
+	}
+	pairs := make([]storage.LidmapEntry, 0, 3)
+	for rows.Next() {
+		var l, p string
+		if err = rows.Scan(&l, &p); err != nil {
+			break
+		}
+		pairs = append(pairs, storage.LidmapEntry{Lid: types.NewJID(l, types.HiddenUserServer), Pn: types.NewJID(p, types.DefaultUserServer)})
+	}
+	rowsErr := rows.Err()
+	rows.Close()
+	if err != nil || rowsErr != nil || ctx.Err() != nil {
+		return storage.ReceiptStoreError
+	}
+	if storage.ClassifyReceiptAliasSnapshot(pn, lid, pairs) != storage.AliasPair {
+		return storage.ReceiptMapping
+	}
+	mutation, err := loadMutation(tx, expected)
+	if err != nil {
+		return storage.ReceiptStoreError
+	}
+	if mutation != nil && (mutation.kind == "revoke" || mutation.kind == "conflict") {
+		return storage.ReceiptSourceUnavailable
+	}
+	if original.Status != nil && *original.Status >= status {
+		return storage.ReceiptCurrent
+	}
+	original.Status = &status
+	if err = s.writeMessage(tx, original); err != nil {
+		return storage.ReceiptStoreError
+	}
+	if ctx.Err() != nil {
+		return storage.ReceiptStoreError
+	}
+	if err = tx.Commit(); err != nil {
+		return storage.ReceiptStoreError
+	}
+	return storage.ReceiptApplied
+}
