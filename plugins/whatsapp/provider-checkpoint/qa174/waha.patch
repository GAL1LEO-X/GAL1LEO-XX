@@ -0,0 +1,87 @@
+// Pure DTOs/converters and synthetic sessions. No client, account or transport.
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const path = require('node:path');
+const Module = require('node:module');
+const ts = require('typescript');
+const {plainToInstance} = require('class-transformer');
+const {validateSync} = require('class-validator');
+const root = path.resolve(__dirname, '../..');
+function tree(file) { return ts.createSourceFile(file, fs.readFileSync(path.join(root,file),'utf8'),ts.ScriptTarget.Latest,true); }
+function declarations(file,names) {
+  const source=tree(file), rows=source.statements.filter(n=>names.includes(n.name?.text));
+  assert.equal(rows.length,names.length); return rows.map(n=>n.getText(source)).join('\n');
+}
+function method(file,name) {
+  const source=tree(file), rows=[];
+  function visit(n) { if(ts.isMethodDeclaration(n)&&n.name.getText(source)===name)rows.push(n.getText(source)); ts.forEachChild(n,visit); }
+  visit(source); assert.equal(rows.length,1); return rows[0];
+}
+function compile(code) {
+  const output=ts.transpileModule(code,{compilerOptions:{target:ts.ScriptTarget.ES2022,module:ts.ModuleKind.CommonJS,experimentalDecorators:true,emitDecoratorMetadata:true}}).outputText;
+  const mod=new Module(path.join(root,'qa174-memory.js'),module); mod.filename=path.join(root,'qa174-memory.js'); mod.paths=Module._nodeModulePaths(root); mod._compile(output,mod.filename); return mod.exports;
+}
+const imports="import {ApiProperty} from '@nestjs/swagger'; import {Type} from 'class-transformer'; import {IsInt,Min,Max,IsNumber,IsOptional,IsString,IsArray,ArrayMinSize,IsNotEmpty,IsHexColor,ValidateIf} from 'class-validator'; import {UnprocessableEntityException} from '@nestjs/common';";
+const {ReadChatMessagesQuery,ChannelSearch,LabelBody}=compile(imports+'\n'+
+  declarations('src/structures/chats.dto.ts',['ReadChatMessagesQuery'])+'\n'+
+  declarations('src/structures/channels.dto.ts',['ChannelSearch'])+'\n'+
+  declarations('src/structures/labels.dto.ts',['LabelBody']));
+const jids=declarations('src/core/utils/jids.ts',['isJidGroup','isJidBroadcast','isJidNewsletter','isLidUser','isJidMetaAI','isNullJid','isPnUser','normalizeJid','toJID']);
+const {Receipt}=compile(jids+'\n'+declarations('src/structures/enums.dto.ts',['WAMessageAck'])+'\n'+
+  declarations('src/core/utils/convertors.ts',['daysToMs','MessagesForRead'])+'\nexport class Receipt {'+method('src/core/abc/session.abc.ts','readChatMessagesWSImpl')+'}');
+const {ToGroupV2JoinEvent,ToGroupV2UpdateEvent,ToGroupV2LeaveEvent}=compile(jids+'\n'+
+  declarations('src/core/engines/gows/groups.gows.ts',['ToGroupV2JoinEvent','ToGroupV2UpdateEvent','ToGroupV2LeaveEvent','ToGroupInfo','ToGroupInfoPartial','ToGroupParticipants']));
+function valid(type,value) { return validateSync(plainToInstance(type,value),{whitelist:true}).length===0; }
+for (const chat of ['15550001234@c.us','123456789012345678@g.us']) {
+  for (const count of [undefined,1,5,30,100]) test('QA174 bounded receipts '+chat+' '+count,async()=>{
+    const session=new Receipt(), calls=[]; session.logger={debug(){}};
+    session.getChatMessages=async(jid,query,filter)=>{ assert.equal(filter['filter.fromMe'],false); return Array.from({length:Math.min(query.limit,120)},(_,i)=>({id:'false_'+jid+'_SYNTHETIC'+i})); };
+    session.sendSeen=async(req)=>calls.push(req);
+    const input=plainToInstance(ReadChatMessagesQuery,count===undefined?{}:{messages:String(count)});
+    assert.equal(validateSync(input).length,0);
+    const result=await session.readChatMessagesWSImpl(chat,input);
+    const expected=count??(chat.endsWith('@g.us')?100:30);
+    assert.equal(result.ids.length,expected);assert.equal(calls.length,1);assert.equal(calls[0].messageIds.length,expected);
+  });
+}
+test('QA174 receipt count and time validation',()=>{
+  for(const messages of [0,-1,0.5,101,NaN,Infinity,null])assert.equal(valid(ReadChatMessagesQuery,{messages}),false,String(messages));
+  for(const days of [0,0.25,7,365])assert.equal(valid(ReadChatMessagesQuery,{days}),true,String(days));
+  for(const days of [-0.1,NaN,Infinity,null])assert.equal(valid(ReadChatMessagesQuery,{days}),false,String(days));
+});
+test('QA174 no eligible message creates no receipt',async()=>{
+  const session=new Receipt();session.logger={debug(){}};session.getChatMessages=async()=>[];session.sendSeen=()=>assert.fail('no receipt expected');
+  assert.deepEqual(await session.readChatMessagesWSImpl('15550001234@c.us',{messages:1,days:7}),{ids:[]});
+});
+test('QA174 channel limit and optional cursor',()=>{
+  const value=plainToInstance(ChannelSearch,{}); assert.equal(value.limit,50);assert.equal(value.startCursor,'');assert.equal(validateSync(value).length,0);
+  for(const limit of [1,100])assert.equal(valid(ChannelSearch,{limit}),true);
+  for(const limit of [-1,0,0.5,101,Infinity,null])assert.equal(valid(ChannelSearch,{limit}),false,String(limit));
+  assert.equal(valid(ChannelSearch,{startCursor:null}),false);assert.equal(valid(ChannelSearch,{startCursor:'next'}),true);
+});
+test('QA174 labels use the signed integer wire domain',()=>{
+  for(const color of [-2147483648,-1,0,19,20,2147483647])assert.equal(valid(LabelBody,{name:'Synthetic',color}),true,String(color));
+  for(const color of [-2147483649,-0.5,1.5,2147483648,NaN,Infinity])assert.equal(valid(LabelBody,{name:'Synthetic',color}),false,String(color));
+});
+for(const announce of [false,true])test('QA174 group join and update agree '+announce,()=>{
+  const full={JID:'123456789012345678@g.us',Participants:[],IsAnnounce:announce};
+  assert.equal(ToGroupV2JoinEvent(full).group.membersCanSendMessages,!announce);
+  assert.equal(ToGroupV2UpdateEvent({JID:full.JID,Announce:{IsAnnounce:announce}}).group.membersCanSendMessages,!announce);
+  assert.equal(ToGroupV2UpdateEvent({JID:full.JID}),null);
+});
+const me={id:'15550001111@c.us',lid:'123456789012345@lid'};
+for(const id of ['15550001111@s.whatsapp.net','15550001111:4@s.whatsapp.net','123456789012345@lid','123456789012345:7@lid'])test('QA174 own group leave '+id,()=>{
+  const event={JID:'123456789012345678@g.us',Leave:[id]}; const before=JSON.stringify(event);
+  assert.equal(ToGroupV2LeaveEvent(me,event).group.id,event.JID);assert.equal(JSON.stringify(event),before);
+});
+for(const id of ['15550002222@s.whatsapp.net','999999999999999@lid','15550001111@lid','123456789012345@s.whatsapp.net','15550001111@newsletter',''])test('QA174 foreign group leave '+id,()=>{
+  assert.equal(ToGroupV2LeaveEvent(me,{JID:'123456789012345678@g.us',Leave:[id]}),null);
+});
+test('QA174 self identity is session scoped and requires evidence',()=>{
+  const event={JID:'123456789012345678@g.us',Leave:[me.lid]};
+  for(const own of [null,{}, {id:'',lid:''},{id:'15550002222@c.us',lid:'999999999999999@lid'}])assert.equal(ToGroupV2LeaveEvent(own,event),null);
+  assert.equal(ToGroupV2LeaveEvent({id:me.id},event),null);
+  assert.equal(ToGroupV2LeaveEvent({lid:me.lid},event).group.id,event.JID);
+  assert.equal(ToGroupV2LeaveEvent(me,{JID:event.JID,Leave:[]}),null);
+});
