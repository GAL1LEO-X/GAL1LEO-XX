+	key.Chat, key.Participant = ownLID, types.EmptyJID
+	if err := validateABPinOwnIdentity(key, ownPN, types.EmptyJID); !errors.Is(err, ErrABFailedPrecondition) {
+		t.Fatalf("LID outgoing DM guessed PN identity: %v", err)
+	}
+	key.FromMe = false
+	if err := validateABPinOwnIdentity(key, types.EmptyJID, types.EmptyJID); err != nil {
+		t.Fatalf("incoming key incorrectly required own identity: %v", err)
