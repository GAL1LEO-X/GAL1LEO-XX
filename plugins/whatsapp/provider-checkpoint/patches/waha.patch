+      const b = calls.find(function(call) {
+        return call.request.intent_id === 'nest-parallel-b';
+      });
+      assert.equal(a.request.timestamp_ms, 1792400000001);
+      assert.equal(b.request.timestamp_ms, 1792400000002);
+    },
+  );
+  await t.test(
+    'real WorkingSessionPipe used; dangerous runtime modules stayed unloaded',
+    async function() {
+      assert.ok(
+        lookups.filter(function(call) {
+          return call.method === 'waitUntilStatus';
+        }).length >= 5,
+      );
+      assert.equal(
+        Object.keys(require.cache).filter(function(filename) {
+          return unsafeImports.test(filename);
+        }).length,
+        0,
+      );
+      assert.equal(
+        require.cache[path.join(runtimeRoot, 'dist/core/abc/manager.abc.js')]
+          .exports.SessionManager,
+        OfflineSessionManagerToken,
+      );
+    },
+  );
+  process.stdout.write(
+    JSON.stringify({
+      result: 'pass',
+      actualControllers: 3,
+      operations: 8,
+      rpcCalls: calls.length,
+      actualValidationPipe: true,
+      actualWorkingSessionPipe: true,
+      authGuard: 'explicit test override',
+      managerSessionTokens: 'inert fixture tokens',
+      network: 'none',
+      whatsappRuntimeImports: 0,
+    }) + '\n',
+  );
+});
