+// Actual source-extracted methods; inert cache/hooks and A/B adapter, no session.
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const path = require('node:path');
+const vm = require('node:vm');
+const ts = require('typescript');
+
+function sourceMethods(file, className, names) {
+  const source = ts.createSourceFile(file, fs.readFileSync(path.resolve(__dirname, '../../', file), 'utf8'), ts.ScriptTarget.Latest, true);
+  const klass = source.statements.find(s => ts.isClassDeclaration(s) && s.name.text === className);
+  assert.ok(klass);
+  return names.map(name => {
+    const method = klass.members.find(m => ts.isMethodDeclaration(m) && m.name.getText(source) === name);
+    assert.ok(method, name);
+    // Remove decorators through the AST, preserving the actual method body.
+    const clean = ts.factory.updateMethodDeclaration(method, method.modifiers?.filter(m => m.kind !== ts.SyntaxKind.Decorator), method.asteriskToken, method.name, method.questionToken, method.typeParameters,
+      method.parameters.map(p => ts.factory.updateParameterDeclaration(p, p.modifiers?.filter(m => m.kind !== ts.SyntaxKind.Decorator), p.dotDotDotToken, p.name, p.questionToken, p.type, p.initializer)), method.type, method.body);
+    return ts.createPrinter().printNode(ts.EmitHint.Unspecified, clean, source);
+  }).join('\n');
+}
+function fixture(methods, bindings) {
+  const code = ts.transpileModule('class Fixture {\n' + methods + '\n}', {compilerOptions: {target: ts.ScriptTarget.ES2020}}).outputText;
+  return vm.runInNewContext(code + '\nFixture', bindings);
+}
+const methods = sourceMethods('src/core/engines/gows/session.gows.core.ts','WhatsappSessionGoWSCore',['observeTransportStatus']);
+for (const cause of ['disconnected','keepalive_timeout']) {
+ test('QA125 transport cause is retained without envelope: '+cause, () => {
+  const Fixture=fixture(methods,{WAHASessionStatus:{STARTING:'STARTING',WORKING:'WORKING'}});
+  const session=new Fixture();session.status='WORKING';const rows=[];
+  session.logger={warn:(fields)=>rows.push({level:'warning',...fields}),info:(fields)=>rows.push({level:'info',...fields})};
+  session.observeTransportStatus('STARTING',cause);session.observeTransportStatus('STARTING',cause);
+  session.observeTransportStatus('WORKING','connected');
+  assert.equal(session.status,'WORKING');assert.equal(rows.length,2);
+  assert.equal(rows[0].cause,cause);assert.equal(rows[0].previous_state,'WORKING');
+  assert.equal(rows[1].cause,'connected');assert.deepEqual(Object.keys(rows[0]).sort(),['cause','event','level','previous_state','state']);
+ });
+}
