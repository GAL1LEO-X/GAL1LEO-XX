+func TestABMessagePinVerifiedLocalAliasesPreserveWireKey(t *testing.T) {
+	pn := types.NewJID("15550001111", types.DefaultUserServer)
+	lid := types.NewJID("15550002222", types.HiddenUserServer)
+	for _, group := range []bool{false, true} {
+		for _, pinned := range []bool{true, false} {
+			key := ABMessageKey{Chat: lid, ID: "SOURCE"}
+			sourceKey := ABMessageKey{Chat: pn, ID: "SOURCE"}
+			if group {
+				key.Chat, sourceKey.Chat = abPinTestKey().Chat, abPinTestKey().Chat
+				key.Participant, sourceKey.Participant = lid, pn
+			}
+			original := abPinTestSource(sourceKey)
+			before := proto.Clone(original.Message.Message)
+			lookups := 0
+			aliases := abPinLocalAliases(context.Background(), func(_ context.Context, asked types.JID) (types.JID, error) {
+				lookups++
+				if asked != lid {
+					t.Fatalf("lookup used wrong LID: %v", asked)
+				}
+				return pn, nil
+			}, types.EmptyJID, types.EmptyJID)
+			sender := &abPinFakeSender{}
+			duration := ABPinDurationUnspecified
+			if pinned {
+				duration = ABPinDurationDay
+			}
+			result, err := setABMessagePin(context.Background(), sender, &abPinFakeStore{message: original}, key, pinned, duration, abPinTestIntent(), abPinTestNow, aliases)
+			if err != nil || result.Outcome != ABMutationAccepted || sender.calls != 1 || lookups != 1 {
+				t.Fatalf("verified local alias rejected or repeated: result=%+v send=%d lookup=%d err=%v", result, sender.calls, lookups, err)
+			}
+			wireKey := sender.message.GetPinInChatMessage().GetKey()
+			if wireKey.GetRemoteJID() != key.Chat.String() || !key.Participant.IsEmpty() && wireKey.GetParticipant() != key.Participant.String() || !proto.Equal(before, original.Message.Message) {
+				t.Fatal("verified alias rewrote caller key or source content")
+			}
+		}
+	}
+}
