diff --git a/checkpoints/offline-ab/qa120.test.cjs b/checkpoints/offline-ab/qa120.test.cjs
new file mode 100644
index 0000000000000000000000000000000000000000..56c3b1a3e0a5880dbbac7eab127f9139a2df434c
--- /dev/null
+++ b/checkpoints/offline-ab/qa120.test.cjs
@@ -0,0 +1,66 @@
+// Actual source-extracted methods; inert cache/hooks and A/B adapter, no session.
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const path = require('node:path');
+const vm = require('node:vm');
+const ts = require('typescript');
+
+function sourceMethods(file, className, names) {
+  const source = ts.createSourceFile(file, fs.readFileSync(path.resolve(__dirname, '../../', file), 'utf8'), ts.ScriptTarget.Latest, true);
+  const klass = source.statements.find(s => ts.isClassDeclaration(s) && s.name.text === className);
+  assert.ok(klass);
+  return names.map(name => {
+    const method = klass.members.find(m => ts.isMethodDeclaration(m) && m.name.getText(source) === name);
+    assert.ok(method, name);
+    // Remove decorators through the AST, preserving the actual method body.
+    const clean = ts.factory.updateMethodDeclaration(method, method.modifiers?.filter(m => m.kind !== ts.SyntaxKind.Decorator), method.asteriskToken, method.name, method.questionToken, method.typeParameters,
+      method.parameters.map(p => ts.factory.updateParameterDeclaration(p, p.modifiers?.filter(m => m.kind !== ts.SyntaxKind.Decorator), p.dotDotDotToken, p.name, p.questionToken, p.type, p.initializer)), method.type, method.body);
+    return ts.createPrinter().printNode(ts.EmitHint.Unspecified, clean, source);
+  }).join('\n');
+}
+function fixture(methods, bindings) {
+  const code = ts.transpileModule('class Fixture {\n' + methods + '\n}', {compilerOptions: {target: ts.ScriptTarget.ES2020}}).outputText;
+  return vm.runInNewContext(code + '\nFixture', bindings);
+}
+const presenceMethods = sourceMethods('src/core/engines/gows/session.gows.core.ts', 'WhatsappSessionGoWSCore', ['getPresences', 'getPresence']);
+for (const filled of [false, true]) {
+  test('F10 presence cache uses JIDs, populated=' + filled, async () => {
+    let waits = 0, subscriptions = 0;
+    const Fixture = fixture(presenceMethods, {sleep: async () => { waits++; }});
+    const session = new Fixture();
+    const chat = '199999998@s.whatsapp.net';
+    const values = new Map(filled ? [[chat, [{lastKnownPresence: 'online'}]]] : []);
+    session.presences = {keys: () => [...values.keys()], get: id => values.get(id), has: id => values.has(id)};
+    session.toWahaPresences = (id, presences) => ({id, presences});
+    session.hooks = {wid: {chat: {promise: async id => id}}};
+    session.subscribePresence = async () => { subscriptions++; };
+    const all = await session.getPresences();
+    assert.equal(all.length, filled ? 1 : 0);
+    if (filled) assert.equal(all[0].id, chat);
+    const one = await session.getPresence(chat);
+    assert.equal(one.id, chat);
+    assert.equal(one.presences.length, filled ? 1 : 0);
+    assert.equal(waits, filled ? 0 : 1);
+    assert.equal(subscriptions, 1);
+  });
+}
+const starMethod = sourceMethods('src/api/chatting.controller.ts', 'ChattingController', ['setStar']);
+for (const star of [true, false]) {
+  for (const failed of [false, true]) {
+    test('F03 controller acknowledgement star=' + star + ' failed=' + failed, async () => {
+      let calls = 0;
+      const Fixture = fixture(starMethod, {withABRequestIntent: async (id, timestamp, action) => action()});
+      const controller = new Fixture();
+      controller.manager = {getWorkingSession: async () => ({setStar: async request => {
+        calls++;
+        assert.equal(request.star, star);
+        if (failed) throw new Error('uncertain');
+      }})};
+      const action = controller.setStar({session: 'synthetic', star}, 'synthetic-intent', '1792769200000');
+      if (failed) await assert.rejects(action, /uncertain/);
+      else assert.equal(JSON.stringify(await action), '{"success":true}');
+      assert.equal(calls, 1);
+    });
+  }
+}
