+)
+
+func (s *Server) SetChatArchived(ctx context.Context, req *pb.SetChatArchivedRequest) (*pb.ABMutationResponse, error) {
+	if req == nil {
+		return nil, status.Error(codes.InvalidArgument, "archive request required")
+	}
+	chat, err := abParseChatJID(req.GetJid())
+	if err != nil {
+		return nil, err
+	}
+	intent, err := abParseIntent(req.GetIntentId(), req.GetTimestampMs())
+	if err != nil {
+		return nil, err
+	}
+	if len(req.GetMessages()) > 1 {
+		return nil, status.Error(codes.InvalidArgument, "at most one archive anchor supported")
+	}
+	messages := make([]gows.ABMessageRange, 0, len(req.GetMessages()))
+	for _, message := range req.GetMessages() {
+		if message == nil {
+			return nil, status.Error(codes.InvalidArgument, "archive anchor required")
+		}
+		key, keyErr := abParseMessageKey(message.GetKey())
+		if keyErr != nil {
+			return nil, keyErr
+		}
+		messages = append(messages, gows.ABMessageRange{Key: key, TimestampMS: message.GetTimestampMs()})
+	}
+	// Pure builder validation happens before session lookup or backend calls.
+	if _, err = gows.BuildABArchivePatch(chat, req.GetArchived(), intent, messages); err != nil {
+		return nil, abError(err)
+	}
+	cli, err := s.abClient(req.GetSession())
+	if err != nil {
+		return nil, err
+	}
+	result, err := cli.SetChatArchived(ctx, chat, req.GetArchived(), intent, messages)
+	return abMutationResponse(result, err)
+}
+
+func (s *Server) GetChatArchiveState(ctx context.Context, req *pb.JidRequest) (*pb.ABChatArchiveState, error) {
+	if req == nil {
+		return nil, status.Error(codes.InvalidArgument, "archive state request required")
+	}
+	chat, err := abParseChatJID(req.GetJid())
+	if err != nil {
+		return nil, err
+	}
+	cli, err := s.abClient(req.GetSession())
+	if err != nil {
+		return nil, err
+	}
+	state, err := cli.ReadChatArchived(ctx, chat)
+	if err != nil {
+		return nil, abError(err)
+	}
+	return &pb.ABChatArchiveState{Known: state.Known, Archived: state.Known && state.Archived, Source: state.Source, PhoneFresh: false}, nil
+}
+
+func (s *Server) SetMessageStar(ctx context.Context, req *pb.SetMessageStarRequest) (*pb.ABMutationResponse, error) {
+	if req == nil {
+		return nil, status.Error(codes.InvalidArgument, "star request required")
+	}
+	key, err := abParseMessageKey(req.GetKey())
+	if err != nil {
+		return nil, err
+	}
+	if key.Chat.Server == types.GroupServer && key.Participant.IsEmpty() {
+		return nil, status.Error(codes.InvalidArgument, "group star participant required")
+	}
+	intent, err := abParseIntent(req.GetIntentId(), req.GetTimestampMs())
+	if err != nil {
+		return nil, err
+	}
+	cli, err := s.abClient(req.GetSession())
+	if err != nil {
+		return nil, err
+	}
+	result, err := cli.SetMessageStar(ctx, key, req.GetStarred(), intent)
+	return abMutationResponse(result, err)
+}
