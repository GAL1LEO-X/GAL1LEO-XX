@@ -0,0 +1,18 @@
+-- Keep edits and revocations even before history delivers the original message.
+-- Existing short-ID lookup APIs remain compatible; full-key collisions fail closed.
+CREATE TABLE gows_message_mutations (
+    jid VARCHAR(100) NOT NULL,
+    id VARCHAR(100) NOT NULL,
+    from_me BOOLEAN NOT NULL,
+    participant VARCHAR(100) NOT NULL,
+    kind VARCHAR(20) NOT NULL,
+    event_ms BIGINT NOT NULL,
+    data TEXT NOT NULL,
+    PRIMARY KEY (jid, id, from_me, participant)
+);
+CREATE INDEX gows_message_mutations_id_idx ON gows_message_mutations (id);
+
+-- A portable database lock serializes original/mutation read-modify-write
+-- transactions, including multiple store objects and history workers.
+CREATE TABLE gows_message_mutation_lock (id INTEGER PRIMARY KEY);
+INSERT INTO gows_message_mutation_lock (id) VALUES (1);
