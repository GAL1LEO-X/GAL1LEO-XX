@@ -0,0 +1,145 @@
+package gows
+
+import (
+	"context"
+	"errors"
+	"reflect"
+	"testing"
+
+	"go.mau.fi/whatsmeow"
+	waBinary "go.mau.fi/whatsmeow/binary"
+	"go.mau.fi/whatsmeow/types"
+	"go.mau.fi/whatsmeow/types/events"
+)
+
+func TestABAboutStatusPresenceAndMalformedResponses(t *testing.T) {
+	jid := types.NewJID("123", types.DefaultUserServer)
+	status := func(node waBinary.Node) *waBinary.Node {
+		return &waBinary.Node{Tag: "list", Content: []waBinary.Node{{Tag: "user", Attrs: waBinary.Attrs{"jid": jid}, Content: []waBinary.Node{node}}}}
+	}
+	for _, tc := range []struct {
+		name    string
+		list    *waBinary.Node
+		want    *string
+		wantErr bool
+	}{
+		{"value", status(waBinary.Node{Tag: "status", Content: []byte("Ciao ✓")}), abString("Ciao ✓"), false},
+		{"empty bytes", status(waBinary.Node{Tag: "status", Content: []byte{}}), abString(""), false},
+		{"empty node", status(waBinary.Node{Tag: "status"}), abString(""), false},
+		{"missing status", status(waBinary.Node{Tag: "picture", Content: []byte("private")}), nil, false},
+		{"missing user", &waBinary.Node{Tag: "list"}, nil, false},
+		{"privacy401", status(waBinary.Node{Tag: "status", Attrs: waBinary.Attrs{"code": "401"}}), nil, false},
+		{"privacy403", status(waBinary.Node{Tag: "status", Attrs: waBinary.Attrs{"code": 403}}), nil, false},
+		{"unknown error", status(waBinary.Node{Tag: "status", Attrs: waBinary.Attrs{"code": "500"}}), nil, true},
+		{"malformed content", status(waBinary.Node{Tag: "status", Content: []waBinary.Node{{Tag: "invalid"}}}), nil, true},
+		{"nil list", nil, nil, true},
+		{"malformed list", &waBinary.Node{Tag: "list", Content: "invalid"}, nil, true},
+		{"invalid utf8", status(waBinary.Node{Tag: "status", Content: []byte{0xff}}), nil, true},
+		{"user privacy", status(waBinary.Node{Tag: "error", Attrs: waBinary.Attrs{"code": "403"}}), nil, false},
+		{"user server error", status(waBinary.Node{Tag: "error", Attrs: waBinary.Attrs{"code": "500"}}), nil, true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			got, err := abParseContactAbout(tc.list, jid)
+			if (err != nil) != tc.wantErr || !reflect.DeepEqual(got, tc.want) {
+				t.Fatalf("got=%v error=%v", got, err)
+			}
+		})
+	}
+	duplicate := status(waBinary.Node{Tag: "status"})
+	duplicate.Content = append(duplicate.GetChildren(), duplicate.GetChildren()[0])
+	if _, err := abParseContactAbout(duplicate, jid); err == nil {
+		t.Fatal("duplicate target accepted")
+	}
+}
+
+func abString(value string) *string { return &value }
+
+func TestABAboutQueryPrivacyMappingAndErrors(t *testing.T) {
+	pn := types.NewJID("123", types.DefaultUserServer)
+	lid := types.NewJID("987", types.HiddenUserServer)
+	called := 0
+	query := func(_ context.Context, jids []types.JID, mode, scope string, nodes []waBinary.Node, extras ...whatsmeow.UsyncQueryExtras) (*waBinary.Node, error) {
+		called++
+		if !reflect.DeepEqual(jids, []types.JID{pn}) || mode != "full" || scope != "background" || len(nodes) != 1 || nodes[0].Tag != "status" || len(extras) != 1 || !extras[0].IncludePrivacyToken {
+			t.Fatalf("unexpected USync query: %v %s %s %v", jids, mode, scope, nodes)
+		}
+		return &waBinary.Node{Tag: "list", Content: []waBinary.Node{{Tag: "user", Attrs: waBinary.Attrs{"jid": pn}, Content: []waBinary.Node{{Tag: "status", Content: []byte("")}, {Tag: "business", Content: []byte("secret")}}}}}, nil
+	}
+	value, err := abGetContactAbout(context.Background(), lid, func(context.Context, types.JID) (types.JID, error) { return pn, nil }, query)
+	if err != nil || value == nil || *value != "" || called != 1 {
+		t.Fatalf("value=%v err=%v calls=%d", value, err, called)
+	}
+	_, err = abGetContactAbout(context.Background(), pn, nil, func(context.Context, []types.JID, string, string, []waBinary.Node, ...whatsmeow.UsyncQueryExtras) (*waBinary.Node, error) {
+		return nil, context.DeadlineExceeded
+	})
+	if !errors.Is(err, context.DeadlineExceeded) {
+		t.Fatalf("transport error lost: %v", err)
+	}
+	_, err = abGetContactAbout(context.Background(), lid, func(context.Context, types.JID) (types.JID, error) {
+		return types.EmptyJID, nil
+	}, func(_ context.Context, jids []types.JID, _ string, _ string, _ []waBinary.Node, _ ...whatsmeow.UsyncQueryExtras) (*waBinary.Node, error) {
+		if len(jids) != 1 || jids[0] != lid {
+			t.Fatalf("unmapped LID changed: %v", jids)
+		}
+		return &waBinary.Node{Tag: "list"}, nil
+	})
+	if err != nil {
+		t.Fatalf("direct LID fixture failed: %v", err)
+	}
+	_, err = abGetContactAbout(context.Background(), types.NewJID("1-2", types.GroupServer), nil, query)
+	if !errors.Is(err, ErrABInvalidArgument) || called != 1 {
+		t.Fatal("invalid contact reached USync")
+	}
+}
+
+func TestABBlockUnblockMinimalOutcomeAndNoRetry(t *testing.T) {
+	jid := types.NewJID("123", types.DefaultUserServer)
+	intent := ABIntent{ID: "stable-intent", TimestampMS: 1700000000000}
+	for _, blocked := range []bool{true, false} {
+		calls := 0
+		result, err := abSetContactBlocked(context.Background(), jid, blocked, intent, func(_ context.Context, target types.JID, action events.BlocklistChangeAction) (*types.Blocklist, error) {
+			calls++
+			want := events.BlocklistChangeActionUnblock
+			if blocked {
+				want = events.BlocklistChangeActionBlock
+			}
+			if target != jid || action != want {
+				t.Fatal("wrong target or action")
+			}
+			return &types.Blocklist{}, nil
+		})
+		if err != nil || result.Outcome != ABMutationAccepted || result.IntentID != intent.ID || calls != 1 {
+			t.Fatalf("result=%+v err=%v calls=%d", result, err, calls)
+		}
+	}
+	calls := 0
+	result, err := abSetContactBlocked(context.Background(), jid, true, intent, func(context.Context, types.JID, events.BlocklistChangeAction) (*types.Blocklist, error) {
+		calls++
+		return nil, context.DeadlineExceeded
+	})
+	if !errors.Is(err, context.DeadlineExceeded) || result.Outcome != ABMutationUncertain || result.IntentID != intent.ID || calls != 1 {
+		t.Fatalf("uncertainty lost: %+v %v calls=%d", result, err, calls)
+	}
+	nilResult, nilErr := abSetContactBlocked(context.Background(), jid, true, intent, func(context.Context, types.JID, events.BlocklistChangeAction) (*types.Blocklist, error) {
+		return nil, nil
+	})
+	if nilErr != nil || nilResult.Outcome != ABMutationUncertain || nilResult.IntentID != intent.ID {
+		t.Fatalf("nil response not uncertain: %+v %v", nilResult, nilErr)
+	}
+	_, err = abSetContactBlocked(context.Background(), types.NewJID("1-2", types.GroupServer), true, intent, func(context.Context, types.JID, events.BlocklistChangeAction) (*types.Blocklist, error) {
+		calls++
+		return nil, nil
+	})
+	if !errors.Is(err, ErrABInvalidArgument) || calls != 1 {
+		t.Fatal("invalid contact dispatched")
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	_, err = abSetContactBlocked(ctx, jid, true, intent, func(context.Context, types.JID, events.BlocklistChangeAction) (*types.Blocklist, error) {
+		calls++
+		return nil, nil
+	})
+	if !errors.Is(err, context.Canceled) || calls != 1 {
+		t.Fatal("pre-canceled request dispatched")
+	}
+}
diff --git a/src/gows/ab_pin.go b/src/gows/ab_pin.go
new file mode 100644
index 0000000000000000000000000000000000000000..266d61573d870de78b355f159083fb85870a6054
--- /dev/null
+++ b/src/gows/ab_pin.go
@@ -0,0 +1,308 @@
+package gows
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"time"
+
+	"github.com/devlikeapro/gows/storage"
+	"go.mau.fi/whatsmeow"
+	"go.mau.fi/whatsmeow/proto/waCommon"
+	"go.mau.fi/whatsmeow/proto/waE2E"
+	"go.mau.fi/whatsmeow/proto/waWeb"
+	"go.mau.fi/whatsmeow/types"
+	"go.mau.fi/whatsmeow/types/events"
+	"google.golang.org/protobuf/proto"
+	"google.golang.org/protobuf/reflect/protoreflect"
+)
+
+// BuildABMessagePin creates only the control message. In particular, it never
+// quotes, copies, deletes or reconstructs the original message's content.
+// Its pure key validation cannot establish the current account's own identity;
+// the production SetMessagePin method checks that before dispatch.
+func BuildABMessagePin(key ABMessageKey, pinned bool, duration ABPinDuration, intent ABIntent) (*waE2E.Message, error) {
+	if err := ValidateABMessageKey(key); err != nil {
+		return nil, err
+	}
+	if key.Chat.Server == types.GroupServer && key.Participant.IsEmpty() {
+		return nil, fmt.Errorf("%w: complete group message participant required", ErrABInvalidArgument)
+	}
+	if err := ValidateABIntent(intent); err != nil {
+		return nil, err
+	}
+	if err := ValidateABPinDuration(duration, pinned); err != nil {
+		return nil, err
+	}
+	messageKey := &waCommon.MessageKey{
+		RemoteJID: proto.String(key.Chat.String()),
+		ID:        proto.String(key.ID),
+		FromMe:    proto.Bool(key.FromMe),
+	}
+	if !key.Participant.IsEmpty() {
+		messageKey.Participant = proto.String(key.Participant.String())
+	}
+	kind := waE2E.PinInChatMessage_UNPIN_FOR_ALL
+	if pinned {
+		kind = waE2E.PinInChatMessage_PIN_FOR_ALL
+	}
+	return &waE2E.Message{
+		PinInChatMessage: &waE2E.PinInChatMessage{
+			Key:               messageKey,
+			Type:              kind.Enum(),
+			SenderTimestampMS: proto.Int64(intent.TimestampMS),
+		},
+		MessageContextInfo: &waE2E.MessageContextInfo{
+			MessageAddOnDurationInSecs: proto.Uint32(uint32(duration)),
+		},
+	}, nil
+}
+
+type abPinMessageSender interface {
+	SendMessage(context.Context, types.JID, *waE2E.Message, whatsmeow.SendRequestExtra) (*events.Message, error)
+}
+
+type abPinMessageStore interface {
+	GetMessage(types.MessageID) (*storage.StoredMessage, error)
+}
+
+type abPinAliasMatcher func(types.JID, types.JID) (bool, error)
+
+// SetMessagePin uses the normal GoWS send path, which lets the pinned
+// Whatsmeow version select its PinInChat edit attribute ("2"). It does not use
+// appstate.BuildPin, which changes the personal chat list instead.
+func (gows *GoWS) SetMessagePin(ctx context.Context, key ABMessageKey, pinned bool, duration ABPinDuration, intent ABIntent) (ABMutationResult, error) {
+	if gows == nil || gows.Client == nil {
+		return ABMutationResult{}, ErrABUnavailable
+	}
+	ownPN, ownLID := gows.abStateOwnJIDs()
+	if err := validateABPinOwnIdentity(key, ownPN, ownLID); err != nil {
+		return ABMutationResult{}, err
+	}
+	var messages abPinMessageStore
+	if gows.Storage != nil {
+		messages = gows.Storage.Messages
+	}
+	var lookup func(context.Context, types.JID) (types.JID, error)
+	if gows.Store != nil && gows.Store.LIDs != nil {
+		lookup = gows.Store.LIDs.GetPNForLID
+	}
+	return setABMessagePin(ctx, gows, messages, key, pinned, duration, intent, time.Now(), abPinLocalAliases(ctx, lookup, ownPN, ownLID))
+}
+
+func validateABPinOwnIdentity(key ABMessageKey, ownPN, ownLID types.JID) error {
+	if !key.FromMe {
+		return nil
+	}
+	if err := ValidateABMessageKey(key); err != nil {
+		return err
+	}
+	// Require the session identity in the supplied namespace. An unrelated
+	// participant must never be accepted just because no local source exists.
+	own := ownPN
+	if key.Participant.Server == types.HiddenUserServer || key.Participant.IsEmpty() && key.Chat.Server == types.HiddenUserServer {
+		own = ownLID
+	}
+	if err := ValidateABContactJID(own); err != nil {
+		return fmt.Errorf("%w: outgoing session identity unavailable", ErrABFailedPrecondition)
+	}
+	_, err := abStarSender(key, ownPN, ownLID)
+	return err
+}
+
+// setABMessagePin is also the offline seam: a fake captures exactly the payload
+// and options passed to GoWS.SendMessage, without a client, session or database.
+func setABMessagePin(ctx context.Context, sender abPinMessageSender, messages abPinMessageStore, key ABMessageKey, pinned bool, duration ABPinDuration, intent ABIntent, now time.Time, aliases ...abPinAliasMatcher) (ABMutationResult, error) {
+	message, err := BuildABMessagePin(key, pinned, duration, intent)
+	if err != nil {
+		return ABMutationResult{}, err
+	}
+	if sender == nil {
+		return ABMutationResult{}, ErrABUnavailable
+	}
+	if err = ctx.Err(); err != nil {
+		return ABMutationResult{}, err
+	}
+	var matcher abPinAliasMatcher
+	if len(aliases) != 0 {
+		matcher = aliases[0]
+	}
+	if err = validateABPinSource(messages, key, pinned, now, matcher); err != nil {
+		return ABMutationResult{}, err
+	}
+	if err = ctx.Err(); err != nil {
+		return ABMutationResult{}, err
+	}
+	// The outgoing ID is frozen by the caller. There is deliberately one call:
+	// once invoked, an error cannot establish whether WhatsApp applied the pin.
+	_, err = sender.SendMessage(ctx, key.Chat, message, whatsmeow.SendRequestExtra{ID: intent.ID})
+	if err != nil {
+		return ABMutationResult{Outcome: ABMutationUncertain, IntentID: intent.ID}, err
+	}
+	return ABMutationResult{Outcome: ABMutationAccepted, IntentID: intent.ID}, nil
+}
+
+// Pin and unpin need only the complete key on the wire. Missing local storage
+// is neither evidence that the source is live nor a reason to import history:
+// callers must validate their source reference and known removals before RPC.
+// When a local source exists, its identity and known removal/expiry take
+// precedence. Unpin removes only metadata, including after source removal.
+func validateABPinSource(messages abPinMessageStore, key ABMessageKey, pinned bool, now time.Time, aliases abPinAliasMatcher) error {
+	if messages == nil {
+		return nil
+	}
+	stored, err := messages.GetMessage(key.ID) // One local lookup, never retries or history sync.
+	if err != nil && !errors.Is(err, storage.ErrNotFound) && !errors.Is(err, storage.ErrStorageDisabled) {
+		return fmt.Errorf("%w: local source lookup failed", ErrABFailedPrecondition)
+	}
+	if err != nil || stored == nil || stored.Message == nil {
+		return nil
+	}
+	info := stored.Info
+	if info.ID != key.ID || info.IsFromMe != key.FromMe {
+		return fmt.Errorf("%w: source message key does not match", ErrABFailedPrecondition)
+	}
+	if match, err := abPinIdentityMatches(key.Chat, info.Chat.ToNonAD(), aliases); err != nil || !match {
+		return fmt.Errorf("%w: source chat identity could not be verified", ErrABFailedPrecondition)
+	}
+	if !key.Participant.IsEmpty() {
+		if match, err := abPinIdentityMatches(key.Participant, info.Sender.ToNonAD(), aliases); err != nil || !match {
+			return fmt.Errorf("%w: source participant does not match", ErrABFailedPrecondition)
+		}
+	}
+	if !pinned {
+		return nil
+	}
+	content := stored.Message.Message
+	if content == nil {
+		if pinned {
+			return fmt.Errorf("%w: source content is no longer available", ErrABFailedPrecondition)
+		}
+		return nil
+	}
+	if pinned && (stored.IsViewOnce || stored.IsViewOnceV2 || stored.IsViewOnceV2Extension || abPinViewOnceWrapper(stored.RawMessage)) {
+		return fmt.Errorf("%w: view-once source availability cannot be established", ErrABFailedPrecondition)
+	}
+	ephemeral := stored.IsEphemeral || stored.RawMessage.GetEphemeralMessage() != nil
+	expiryKnown := false
+	if stored.SourceWebMsg.GetMessageStubType() == waWeb.WebMessageInfo_REVOKE || stored.SourceWebMsg.GetRevokeMessageTimestamp() != 0 {
+		return fmt.Errorf("%w: source was revoked", ErrABFailedPrecondition)
+	}
+	if duration := stored.SourceWebMsg.GetEphemeralDuration(); duration != 0 {
+		ephemeral, expiryKnown = true, true
+		started := info.Timestamp
+		if timestamp := stored.SourceWebMsg.GetEphemeralStartTimestamp(); timestamp != 0 {
+			if timestamp > 253402300799 {
+				return fmt.Errorf("%w: source expiry timestamp is invalid", ErrABFailedPrecondition)
+			}
+			started = time.Unix(int64(timestamp), 0)
+		}
+		if started.IsZero() || !now.Before(started.Add(time.Duration(duration)*time.Second)) {
+			return fmt.Errorf("%w: source has expired or has no expiry timestamp", ErrABFailedPrecondition)
+		}
+	}
+	// events.Message normally already contains the unwrapped content. Inspect
+	// retained wrappers as well; do not mutate or copy any of their contents.
+	for depth := 0; content != nil; depth++ {
+		if depth > 8 {
+			return fmt.Errorf("%w: unsupported source wrapper depth", ErrABFailedPrecondition)
+		}
+		if protocol := content.GetProtocolMessage(); protocol != nil && protocol.GetType() == waE2E.ProtocolMessage_REVOKE {
+			return fmt.Errorf("%w: source was revoked", ErrABFailedPrecondition)
+		}
+		if pinned && abPinViewOnceWrapper(content) {
+			return fmt.Errorf("%w: view-once source availability cannot be established", ErrABFailedPrecondition)
+		}
+		if expiration := abPinSourceExpiration(content); expiration != 0 {
+			expiryKnown = true
+			if info.Timestamp.IsZero() || !now.Before(info.Timestamp.Add(time.Duration(expiration)*time.Second)) {
+				return fmt.Errorf("%w: source has expired or has no expiry timestamp", ErrABFailedPrecondition)
+			}
+		}
+		switch {
+		case content.GetEphemeralMessage() != nil:
+			ephemeral = true
+			content = content.GetEphemeralMessage().GetMessage()
+		case content.GetViewOnceMessage() != nil:
+			content = content.GetViewOnceMessage().GetMessage()
+		case content.GetViewOnceMessageV2() != nil:
+			content = content.GetViewOnceMessageV2().GetMessage()
+		case content.GetViewOnceMessageV2Extension() != nil:
+			content = content.GetViewOnceMessageV2Extension().GetMessage()
+		case content.GetDocumentWithCaptionMessage() != nil:
+			content = content.GetDocumentWithCaptionMessage().GetMessage()
+		default:
+			if pinned && ephemeral && !expiryKnown {
+				return fmt.Errorf("%w: ephemeral source expiry is unknown", ErrABFailedPrecondition)
+			}
+			return nil
+		}
+		if content == nil {
+			return fmt.Errorf("%w: source content is no longer available", ErrABFailedPrecondition)
+		}
+	}
+	return nil
+}
+
+func abPinViewOnceWrapper(message *waE2E.Message) bool {
+	return message.GetViewOnceMessage() != nil || message.GetViewOnceMessageV2() != nil || message.GetViewOnceMessageV2Extension() != nil
+}
+
+// Inspect every direct content type carrying ContextInfo, including sticker
+// and interactive types that the general legacy ExtractContextInfo omits.
+func abPinSourceExpiration(message *waE2E.Message) uint32 {
+	var expiration uint32
+	message.ProtoReflect().Range(func(field protoreflect.FieldDescriptor, value protoreflect.Value) bool {
+		if field.Message() != nil && !field.IsList() && !field.IsMap() {
+			if content, ok := value.Message().Interface().(interface{ GetContextInfo() *waE2E.ContextInfo }); ok {
+				candidate := content.GetContextInfo().GetExpiration()
+				if candidate != 0 && (expiration == 0 || candidate < expiration) {
+					expiration = candidate
+				}
+			}
+		}
+		return true
+	})
+	return expiration
+}
+
+func abPinIdentityMatches(expected, actual types.JID, aliases abPinAliasMatcher) (bool, error) {
+	if expected == actual {
+		return true, nil
+	}
+	if aliases == nil {
+		return false, nil
+	}
+	return aliases(expected, actual)
+}
+
+// Resolve only PN/LID pairs from session-owned local mappings. This function
+// never requests user info, imports history or queries the WhatsApp network.
+// The validated caller key is preserved on the wire; no guessed rewrite occurs.
+func abPinLocalAliases(ctx context.Context, lookup func(context.Context, types.JID) (types.JID, error), ownPN, ownLID types.JID) abPinAliasMatcher {
+	return func(first, second types.JID) (bool, error) {
+		pn, lid := first, second
+		if pn.Server == types.HiddenUserServer {
+			pn, lid = lid, pn
+		}
+		if pn.Server != types.DefaultUserServer || lid.Server != types.HiddenUserServer {
+			return false, nil
+		}
+		if err := ValidateABContactJID(pn); err != nil {
+			return false, nil
+		}
+		if err := ValidateABContactJID(lid); err != nil {
+			return false, nil
+		}
+		// The session's own pair is authoritative. A foreign LID must never be
+		// accepted as the own phone number through a stale cache entry.
+		if pn == ownPN || lid == ownLID {
+			return pn == ownPN && lid == ownLID, nil
+		}
+		if lookup == nil {
+			return false, nil
+		}
+		mapped, err := lookup(ctx, lid)
+		return err == nil && mapped == pn, err
+	}
+}
diff --git a/src/gows/ab_pin_test.go b/src/gows/ab_pin_test.go
