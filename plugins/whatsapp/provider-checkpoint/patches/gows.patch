+func TestABMessagePinLocalAliasLookupIsExactAndFailClosed(t *testing.T) {
+	pn := types.NewJID("15550001111", types.DefaultUserServer)
+	lid := types.NewJID("15550002222", types.HiddenUserServer)
+	other := types.NewJID("15550009999", types.DefaultUserServer)
+	for _, mapped := range []types.JID{types.EmptyJID, other} {
+		lookups := 0
+		aliases := abPinLocalAliases(context.Background(), func(context.Context, types.JID) (types.JID, error) { lookups++; return mapped, nil }, types.EmptyJID, types.EmptyJID)
+		if matches, err := abPinIdentityMatches(pn, pn, aliases); err != nil || !matches || lookups != 0 {
+			t.Fatal("exact identity consulted alias store")
+		}
+		key := ABMessageKey{Chat: lid, ID: "SOURCE"}
+		source := abPinTestSource(ABMessageKey{Chat: pn, ID: "SOURCE"})
+		sender := &abPinFakeSender{}
+		if _, err := setABMessagePin(context.Background(), sender, &abPinFakeStore{message: source}, key, true, ABPinDurationDay, abPinTestIntent(), abPinTestNow, aliases); !errors.Is(err, ErrABFailedPrecondition) || sender.calls != 0 || lookups != 1 {
+			t.Fatalf("unknown or different local mapping accepted: send=%d lookup=%d err=%v", sender.calls, lookups, err)
+		}
+	}
+	aliases := abPinLocalAliases(context.Background(), nil, types.EmptyJID, types.EmptyJID)
+	if match, err := aliases(pn, lid); err != nil || match {
+		t.Fatal("missing local mapping was guessed")
+	}
+	lookupErr := errors.New("local alias read failed")
+	aliases = abPinLocalAliases(context.Background(), func(context.Context, types.JID) (types.JID, error) { return types.EmptyJID, lookupErr }, types.EmptyJID, types.EmptyJID)
+	if match, err := aliases(pn, lid); !errors.Is(err, lookupErr) || match {
+		t.Fatal("local lookup failure accepted")
+	}
+	aliases = abPinLocalAliases(context.Background(), func(context.Context, types.JID) (types.JID, error) {
+		t.Fatal("own identity pair must not read a cache")
+		return pn, nil
+	}, pn, lid)
+	if match, err := aliases(pn, lid); err != nil || !match {
+		t.Fatal("authoritative own PN/LID pair rejected")
+	}
+	if match, err := aliases(lid, pn); err != nil || !match {
+		t.Fatal("reverse own PN/LID pair rejected")
+	}
+	if match, err := aliases(pn, types.NewJID("15550003333", types.HiddenUserServer)); err != nil || match {
+		t.Fatal("foreign LID accepted as own phone")
+	}
+}
diff --git a/src/gows/ab_state.go b/src/gows/ab_state.go
new file mode 100644
index 0000000000000000000000000000000000000000..36d0c42c292bdad7efabc5a7aac4ea7505d3b4cc
--- /dev/null
+++ b/src/gows/ab_state.go
@@ -0,0 +1,204 @@
+package gows
+
+import (
+	"context"
+	"fmt"
+	"time"
+
+	"go.mau.fi/whatsmeow/appstate"
+	"go.mau.fi/whatsmeow/proto/waCommon"
+	"go.mau.fi/whatsmeow/types"
+	"google.golang.org/protobuf/proto"
+)
+
+// abStateSender is deliberately narrower than a WhatsApp client. Fixture tests
+// capture patches here without creating a session, database, or connection.
+type abStateSender interface {
+	SendAppState(context.Context, appstate.PatchInfo) error
+}
+
+// BuildABArchivePatch uses the pinned Whatsmeow builder. The caller's timestamp
+// is frozen both on the patch and on an empty range, so replay does not acquire
+// a new time. Archiving unpins the personal CHAT; unarchiving does not repin it.
+// KeepArchived is a separate account setting and is never included here.
+func BuildABArchivePatch(chat types.JID, archived bool, intent ABIntent, messages []ABMessageRange) (appstate.PatchInfo, error) {
+	if err := ValidateABChatJID(chat); err != nil {
+		return appstate.PatchInfo{}, err
+	}
+	if err := ValidateABIntent(intent); err != nil {
+		return appstate.PatchInfo{}, err
+	}
+	if len(messages) > 1 {
+		return appstate.PatchInfo{}, fmt.Errorf("%w: archive accepts at most one last-message anchor", ErrABInvalidArgument)
+	}
+	anchorTime := time.UnixMilli(intent.TimestampMS)
+	var anchor *waCommon.MessageKey
+	if len(messages) == 1 {
+		message := messages[0]
+		if err := ValidateABMessageKey(message.Key); err != nil {
+			return appstate.PatchInfo{}, err
+		}
+		if message.Key.Chat != chat || message.TimestampMS <= 0 || message.TimestampMS > intent.TimestampMS {
+			return appstate.PatchInfo{}, fmt.Errorf("%w: archive anchor must belong to chat and precede intent", ErrABInvalidArgument)
+		}
+		if message.Key.Chat.Server == types.GroupServer && message.Key.Participant.IsEmpty() {
+			return appstate.PatchInfo{}, fmt.Errorf("%w: group archive anchor participant required", ErrABInvalidArgument)
+		}
+		anchorTime = time.UnixMilli(message.TimestampMS)
+		anchor = &waCommon.MessageKey{
+			RemoteJID: proto.String(message.Key.Chat.String()),
+			ID:        proto.String(message.Key.ID),
+			FromMe:    proto.Bool(message.Key.FromMe),
+		}
+		if !message.Key.Participant.IsEmpty() {
+			anchor.Participant = proto.String(message.Key.Participant.String())
+		}
+	}
+	patch := appstate.BuildArchive(chat, archived, anchorTime, anchor)
+	patch.Timestamp = time.UnixMilli(intent.TimestampMS)
+	return patch, nil
+}
+
+// abStarSender preserves the supplied PN/LID namespace. It never guesses an
+// alias or uses the target chat as the sender of an outgoing message.
+func abStarSender(key ABMessageKey, ownPN, ownLID types.JID) (types.JID, error) {
+	if err := ValidateABMessageKey(key); err != nil {
+		return types.JID{}, err
+	}
+	if key.Chat.Server == types.GroupServer && key.Participant.IsEmpty() {
+		return types.JID{}, fmt.Errorf("%w: group star participant required to preserve PN/LID namespace", ErrABInvalidArgument)
+	}
+	if key.FromMe {
+		if !key.Participant.IsEmpty() {
+			if key.Participant != ownPN && key.Participant != ownLID {
+				return types.JID{}, fmt.Errorf("%w: outgoing participant must match session identity", ErrABInvalidArgument)
+			}
+			return key.Participant, nil
+		}
+		own := ownPN
+		if key.Chat.Server == types.HiddenUserServer {
+			own = ownLID
+		}
+		if err := ValidateABContactJID(own); err != nil {
+			return types.JID{}, fmt.Errorf("%w: session identity unavailable", ErrABFailedPrecondition)
+		}
+		return own, nil
+	}
+	if key.Chat.Server == types.GroupServer {
+		return key.Participant, nil
+	}
+	return key.Chat, nil
+}
+
+// BuildABStarPatch retains Whatsmeow's regular_high collection, version and
+// index encoding. The difference from Baileys regular_low remains unqualified
+// on phones; this checkpoint does not substitute a different collection.
+func BuildABStarPatch(key ABMessageKey, starred bool, intent ABIntent, ownPN, ownLID types.JID) (appstate.PatchInfo, error) {
+	if err := ValidateABIntent(intent); err != nil {
+		return appstate.PatchInfo{}, err
+	}
+	sender, err := abStarSender(key, ownPN, ownLID)
+	if err != nil {
+		return appstate.PatchInfo{}, err
+	}
+	// The pinned builder normalizes an equal User to "0" without checking
+	// Server. Refuse a cross-namespace collision instead of losing identity.
+	if key.Chat.User == sender.User && key.Chat != sender {
+		return appstate.PatchInfo{}, fmt.Errorf("%w: pinned star builder cannot preserve distinct sender namespace", ErrABFailedPrecondition)
+	}
+	patch := appstate.BuildStar(key.Chat, sender, key.ID, key.FromMe, starred)
+	patch.Timestamp = time.UnixMilli(intent.TimestampMS)
+	return patch, nil
+}
+
+func abSubmitState(ctx context.Context, sender abStateSender, patch appstate.PatchInfo, intent ABIntent) (ABMutationResult, error) {
+	if sender == nil {
+		return ABMutationResult{}, fmt.Errorf("%w: app-state sender unavailable", ErrABUnavailable)
+	}
+	if err := ctx.Err(); err != nil {
+		return ABMutationResult{}, err
+	}
+	// SendAppState exposes no phase marker. A failure can follow server
+	// acceptance or cache resync, so every primitive error is conservatively
+	// uncertain. Do not log its raw state, parse its text, or retry here.
+	if err := sender.SendAppState(ctx, patch); err != nil {
+		return ABMutationResult{Outcome: ABMutationUncertain, IntentID: intent.ID}, nil
+	}
+	return ABMutationResult{Outcome: ABMutationAccepted, IntentID: intent.ID}, nil
+}
+
+func (gows *GoWS) SetChatArchived(ctx context.Context, chat types.JID, archived bool, intent ABIntent, messages []ABMessageRange) (ABMutationResult, error) {
+	patch, err := BuildABArchivePatch(chat, archived, intent, messages)
+	if err != nil {
+		return ABMutationResult{}, err
+	}
+	if gows == nil || gows.Client == nil {
+		return ABMutationResult{}, fmt.Errorf("%w: app-state client unavailable", ErrABUnavailable)
+	}
+	if gows.Store == nil {
+		return ABMutationResult{}, fmt.Errorf("%w: session store unavailable", ErrABFailedPrecondition)
+	}
+	if len(messages) == 1 && messages[0].Key.FromMe {
+		ownPN, ownLID := gows.abStateOwnJIDs()
+		if _, err = abStarSender(messages[0].Key, ownPN, ownLID); err != nil {
+			return ABMutationResult{}, err
+		}
+	}
+	return abSubmitState(ctx, gows.Client, patch, intent)
+}
+
+func (gows *GoWS) abStateOwnJIDs() (ownPN, ownLID types.JID) {
+	if gows != nil && gows.Client != nil && gows.Store != nil {
+		if gows.Store.ID != nil {
+			ownPN = gows.Store.ID.ToNonAD()
+		}
+		ownLID = gows.Store.LID.ToNonAD()
+	}
+	return
+}
+
+func (gows *GoWS) SetMessageStar(ctx context.Context, key ABMessageKey, starred bool, intent ABIntent) (ABMutationResult, error) {
+	ownPN, ownLID := gows.abStateOwnJIDs()
+	patch, err := BuildABStarPatch(key, starred, intent, ownPN, ownLID)
+	if err != nil {
+		return ABMutationResult{}, err
+	}
+	if gows == nil || gows.Client == nil {
+		return ABMutationResult{}, fmt.Errorf("%w: app-state client unavailable", ErrABUnavailable)
+	}
+	if gows.Store == nil {
+		return ABMutationResult{}, fmt.Errorf("%w: session store unavailable", ErrABFailedPrecondition)
+	}
+	return abSubmitState(ctx, gows.Client, patch, intent)
+}
+
+type abChatSettingsReader interface {
+	GetChatSettings(context.Context, types.JID) (types.LocalChatSettings, error)
+}
+
+func abReadChatArchived(ctx context.Context, reader abChatSettingsReader, chat types.JID) (ABChatArchiveState, error) {
+	if err := ValidateABChatJID(chat); err != nil {
+		return ABChatArchiveState{}, err
+	}
+	state := ABChatArchiveState{Source: "whatsmeow_chat_settings_cache", PhoneFresh: false}
+	if reader == nil {
+		return state, nil
+	}
+	settings, err := reader.GetChatSettings(ctx, chat)
+	if err != nil {
+		return ABChatArchiveState{}, fmt.Errorf("%w: chat settings cache unavailable", ErrABUnavailable)
+	}
+	// Found describes a local settings row, including rows created by mute/pin.
+	// It is a cache snapshot, not evidence of a specific Archive event, intent
+	// completion, historical coverage, or freshness on any phone.
+	state.Known, state.Archived = settings.Found, settings.Found && settings.Archived
+	return state, nil
+}
+
+func (gows *GoWS) ReadChatArchived(ctx context.Context, chat types.JID) (ABChatArchiveState, error) {
+	var reader abChatSettingsReader
+	if gows != nil && gows.Client != nil && gows.Store != nil {
+		reader = gows.Store.ChatSettings
+	}
+	return abReadChatArchived(ctx, reader, chat)
+}
