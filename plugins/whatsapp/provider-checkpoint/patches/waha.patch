+    video: async function (buffer) { state.converted++; return converter.video(buffer); },
+  };
+  session.client = {
+    SendMessage: function (request, callback) {
+      const decoded = request.constructor.deserialize(request.serialize());
+      const bytes = decoded.media.contentPath
+        ? fs.readFileSync(decoded.media.contentPath)
+        : Buffer.from(decoded.media.content);
+      state.calls.push({ request: decoded, bytes: bytes });
