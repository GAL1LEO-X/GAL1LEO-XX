+
+func ownHistoryFixture(t *testing.T, g *GoWS, participant types.JID) *storage.StoredMessage {
+	t.Helper()
+	chat := types.NewJID("123", types.GroupServer)
+	web := &waWeb.WebMessageInfo{
+		Key:                             &waCommon.MessageKey{RemoteJID: proto.String(chat.String()), ID: proto.String("own-original"), FromMe: proto.Bool(true)},
+		OriginalSelfAuthorUserJIDString: proto.String(participant.String()), MessageTimestamp: proto.Uint64(100),
+		Message: &waE2E.Message{Conversation: proto.String("old")},
+	}
+	parsed, err := g.Client.ParseWebMessage(chat, web)
+	require.NoError(t, err)
+	return &storage.StoredMessage{Message: parsed, IsReal: true}
+}
+
+func TestVerifiedOwnPNAndLIDEditRevokeHistoryRestart(t *testing.T) {
+	for _, namespace := range []string{"PN", "LID"} {
+		t.Run(namespace, func(t *testing.T) {
+			path := filepath.Join(t.TempDir(), "own.db")
+			g, db := captionTestOpen(t, path)
+			g.Store.LID = types.NewJID("777", types.HiddenUserServer)
+			participant := g.GetOwnId()
+			if namespace == "LID" {
+				participant = g.Store.LID
+			}
+			original := ownHistoryFixture(t, g, participant)
+			require.NoError(t, g.Storage.Messages.UpsertOneMessage(original))
+			_, err := g.OwnMessageKey(original, original.Info.Chat, original.Info.ID)
+			require.NoError(t, err, "RPC source guard must accept attested own identity")
+			edit := g.BuildEdit(original.Info.Chat, original.Info.ID, &waE2E.Message{Conversation: proto.String("new")})
+			require.Equal(t, participant.String(), edit.GetProtocolMessage().GetKey().GetParticipant())
+			prepared, sender, err := g.prepareOutgoingMutation(original.Info.Chat, edit)
+			require.NoError(t, err)
+			require.Equal(t, participant, sender)
+			event := &events.Message{Info: types.MessageInfo{MessageSource: types.MessageSource{Chat: original.Info.Chat, Sender: sender, IsFromMe: true, IsGroup: true}, ID: "edit-event", Timestamp: time.Unix(200, 0)}, Message: prepared}
+			require.NoError(t, g.persistOutgoingMutation(event))
+			require.NoError(t, db.Close())
+			g, db = captionTestOpen(t, path)
+			g.Store.LID = types.NewJID("777", types.HiddenUserServer)
+			require.NoError(t, g.Storage.Messages.UpsertOneMessage(original))
+			actual, err := g.Storage.Messages.GetMessage(original.Info.ID)
+			require.NoError(t, err)
+			require.Equal(t, "new", actual.Message.Message.GetConversation())
+			require.Equal(t, participant, actual.Info.Sender)
+			revoke := g.BuildRevoke(original.Info.Chat, participant, original.Info.ID)
+			prepared, sender, err = g.prepareOutgoingMutation(original.Info.Chat, revoke)
+			require.NoError(t, err)
+			require.Equal(t, participant.String(), prepared.GetProtocolMessage().GetKey().GetParticipant())
+			event.Info.Sender, event.Message = sender, prepared
+			require.NoError(t, g.persistOutgoingMutation(event))
+			require.NoError(t, db.Close())
+			g, _ = captionTestOpen(t, path)
+			g.Store.LID = types.NewJID("777", types.HiddenUserServer)
+			require.NoError(t, g.Storage.Messages.UpsertOneMessage(original))
+			_, err = g.Storage.Messages.GetMessage(original.Info.ID)
+			require.ErrorIs(t, err, storage.ErrNotFound)
+		})
+	}
+}
+
+func TestOwnGroupIdentityRejectsForeignPNAndLID(t *testing.T) {
+	for _, foreign := range []types.JID{types.NewJID("111", types.DefaultUserServer), types.NewJID("222", types.HiddenUserServer), types.NewJID("999", types.HiddenUserServer), types.NewJID("777", types.DefaultUserServer)} {
+		t.Run(foreign.String(), func(t *testing.T) {
+			g, _ := editTestGoWS(t)
+			g.Store.LID = types.NewJID("777", types.HiddenUserServer)
+			original := ownHistoryFixture(t, g, foreign)
+			require.NoError(t, g.Storage.Messages.UpsertOneMessage(original))
+			_, err := g.OwnMessageKey(original, original.Info.Chat, original.Info.ID)
+			require.ErrorIs(t, err, storage.ErrMessageKeyConflict)
+			edit := g.BuildEdit(original.Info.Chat, original.Info.ID, &waE2E.Message{Conversation: proto.String("forbidden")})
+			require.ErrorIs(t, g.validateOutgoingMutation(original.Info.Chat, edit), storage.ErrMessageKeyConflict)
+			edit.ProtocolMessage.Key.Participant = proto.String(foreign.String())
+			require.ErrorIs(t, g.validateOutgoingMutation(original.Info.Chat, edit), storage.ErrMessageKeyConflict)
+		})
+	}
+}
+
+func TestRevokePreservesForeignNamespaceAndAdminTarget(t *testing.T) {
+	for _, foreign := range []types.JID{types.NewJID("111", types.DefaultUserServer), types.NewJID("222", types.HiddenUserServer), types.NewJID("999", types.HiddenUserServer), types.NewJID("777", types.DefaultUserServer)} {
+		t.Run(foreign.String(), func(t *testing.T) {
+			path := filepath.Join(t.TempDir(), "revoke.db")
+			g, db := captionTestOpen(t, path)
+			g.Store.LID = types.NewJID("777", types.HiddenUserServer)
+			original := ownHistoryFixture(t, g, g.Store.LID)
+			require.NoError(t, g.Storage.Messages.UpsertOneMessage(original))
+			revoke := g.BuildRevoke(original.Info.Chat, foreign, original.Info.ID)
+			require.False(t, revoke.GetProtocolMessage().GetKey().GetFromMe())
+			require.Equal(t, foreign.String(), revoke.GetProtocolMessage().GetKey().GetParticipant())
+			require.ErrorIs(t, g.validateOutgoingMutation(original.Info.Chat, revoke), storage.ErrMessageKeyConflict,
+				"foreign target must not become a revocation of our own message")
+			unchanged, err := g.Storage.Messages.GetMessage(original.Info.ID)
+			require.NoError(t, err)
+			require.Equal(t, g.Store.LID, unchanged.Info.Sender)
+			require.Equal(t, "old", unchanged.Message.Message.GetConversation())
+
+			require.NoError(t, g.Storage.Messages.DeleteMessage(original.Info.ID))
+			original.Info.IsFromMe = false
+			original.Info.Sender = foreign
+			original.SourceWebMsg.Key.FromMe = proto.Bool(false)
+			original.SourceWebMsg.Key.Participant = proto.String(foreign.String())
+			original.SourceWebMsg.OriginalSelfAuthorUserJIDString = nil
+			require.NoError(t, g.Storage.Messages.UpsertOneMessage(original))
+			prepared, sender, err := g.prepareOutgoingMutation(original.Info.Chat, revoke)
+			require.NoError(t, err, "an admin revoke must retain its distinct foreign target")
+			require.False(t, prepared.GetProtocolMessage().GetKey().GetFromMe())
+			require.Equal(t, foreign.String(), prepared.GetProtocolMessage().GetKey().GetParticipant())
+			event := &events.Message{Info: types.MessageInfo{MessageSource: types.MessageSource{Chat: original.Info.Chat, Sender: sender, IsFromMe: true, IsGroup: true}, ID: "admin-revoke", Timestamp: time.Unix(200, 0)}, Message: prepared}
+			require.NoError(t, g.persistOutgoingMutation(event))
+			require.NoError(t, db.Close())
+			g, _ = captionTestOpen(t, path)
+			g.Store.LID = types.NewJID("777", types.HiddenUserServer)
+			require.NoError(t, g.Storage.Messages.UpsertOneMessage(original))
+			_, err = g.Storage.Messages.GetMessage(original.Info.ID)
+			require.ErrorIs(t, err, storage.ErrNotFound)
+		})
+	}
+}
+
+func TestOwnRevokeAliasesSurviveHistoryAndRestart(t *testing.T) {
+	for _, kind := range []string{"incoming admin", "outgoing", "history stub"} {
+		for _, namespace := range []string{"PN", "LID"} {
+			for _, cache := range []string{"present", "pending", "collision"} {
+				t.Run(kind+"/"+namespace+"/"+cache, func(t *testing.T) {
+					path := filepath.Join(t.TempDir(), "own-revokes.db")
+					g, db := captionTestOpen(t, path)
+					g.Store.LID = types.NewJID("777", types.HiddenUserServer)
+					participant, target := g.GetOwnId(), g.Store.LID
+					if namespace == "LID" {
+						participant, target = target, participant
+					}
+					original := ownHistoryFixture(t, g, participant)
+					if cache == "present" {
+						require.NoError(t, g.Storage.Messages.UpsertOneMessage(original))
+					} else if cache == "collision" {
+						collision := ownHistoryFixture(t, g, types.NewJID("555", types.DefaultUserServer))
+						collision.Info.IsFromMe = false
+						require.NoError(t, g.Storage.Messages.UpsertOneMessage(collision))
+					}
+					event := &events.Message{
+						Info: types.MessageInfo{MessageSource: types.MessageSource{Chat: original.Info.Chat, Sender: types.NewJID("888", types.DefaultUserServer), IsGroup: true}, ID: "incoming-admin-revoke", Timestamp: time.Unix(200, 0)},
+						Message: &waE2E.Message{ProtocolMessage: &waE2E.ProtocolMessage{Type: waE2E.ProtocolMessage_REVOKE.Enum(), Key: &waCommon.MessageKey{
+							RemoteJID: proto.String(original.Info.Chat.String()), ID: proto.String(original.Info.ID), FromMe: proto.Bool(false), Participant: proto.String(target.String()),
+						}}},
+					}
+					if kind == "outgoing" {
+						event.Info.IsFromMe, event.Info.Sender = true, g.GetOwnId()
+						event.Message = g.BuildRevoke(original.Info.Chat, target, original.Info.ID)
+					} else if kind == "history stub" {
+						event = ownHistoryFixture(t, g, target).Message
+						event.SourceWebMsg.MessageStubType = waWeb.WebMessageInfo_REVOKE.Enum()
+					}
+					author := event.Info.Sender
+					payload := proto.Clone(event.Message)
+					record := &storage.StoredMessage{Message: event}
+					require.NoError(t, g.resolveStoredMutation(record))
+					require.Len(t, record.OwnRevokeKeys, 2)
+					serialized, err := json.Marshal(record)
+					require.NoError(t, err)
+					require.NotContains(t, string(serialized), "OwnRevokeKeys")
+					err = g.Storage.Messages.UpsertOneMessage(record)
+					if cache == "collision" {
+						require.ErrorIs(t, err, storage.ErrMessageKeyConflict)
+						untouched, err := g.Storage.Messages.GetMessage(original.Info.ID)
+						require.NoError(t, err)
+						require.Equal(t, "555@s.whatsapp.net", untouched.Info.Sender.String())
+						require.Equal(t, "old", untouched.Message.Message.GetConversation())
+						require.NoError(t, g.Storage.Messages.DeleteMessage(original.Info.ID))
+					} else {
+						require.NoError(t, err)
+						_, err = g.Storage.Messages.GetMessage(original.Info.ID)
+						require.ErrorIs(t, err, storage.ErrNotFound)
+					}
+					require.Equal(t, author, event.Info.Sender, "authenticated event author must be unchanged")
+					require.True(t, proto.Equal(payload, event.Message), "shared event payload must be unchanged")
+					require.NoError(t, db.Close())
+					g, _ = captionTestOpen(t, path)
+					g.Store.LID = types.NewJID("777", types.HiddenUserServer)
+					for _, own := range []types.JID{participant, target} {
+						history := ownHistoryFixture(t, g, own)
+						require.NoError(t, g.Storage.Messages.UpsertOneMessage(history))
+						_, err = g.Storage.Messages.GetMessage(original.Info.ID)
+						require.ErrorIs(t, err, storage.ErrNotFound, "neither attested own namespace may resurrect after restart")
+					}
+					foreign := ownHistoryFixture(t, g, types.NewJID("999", types.HiddenUserServer))
+					foreign.Info.IsFromMe = false
+					require.NoError(t, g.Storage.Messages.UpsertOneMessage(foreign))
+					visible, err := g.Storage.Messages.GetMessage(original.Info.ID)
+					require.NoError(t, err, "tombstones must not suppress the foreign same-User namespace")
+					require.Equal(t, foreign.Info.Sender, visible.Info.Sender)
+				})
+			}
+		}
+	}
+}
diff --git a/src/gows/own_message_identity.go b/src/gows/own_message_identity.go
