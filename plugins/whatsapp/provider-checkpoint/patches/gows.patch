+		if _, err := BuildABMessagePin(abPinTestKey(), false, duration, abPinTestIntent()); !errors.Is(err, ErrABInvalidArgument) {
+			t.Fatalf("accepted user duration for unpin %v: %v", duration, err)
+		}
