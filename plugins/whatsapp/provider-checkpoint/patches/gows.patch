+	"github.com/stretchr/testify/require"
+	"go.mau.fi/whatsmeow"
+	"go.mau.fi/whatsmeow/proto/waCommon"
+	"go.mau.fi/whatsmeow/proto/waE2E"
+	"go.mau.fi/whatsmeow/proto/waWeb"
+	waStore "go.mau.fi/whatsmeow/store"
+	"go.mau.fi/whatsmeow/types"
+	"go.mau.fi/whatsmeow/types/events"
+	waLog "go.mau.fi/whatsmeow/util/log"
+	"google.golang.org/protobuf/proto"
+)
+
+func captionTestOpen(t *testing.T, path string) (*GoWS, *sqlstorage.GContainer) {
+	t.Helper()
+	db, err := sqlstorage.New("sqlite3", path+"?_busy_timeout=10000&_foreign_keys=on", waLog.Noop)
+	require.NoError(t, err)
+	t.Cleanup(func() { db.Close() })
+	own := types.NewJID("999", types.DefaultUserServer)
+	g := &GoWS{Client: &whatsmeow.Client{Store: &waStore.Device{ID: &own}, Log: waLog.Noop}, Context: context.Background(), Storage: &storage.Storage{Messages: db.NewMessageStorage()}}
+	g.storageEventHandler = &StorageEventHandler{gows: g, log: waLog.Noop, storage: g.Storage}
+	return g, db
+}
+
+func captionFixture(kind string) *waE2E.Message {
+	payload := []byte("synthetic attachment bytes; never downloaded")
+	hash := sha256.Sum256(payload)
+	encHash, mediaKey := bytes.Repeat([]byte{2}, 32), bytes.Repeat([]byte{3}, 32)
+	url, path := "https://example.invalid/synthetic", "/synthetic/path"
+	contextInfo := &waE2E.ContextInfo{StanzaID: proto.String("quoted-original")}
+	switch kind {
+	case "image":
+		return &waE2E.Message{ImageMessage: &waE2E.ImageMessage{Caption: proto.String("old"), Mimetype: proto.String("image/png"), FileLength: proto.Uint64(uint64(len(payload))), FileSHA256: hash[:], FileEncSHA256: encHash, MediaKey: mediaKey, URL: &url, DirectPath: &path, Width: proto.Uint32(32), Height: proto.Uint32(24), ContextInfo: contextInfo}}
+	case "video":
+		return &waE2E.Message{VideoMessage: &waE2E.VideoMessage{Caption: proto.String("old"), Mimetype: proto.String("video/mp4"), FileLength: proto.Uint64(uint64(len(payload))), FileSHA256: hash[:], FileEncSHA256: encHash, MediaKey: mediaKey, URL: &url, DirectPath: &path, Seconds: proto.Uint32(3), ContextInfo: contextInfo}}
+	default:
+		message := &waE2E.Message{DocumentMessage: &waE2E.DocumentMessage{Caption: proto.String("old"), Mimetype: proto.String("application/pdf"), FileName: proto.String("original.pdf"), Title: proto.String("Original title"), PageCount: proto.Uint32(2), FileLength: proto.Uint64(uint64(len(payload))), FileSHA256: hash[:], FileEncSHA256: encHash, MediaKey: mediaKey, URL: &url, DirectPath: &path, ContextInfo: contextInfo}}
+		if kind == "wrapped document" {
+			return &waE2E.Message{DocumentWithCaptionMessage: &waE2E.FutureProofMessage{Message: message}}
+		}
+		return message
+	}
+}
+
+func captionMedia(message *waE2E.Message) whatsmeow.DownloadableMessage {
+	if message.GetImageMessage() != nil {
+		return message.ImageMessage
+	}
+	if message.GetVideoMessage() != nil {
+		return message.VideoMessage
+	}
+	if message.GetDocumentMessage() != nil {
+		return message.DocumentMessage
+	}
+	return message.GetDocumentWithCaptionMessage().GetMessage().GetDocumentMessage()
+}
+
+func setFixtureCaption(message *waE2E.Message, caption string) {
+	switch {
+	case message.GetImageMessage() != nil:
+		message.ImageMessage.Caption = proto.String(caption)
+	case message.GetVideoMessage() != nil:
+		message.VideoMessage.Caption = proto.String(caption)
+	case message.GetDocumentMessage() != nil:
+		message.DocumentMessage.Caption = proto.String(caption)
+	default:
+		message.DocumentWithCaptionMessage.Message.DocumentMessage.Caption = proto.String(caption)
+	}
+}
+
+func TestCaptionEditPreservesDownloadMetadataAcrossHistoryAndRestart(t *testing.T) {
+	for _, kind := range []string{"image", "video", "document", "wrapped document"} {
+		for _, pending := range []bool{false, true} {
+			t.Run(kind+map[bool]string{false: "/outgoing", true: "/pending"}[pending], func(t *testing.T) {
+				path := filepath.Join(t.TempDir(), "caption.db")
+				g, db := captionTestOpen(t, path)
+				content := captionFixture(kind)
+				untouched := proto.Clone(content).(*waE2E.Message)
+				chat := types.NewJID("123", types.DefaultUserServer)
+				original := &storage.StoredMessage{Message: &events.Message{
+					Info:    types.MessageInfo{MessageSource: types.MessageSource{Chat: chat, Sender: g.GetOwnId(), IsFromMe: true}, ID: "caption-original", Timestamp: time.Unix(100, 0)},
+					Message: content, RawMessage: content, SourceWebMsg: &waWeb.WebMessageInfo{Key: &waCommon.MessageKey{ID: proto.String("caption-original"), FromMe: proto.Bool(true)}, Message: content},
+				}, IsReal: true}
+				delta := g.BuildEditedMessage(chat, "edited caption", content)
+				event := &events.Message{Info: types.MessageInfo{MessageSource: original.Info.MessageSource, ID: "edit-event", Timestamp: time.Unix(200, 0)}, Message: g.BuildEdit(chat, original.Info.ID, delta)}
+				if !pending {
+					require.NoError(t, g.Storage.Messages.UpsertOneMessage(original))
+					require.NoError(t, g.validateOutgoingMutation(chat, event.Message))
+					require.NoError(t, g.persistOutgoingMutation(event))
+				} else {
+					require.NoError(t, g.Storage.Messages.UpsertOneMessage(&storage.StoredMessage{Message: event}))
+					require.NoError(t, db.Close())
+					g, db = captionTestOpen(t, path)
+					require.NoError(t, g.Storage.Messages.UpsertOneMessage(original))
+				}
+				require.NoError(t, g.persistOutgoingMutation(event), "duplicate edit is idempotent")
+				require.NoError(t, db.Close())
+				g, _ = captionTestOpen(t, path)
+				require.NoError(t, g.Storage.Messages.UpsertOneMessage(original), "stale history cannot remove edit or metadata")
+				stored, err := g.Storage.Messages.GetMessage(original.Info.ID)
+				require.NoError(t, err)
+				expected := proto.Clone(content).(*waE2E.Message)
+				setFixtureCaption(expected, "edited caption")
+				for _, actual := range []*waE2E.Message{stored.Message.Message, stored.RawMessage, stored.SourceWebMsg.GetMessage()} {
+					require.True(t, proto.Equal(expected, actual), "all fields except caption must be preserved: %v", actual)
+					// These are exactly the accessors consumed by whatsmeow's download path.
+					want, got := captionMedia(content), captionMedia(actual)
+					require.Equal(t, want.GetFileSHA256(), got.GetFileSHA256())
+					require.Equal(t, want.GetFileEncSHA256(), got.GetFileEncSHA256())
+					require.Equal(t, want.GetMediaKey(), got.GetMediaKey())
+					require.Equal(t, want.GetDirectPath(), got.GetDirectPath())
+				}
+				require.True(t, proto.Equal(untouched, content), "input must remain unchanged")
+			})
+		}
+	}
+}
+
+func TestCaptionEditStaysPendingBehindKeyOnlyPlaceholder(t *testing.T) {
+	g, original := editTestGoWS(t)
+	original.Info.IsFromMe = true
+	original.Info.Sender = g.GetOwnId()
+	original.Message.Message = captionFixture("image")
+	placeholder := &storage.StoredMessage{Message: &events.Message{Info: original.Info, Message: &waE2E.Message{}}, IsReal: false}
+	require.NoError(t, g.Storage.Messages.UpsertOneMessage(placeholder))
+	delta := g.BuildEditedMessage(original.Info.Chat, "pending caption", original.Message.Message)
+	event := &events.Message{Info: original.Info, Message: g.BuildEdit(original.Info.Chat, original.Info.ID, delta)}
+	event.Info.ID = "edit-event"
+	require.NoError(t, g.Storage.Messages.UpsertOneMessage(&storage.StoredMessage{Message: event}))
+	require.NoError(t, g.Storage.Messages.UpsertOneMessage(original))
+	stored, err := g.Storage.Messages.GetMessage(original.Info.ID)
+	require.NoError(t, err)
+	expected := proto.Clone(original.Message.Message).(*waE2E.Message)
+	setFixtureCaption(expected, "pending caption")
+	require.True(t, proto.Equal(expected, stored.Message.Message))
+}
