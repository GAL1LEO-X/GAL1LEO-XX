+func TestReceiptAliasSQLiteInstancesAndConcurrentSnapshots(t *testing.T) {
+	one, _, path := aliasSQLite(t, [][2]string{{aliasLID.User, aliasPN.User}})
+	two, _, _ := aliasSQLite(t, [][2]string{{aliasLID.User, "15550002222"}})
+	if one.ObserveReceiptAlias(context.Background(), aliasPN, aliasLID) != storage.AliasPair || two.ObserveReceiptAlias(context.Background(), aliasPN, aliasLID) != storage.AliasElsewhere {
+		t.Fatal("cross-instance mapping")
+	}
+	writer, err := sqlx.Open("sqlite3", path+"?_busy_timeout=1000")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer writer.Close()
+	writer.SetMaxOpenConns(1)
+	var wg sync.WaitGroup
+	errorsFound := make(chan string, 128)
+	wg.Add(1)
+	go func() {
+		defer wg.Done()
+		for n := 0; n < 30; n++ {
+			tx, err := writer.Begin()
+			if err != nil {
+				errorsFound <- "begin"
+				return
+			}
+			if _, err = tx.Exec("DELETE FROM whatsmeow_lid_map"); err == nil {
+				if n%2 == 0 {
+					_, err = tx.Exec("INSERT INTO whatsmeow_lid_map VALUES(?,?),(?,?)", aliasLID.User, "15550002222", "654321", aliasPN.User)
+				} else {
+					_, err = tx.Exec("INSERT INTO whatsmeow_lid_map VALUES(?,?)", aliasLID.User, aliasPN.User)
+				}
+			}
+			if err != nil {
+				tx.Rollback()
+				errorsFound <- "write"
+				return
+			}
+			if err = tx.Commit(); err != nil {
+				errorsFound <- "commit"
+				return
+			}
+		}
+	}()
+	for i := 0; i < 4; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			for n := 0; n < 30; n++ {
+				got := one.ObserveReceiptAlias(context.Background(), aliasPN, aliasLID)
+				if got != storage.AliasPair && got != storage.AliasElsewhere && got != storage.AliasReadError {
+					errorsFound <- "inconsistent snapshot"
+					return
+				}
+				got = two.ObserveReceiptAlias(context.Background(), aliasPN, aliasLID)
+				if got != storage.AliasElsewhere && got != storage.AliasReadError {
+					errorsFound <- "cross-instance read"
+					return
+				}
+			}
+		}()
+	}
+	wg.Wait()
+	close(errorsFound)
+	for message := range errorsFound {
+		t.Error(message)
+	}
+	if two.ObserveReceiptAlias(context.Background(), aliasPN, aliasLID) != storage.AliasElsewhere {
+		t.Fatal("mapping changed in other instance")
+	}
+}
