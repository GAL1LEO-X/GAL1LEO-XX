diff --git a/src/storage/sqlstorage/receipt_alias.go b/src/storage/sqlstorage/receipt_alias.go
new file mode 100644
index 0000000000000000000000000000000000000000..1c772310a7b16714c692b313ba424e8028020171
--- /dev/null
+++ b/src/storage/sqlstorage/receipt_alias.go
@@ -0,0 +1,83 @@
+package sqlstorage
+
+import (
+	"context"
+
+	"github.com/devlikeapro/gows/storage"
+	"go.mau.fi/whatsmeow/types"
+)
+
+const receiptAliasQuery = `SELECT lid, pn FROM whatsmeow_lid_map WHERE lid = $1 OR pn = $2 LIMIT 3`
+
+var _ storage.ReceiptAliasObserver = (*SqlLidmapStorage)(nil)
+
+// ObserveReceiptAlias reads the same instance's local SQLite database once.
+// Remote SQL stores are deliberately unavailable: this diagnostic must never
+// introduce network lookups. It does not use CachedLIDMap or mutate its cache.
+func (s *SqlLidmapStorage) ObserveReceiptAlias(ctx context.Context, pn, lid types.JID) storage.ReceiptAliasRelation {
+	p, l, valid := storage.ReceiptAliasPair(pn, lid)
+	if !valid || p != pn || l != lid {
+		return storage.AliasNotApplicable
+	}
+	if s == nil || s.db == nil || s.receiptDiagnosticGate == nil {
+		return storage.AliasUnavailable
+	}
+	if driver := s.db.DriverName(); driver != "sqlite3" && driver != "sqlite" {
+		return storage.AliasUnavailable
+	}
+	ctx, cancel := context.WithTimeout(ctx, storage.ReceiptAliasBudget)
+	defer cancel()
+	if ctx.Err() != nil {
+		return storage.AliasReadError
+	}
+	select {
+	case s.receiptDiagnosticGate <- struct{}{}:
+	default:
+		return storage.AliasReadError // Never queue diagnostic work or retry it.
+	}
+	result := make(chan storage.ReceiptAliasRelation, 1)
+	go func() {
+		relation := func() storage.ReceiptAliasRelation {
+			defer func() { <-s.receiptDiagnosticGate }()
+			return s.receiptAliasSnapshot(ctx, pn, lid)
+		}()
+		result <- relation
+	}()
+	// Some SQLite driver lock waits can outlive context cancellation. Bound
+	// caller waiting independently; retain the per-instance gate until the one
+	// read actually exits. No unbounded goroutine accumulation is possible.
+	select {
+	case <-ctx.Done():
+		return storage.AliasReadError
+	case relation := <-result:
+		if ctx.Err() != nil {
+			return storage.AliasReadError
+		}
+		return relation
+	}
+}
+
+func (s *SqlLidmapStorage) receiptAliasSnapshot(ctx context.Context, pn, lid types.JID) storage.ReceiptAliasRelation {
+	rows, err := s.db.QueryContext(ctx, receiptAliasQuery, lid.User, pn.User)
+	if err != nil {
+		return storage.AliasReadError
+	}
+	defer rows.Close()
+	entries := make([]storage.LidmapEntry, 0, 3)
+	for rows.Next() {
+		var l, p string
+		if err := rows.Scan(&l, &p); err != nil {
+			return storage.AliasReadError
+		}
+		entries = append(entries, storage.LidmapEntry{
+			Lid: types.NewJID(l, types.HiddenUserServer), Pn: types.NewJID(p, types.DefaultUserServer),
+		})
+		if len(entries) == 3 {
+			return storage.AliasConflict
+		}
+	}
+	if rows.Err() != nil || ctx.Err() != nil {
+		return storage.AliasReadError
+	}
+	return storage.ClassifyReceiptAliasSnapshot(pn, lid, entries)
+}
