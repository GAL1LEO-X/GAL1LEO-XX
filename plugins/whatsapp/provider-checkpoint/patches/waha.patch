+// Real source-extracted GOWS processor/session and MediaManager; provider RPC
+// and storage are synthetic. No Lottie conversion, account or network runs.
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const fsp = require('node:fs/promises');
+const os = require('node:os');
+const path = require('node:path');
+const crypto = require('node:crypto');
+const vm = require('node:vm');
+const { createRequire } = require('node:module');
+const { promisify } = require('node:util');
+const ts = require('typescript');
+const grpc = require('@grpc/grpc-js');
+const { messages } = require('./build/grpc/gows');
+const root = path.resolve(__dirname, '../..');
+const appRequire = createRequire(path.join(root, 'package.json'));
+const ZIP = Buffer.from('UEsDBBQAAAAAAAAAIVyT33JBPQAAAD0AAAAYAAAAYW5pbWF0aW9uL2FuaW1hdGlvbi5qc29ueyJ2IjoiNS43LjQiLCJmciI6MzAsImlwIjowLCJvcCI6MSwidyI6MTYsImgiOjE2LCJsYXllcnMiOltdfVBLAQIUAxQAAAAAAAAAIVyT33JBPQAAAD0AAAAYAAAAAAAAAAAAAACAAQAAAABhbmltYXRpb24vYW5pbWF0aW9uLmpzb25QSwUGAAAAAAEAAQBGAAAAcwAAAAAA', 'base64');
+const SHA = '871dadc43c21b2356b094b2702e40927fa2483a792918f9655ea2ea294f73f74';
+assert.equal(crypto.createHash('sha256').update(ZIP).digest('hex'), SHA);
+
+function ast(relative) {
+  return ts.createSourceFile(relative, fs.readFileSync(path.join(root, 'src', relative), 'utf8'), ts.ScriptTarget.Latest, true);
+}
+function top(source, name) {
+  const node = source.statements.find(function (item) {
+    return item.name?.text === name || (ts.isVariableStatement(item) && item.declarationList.declarations.some(function (declaration) { return declaration.name.getText(source) === name; }));
+  });
+  assert.ok(node, `Actual source ${name} must exist`);
+  return node.getText(source).replace(/^export /, '');
+}
+function compile(source, scope, expression) {
+  const code = ts.transpileModule(source, { compilerOptions: { target: ts.ScriptTarget.ES2020, module: ts.ModuleKind.CommonJS } }).outputText;
+  return vm.runInNewContext(`${code}\n${expression}`, scope);
+}
+const sessionSource = ast('core/engines/gows/session.gows.core.ts');
+const sessionClass = sessionSource.statements.find(function (item) { return ts.isClassDeclaration(item) && item.name.text === 'WhatsappSessionGoWSCore'; });
+const downloadMethod = sessionClass.members.find(function (item) { return ts.isMethodDeclaration(item) && item.name.getText(sessionSource) === 'downloadMediaSafe'; });
+assert.ok(downloadMethod);
+const tmpSource = ast('utils/tmpdir.ts');
+const TmpDir = compile(`${top(tmpSource, 'sanitize')}\n${top(tmpSource, 'TmpDir')}`, {
+  fs: fsp, os: os, path: path, setTimeout: setTimeout,
+}, 'TmpDir');
+class ImmediateCleanupTmpDir extends TmpDir {
+  constructor(logger, prefix) { super(logger, prefix, 0); }
+}
+const managerSource = ast('core/media/MediaManager.ts');
+const MediaManager = compile(`${top(managerSource, 'ext')}\n${top(managerSource, 'MediaManager')}`, {
+  mime: appRequire('mime-types'), promiseRetry: appRequire('promise-retry'),
+}, 'MediaManager');
+const utils = ast('core/engines/noweb/utils.ts');
+const compiled = [
