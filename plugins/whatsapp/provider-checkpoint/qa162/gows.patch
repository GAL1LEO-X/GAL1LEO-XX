@@ -0,0 +1,36 @@
+package storage
+
+import (
+	"context"
+	"go.mau.fi/whatsmeow/types"
+)
+
+// ReceiptAliasUpdater must verify the full cached key and the unique local
+// PN/LID mapping atomically with its status-only write. Observers cannot grant
+// this capability. Implementations must not fetch mappings or retry writes.
+type ReceiptAliasUpdater interface {
+	AdvanceReceiptAlias(context.Context, MessageKey, types.JID, bool, Status) ReceiptUpdateResult
+}
+
+type ReceiptUpdateResult string
+
+const (
+	ReceiptApplied           ReceiptUpdateResult = "applied"
+	ReceiptCurrent           ReceiptUpdateResult = "already_current"
+	ReceiptInvalid           ReceiptUpdateResult = "invalid_identity"
+	ReceiptMapping           ReceiptUpdateResult = "unverified_mapping"
+	ReceiptSourceUnavailable ReceiptUpdateResult = "source_unavailable"
+	ReceiptStoreUnavailable  ReceiptUpdateResult = "store_unavailable"
+	ReceiptStoreBusy         ReceiptUpdateResult = "store_busy"
+	ReceiptStoreError        ReceiptUpdateResult = "store_error"
+)
+
+func (r ReceiptUpdateResult) Safe() ReceiptUpdateResult {
+	switch r {
+	case ReceiptApplied, ReceiptCurrent, ReceiptInvalid, ReceiptMapping,
+		ReceiptSourceUnavailable, ReceiptStoreUnavailable, ReceiptStoreBusy, ReceiptStoreError:
+		return r
+	default:
+		return ReceiptStoreError
+	}
+}
