+func mutationOriginal(chat, sender string, fromMe bool) *storage.StoredMessage {
+	message := &waE2E.Message{Conversation: proto.String("original")}
+	jid, _ := types.ParseJID(chat)
+	participant, _ := types.ParseJID(sender)
+	status := storage.StatusServerAck
+	return &storage.StoredMessage{
+		Message: &events.Message{
+			Info: types.MessageInfo{
+				MessageSource: types.MessageSource{Chat: jid, Sender: participant, IsFromMe: fromMe, IsGroup: jid.Server == types.GroupServer},
+				ID:            "same-id", Timestamp: time.Unix(100, 0),
+			},
+			Message: message, RawMessage: message,
+			SourceWebMsg: &waWeb.WebMessageInfo{
+				Message: message,
+				Key:     &waCommon.MessageKey{ID: proto.String("same-id"), FromMe: proto.Bool(fromMe), RemoteJID: proto.String(chat)},
+			},
+		},
+		IsReal: true, Status: &status,
+	}
+}
+
+func mutationEvent(original *storage.StoredMessage, text string, at int64, revoke bool) *storage.StoredMessage {
+	typ := waE2E.ProtocolMessage_MESSAGE_EDIT
+	if revoke {
+		typ = waE2E.ProtocolMessage_REVOKE
+	}
+	key := &waCommon.MessageKey{
+		RemoteJID: proto.String(original.Info.Chat.String()), ID: proto.String(original.Info.ID),
+		// Protocol FromMe is relative to the event sender, not our account.
+		FromMe: proto.Bool(true),
+	}
+	if original.Info.IsGroup {
+		key.Participant = proto.String(original.Info.Sender.String())
+	}
+	info := original.Info
+	info.ID = "event-id"
+	info.Timestamp = time.UnixMilli(at)
+	content := &waE2E.Message{ProtocolMessage: &waE2E.ProtocolMessage{
+		Type: typ.Enum(), Key: key, TimestampMS: proto.Int64(at),
+		EditedMessage: &waE2E.Message{Conversation: proto.String(text)},
+	}}
+	return &storage.StoredMessage{Message: &events.Message{Info: info, Message: content, RawMessage: content}}
+}
+
+func requireCachedText(t *testing.T, s *SqlMessageStore, text string) *storage.StoredMessage {
+	t.Helper()
+	msg, err := s.GetMessage("same-id")
+	require.NoError(t, err)
+	require.Equal(t, text, msg.Message.Message.GetConversation())
+	require.Equal(t, text, msg.RawMessage.GetConversation())
+	require.Equal(t, text, msg.SourceWebMsg.GetMessage().GetConversation())
+	require.Equal(t, int64(100), msg.Info.Timestamp.Unix())
+	return msg
+}
