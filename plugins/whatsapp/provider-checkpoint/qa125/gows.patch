@@ -7,11 +7,12 @@ import (
 )
 
 func UpdateGroupInfo(group *types.GroupInfo, update *events.GroupInfo) (err error) {
-	err = updateGroupParams(group, update)
+	// Validate the participant version before mutating any cached parameter.
