+const assert = require('node:assert/strict');
+const { withABRequestIntent, withABErrors } = require('./build-api/api/ab.context');
+const { currentABIntent, ABInputError } = require('./build-api/core/engines/gows/ab.intent');
+const { ABMutationUncertainError } = require('./build-api/core/engines/gows/ab.adapter');
+
+test('real API wrapper preserves headers through an async operation', async function () {
+  const result = await withABRequestIntent('job-unchanged', '1792400000123', async function () {
+    await new Promise(setImmediate);
+    return currentABIntent();
+  });
+  assert.deepEqual(result, { intentId: 'job-unchanged', timestampMs: 1792400000123 });
+  assert.equal(currentABIntent(), undefined);
+});
+
+test('real API wrapper rejects malformed headers as HTTP 400 before operation', async function () {
+  let calls = 0;
+  await assert.rejects(withABRequestIntent('job', undefined, function () { calls++; }), function (error) {
+    return error.getStatus() === 400;
+  });
+  assert.equal(calls, 0);
+});
+
+test('real API wrapper preserves uncertain result as HTTP 502 with original intent', async function () {
+  await assert.rejects(withABRequestIntent('job-original', '1792400000123', async function () {
+    throw new ABMutationUncertainError('job-original');
+  }), function (error) {
+    assert.equal(error.getStatus(), 502);
+    assert.deepEqual(error.getResponse(), {
+      message: 'GOWS mutation outcome is uncertain; reconcile before repeating',
+      outcome: 'uncertain',
+      intentId: 'job-original',
+    });
+    return true;
+  });
+});
+
+test('real API wrapper preserves unrelated engine TypeErrors', async function () {
+  const failure = new TypeError('Internal engine implementation failure');
+  await assert.rejects(withABRequestIntent(undefined, undefined, function () {
+    throw failure;
+  }), function (error) { return error === failure; });
+});
+
+test('read input failures and typed provider rejections retain HTTP meaning', async function () {
+  const grpc = require('@grpc/grpc-js');
+  await assert.rejects(withABErrors(function () { throw new ABInputError('Invalid read identifier'); }), function (error) {
+    return error.getStatus() === 400;
+  });
+  for (const [code, status] of [[grpc.status.INVALID_ARGUMENT, 400], [grpc.status.NOT_FOUND, 404], [grpc.status.FAILED_PRECONDITION, 412]]) {
+    const failure = Object.assign(new Error('Provider rejected'), { code: code, details: 'A/B request rejected', metadata: new grpc.Metadata() });
+    await assert.rejects(withABRequestIntent('job', '1792400000123', async function () { throw failure; }), function (error) {
