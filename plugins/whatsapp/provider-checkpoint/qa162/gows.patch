+package gows
+
+import (
+	"database/sql"
+	"path/filepath"
+	"testing"
+
+	"github.com/devlikeapro/gows/storage"
+	"github.com/devlikeapro/gows/storage/sqlstorage"
+	"github.com/stretchr/testify/require"
+	"go.mau.fi/whatsmeow/types"
+	"go.mau.fi/whatsmeow/types/events"
+	waLog "go.mau.fi/whatsmeow/util/log"
+)
+
+func TestReceiptVerifiedAliasAdvancesRealCache(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "instance.db")
+	container, err := sqlstorage.New("sqlite3", path+"?_foreign_keys=on", waLog.Noop)
+	require.NoError(t, err)
+	defer container.Close()
+	messages := container.NewMessageStorage()
+	mapping := container.NewLidmapStorage()
+	pn := types.NewJID("15550001111", types.DefaultUserServer)
+	lid := types.NewJID("123456", types.HiddenUserServer)
+	writer, err := sql.Open("sqlite3", path)
+	require.NoError(t, err)
+	_, err = writer.Exec("INSERT INTO whatsmeow_lid_map(lid,pn) VALUES(?,?)", lid.User, pn.User)
+	require.NoError(t, err)
+	require.NoError(t, writer.Close())
+	status := storage.StatusServerAck
+	original := receiptStored(pn, true, &status)
+	original.Info.ID = "synthetic-outbound"
+	require.NoError(t, messages.UpsertOneMessage(original))
+	log := &receiptLogSpy{}
+	h := &StorageEventHandler{storage: &storage.Storage{Messages: messages, Lidmap: mapping}, log: log}
+	h.handleReceipt(&events.Receipt{MessageSource: types.MessageSource{Chat: lid}, MessageIDs: []types.MessageID{original.Info.ID}, Type: types.ReceiptTypeRead})
+	got, err := messages.GetMessage(original.Info.ID)
+	require.NoError(t, err)
+	require.Equal(t, storage.StatusRead, *got.Status)
+	require.Equal(t, pn, got.Info.Chat)
+	require.True(t, got.Info.IsFromMe)
+	require.Equal(t, storage.StatusServerAck, *original.Status, "input event stays immutable")
+}
+
+func TestReceiptVerifiedSelfDoesNotAcknowledgeOutgoing(t *testing.T) {
+	chat := types.NewJID("15550001111", types.DefaultUserServer)
+	status := storage.StatusServerAck
+	original := receiptStored(chat, true, &status)
+	h, s, _ := receiptHandler(map[types.MessageID]*storage.StoredMessage{"id": original})
+	h.handleReceipt(&events.Receipt{MessageSource: types.MessageSource{Chat: chat, IsFromMe: true}, MessageIDs: []types.MessageID{"id"}, Type: types.ReceiptTypeRead})
+	require.Zero(t, s.writes)
+	require.Equal(t, storage.StatusServerAck, *original.Status)
+}
