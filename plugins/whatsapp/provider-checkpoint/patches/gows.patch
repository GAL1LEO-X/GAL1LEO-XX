+	}
+	for _, own := range []types.JID{ownPN, ownLID} {
+		key.Participant = own
+		if err := validateABPinOwnIdentity(key, types.EmptyJID, types.EmptyJID); !errors.Is(err, ErrABFailedPrecondition) {
+			t.Fatalf("outgoing group accepted without session identity: %v", err)
