+func TestMessageMutationHistoryOrderAndRestart(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "messages.db")
+	db, s := mutationTestStore(t, path)
+	original := mutationOriginal("123@s.whatsapp.net", "123@s.whatsapp.net", false)
+	require.NoError(t, s.UpsertOneMessage(original))
+	require.NoError(t, s.UpsertOneMessage(mutationEvent(original, "latest", 400000, false)))
+	require.NoError(t, s.UpsertOneMessage(mutationEvent(original, "old edit", 300000, false)))
+	require.NoError(t, s.UpsertOneMessage(original))
+	requireCachedText(t, s, "latest")
+	require.Equal(t, "original", original.Message.Message.GetConversation(), "input event must not be mutated")
+	_, err := s.GetMessage("event-id")
+	require.ErrorIs(t, err, storage.ErrNotFound, "protocol envelope must not become an original")
+	require.NoError(t, db.Close())
+	_, reopened := mutationTestStore(t, path)
+	require.NoError(t, reopened.UpsertOneMessage(original))
+	requireCachedText(t, reopened, "latest")
+	messages, err := reopened.GetChatMessages(original.Info.Chat, storage.MessageFilter{}, storage.Pagination{}, false)
+	require.NoError(t, err)
+	require.Len(t, messages, 1)
+	require.Equal(t, "latest", messages[0].Message.Message.GetConversation())
+}
