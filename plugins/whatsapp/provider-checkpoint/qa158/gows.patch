+func aliasSQLite(t *testing.T, pairs [][2]string) (*SqlLidmapStorage, *sqlx.DB, string) {
+	t.Helper()
+	path := filepath.Join(t.TempDir(), "alias.db")
+	db, err := sqlx.Open("sqlite3", path+"?_busy_timeout=1000")
+	if err != nil {
+		t.Fatal(err)
+	}
+	db.SetMaxOpenConns(1)
+	t.Cleanup(func() { db.Close() })
+	for _, query := range []string{"PRAGMA journal_mode=WAL", "CREATE TABLE whatsmeow_lid_map(lid TEXT, pn TEXT)"} {
+		if _, err = db.Exec(query); err != nil {
+			t.Fatal(err)
+		}
+	}
+	for _, pair := range pairs {
+		if _, err = db.Exec("INSERT INTO whatsmeow_lid_map VALUES(?,?)", pair[0], pair[1]); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if _, err = db.Exec("PRAGMA query_only=ON"); err != nil {
+		t.Fatal(err)
+	}
+	return (&GContainer{db: db, dialect: "sqlite3"}).NewLidmapStorage(), db, path
+}
