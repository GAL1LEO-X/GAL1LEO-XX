+	require.Nil(t, parsed.Message.GetProtocolMessage())
+	require.Equal(t, "same-id", parsed.Info.ID)
+	require.NoError(t, s.UpsertOneMessage(&storage.StoredMessage{Message: parsed, IsReal: true}))
+	require.NoError(t, s.UpsertOneMessage(original))
+	requireCachedText(t, s, "history edit")
