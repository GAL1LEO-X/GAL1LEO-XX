+func TestABMessagePinPayload(t *testing.T) {
+	for _, duration := range []ABPinDuration{ABPinDurationDay, ABPinDurationWeek, ABPinDurationMonth} {
+		for _, fromMe := range []bool{false, true} {
+			for _, server := range []string{types.DefaultUserServer, types.HiddenUserServer} {
+				key := abPinTestKey()
+				key.FromMe = fromMe
+				key.Participant = types.NewJID("1234567890", server)
+				message, err := BuildABMessagePin(key, true, duration, abPinTestIntent())
+				if err != nil {
+					t.Fatal(err)
+				}
+				wire, err := proto.Marshal(message)
+				if err != nil {
+					t.Fatal(err)
+				}
+				var decoded waE2E.Message
+				if err = proto.Unmarshal(wire, &decoded); err != nil {
+					t.Fatal(err)
+				}
+				pin := decoded.GetPinInChatMessage()
+				if pin.GetType() != waE2E.PinInChatMessage_PIN_FOR_ALL || pin.GetSenderTimestampMS() != abPinTestIntent().TimestampMS {
+					t.Fatalf("wrong action or frozen timestamp: %v", pin)
+				}
+				k := pin.GetKey()
+				if k.GetRemoteJID() != key.Chat.String() || k.GetID() != key.ID || k.GetFromMe() != fromMe || k.GetParticipant() != key.Participant.String() {
+					t.Fatalf("message identity changed: %v", k)
+				}
+				if decoded.GetMessageContextInfo().GetMessageAddOnDurationInSecs() != uint32(duration) {
+					t.Fatalf("wrong duration: %v", decoded.GetMessageContextInfo())
+				}
+				fields := 0
+				decoded.ProtoReflect().Range(func(_ protoreflect.FieldDescriptor, _ protoreflect.Value) bool { fields++; return true })
+				if fields != 2 {
+					t.Fatalf("control message unexpectedly contains %d fields", fields)
+				}
+			}
+		}
+	}
+}
