+func TestABArchivePayloadFixture(t *testing.T) {
+	chat := abStateJID("12025550101@s.whatsapp.net")
+	for _, archived := range []bool{true, false} {
+		t.Run(map[bool]string{true: "archive", false: "unarchive"}[archived], func(t *testing.T) {
+			patch, err := BuildABArchivePatch(chat, archived, abStateIntent, nil)
+			if err != nil {
+				t.Fatal(err)
+			}
+			expectedMutations := 1
+			if archived {
+				expectedMutations = 2
+			}
+			if patch.Type != appstate.WAPatchRegularLow || len(patch.Mutations) != expectedMutations {
+				t.Fatalf("unexpected collection/count: %s/%d", patch.Type, len(patch.Mutations))
+			}
+			if patch.Timestamp.UnixMilli() != abStateIntent.TimestampMS {
+				t.Fatal("intent timestamp changed")
+			}
+			mutation := patch.Mutations[0]
+			if mutation.Version != 3 || !reflect.DeepEqual(mutation.Index, []string{"archive", chat.String()}) {
+				t.Fatal("archive fixture index/version mismatch")
+			}
+			action := mutation.Value.GetArchiveChatAction()
+			if action == nil || action.GetArchived() != archived {
+				t.Fatal("archive boolean lost")
+			}
+			messageRange := action.GetMessageRange()
+			if messageRange.GetLastMessageTimestamp() != abStateIntent.TimestampMS/1000 || len(messageRange.GetMessages()) != 0 {
+				t.Fatal("empty archive invented history or changed frozen timestamp")
+			}
+			if archived {
+				pin := patch.Mutations[1]
+				if pin.Version != 5 || !reflect.DeepEqual(pin.Index, []string{"pin_v1", chat.String()}) || pin.Value.GetPinAction() == nil || pin.Value.GetPinAction().GetPinned() {
+					t.Fatal("archive must unpin only the personal chat")
+				}
+			}
+			// Round-trip the action fixture through the actual protobuf codec.
+			encoded, err := proto.Marshal(mutation.Value)
+			if err != nil {
+				t.Fatal(err)
+			}
+			decoded := mutation.Value.ProtoReflect().Type().New().Interface()
+			if err = proto.Unmarshal(encoded, decoded); err != nil || !proto.Equal(decoded, mutation.Value) {
+				t.Fatal("protobuf fixture round trip failed")
+			}
+		})
+	}
+}
