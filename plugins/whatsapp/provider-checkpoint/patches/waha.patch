+// Private offline A/B checkpoint, 2026-10-19. No account connection or retries.
+import { randomUUID } from 'crypto';
+import * as grpc from '@grpc/grpc-js';
+import { messages } from './grpc/gows';
+import { ABInputError, currentABIntent } from './ab.intent';
+
+type ABClient = Pick<
+  messages.MessageServiceClient,
+  | 'GetContactAbout'
+  | 'GetABContract'
+  | 'GetChatArchiveState'
+  | 'SetContactBlocked'
+  | 'SetChatArchived'
+  | 'SetMessageStar'
+  | 'SetMessagePin'
+>;
+
+export interface ABAdapterHooks {
+  client(): ABClient;
+  session(): messages.Session;
+  intentId?(): string;
+  now?(): number;
+}
+
+export interface ABAccepted {
+  // Accepted by the provider; this does not assert device observation.
+  outcome: 'accepted';
+  intentId: string;
+}
+
+export class ABMutationUncertainError extends Error {
+  readonly outcome = 'uncertain';
+
+  constructor(
+    public readonly intentId: string,
+    public readonly cause?: unknown,
+  ) {
+    super('GOWS mutation outcome is uncertain; reconcile before repeating');
+    this.name = 'ABMutationUncertainError';
+  }
+}
+
+/** Shared by the eight session overrides and the offline gRPC harness. */
+export class GowsABAdapter {
+  constructor(private readonly hooks: ABAdapterHooks) {}
+
+  async getABCapabilities(): Promise<{
+    version: string;
+    operations: string[];
+  }> {
+    const response = await this.call<messages.ABContractResponse>(function(
+      client,
+      callback,
+    ) {
+      return client.GetABContract(new messages.Empty(), callback);
+    });
+    return { version: response.version, operations: response.operations };
+  }
+
+  async readChatArchiveState(
+    chatId: string,
+  ): Promise<{
+    known: boolean;
+    archived: boolean;
+    source: string;
+    phoneFresh: false;
+  }> {
+    const session = this.session();
+    const jid = this.jid(chatId);
+    // Local cache and historical keys never run mutable identifier hooks.
+    const response = await this.call<messages.ABChatArchiveState>(function(
+      client,
+      callback,
+    ) {
+      return client.GetChatArchiveState(
+        new messages.JidRequest({ session: session, jid: jid }),
+        callback,
+      );
+    });
+    return {
+      known: response.known,
+      archived: response.archived,
+      source: response.source,
+      phoneFresh: false,
+    };
+  }
+
+  async getContactAbout(contactId: string): Promise<{ about: string | null }> {
+    const session = this.session();
+    const jid = this.jid(contactId, true);
+    const response = await this.call<messages.ContactAboutResponse>(function(
+      client,
+      callback,
+    ) {
+      return client.GetContactAbout(
+        new messages.JidRequest({ session: session, jid: jid }),
+        callback,
+      );
+    });
+    return { about: response.about?.value ?? null };
+  }
+
+  blockContact(contactId: string): Promise<ABAccepted> {
+    return this.contactBlocked(contactId, true);
+  }
+
+  unblockContact(contactId: string): Promise<ABAccepted> {
+    return this.contactBlocked(contactId, false);
+  }
+
+  chatsArchiveChat(chatId: string): Promise<ABAccepted> {
+    return this.chatArchived(chatId, true);
+  }
+
+  chatsUnarchiveChat(chatId: string): Promise<ABAccepted> {
+    return this.chatArchived(chatId, false);
+  }
+
+  async setStar(request: {
+    chatId: string;
+    messageId: string;
+    star: boolean;
+  }): Promise<void> {
+    if (typeof request.star !== 'boolean') {
+      throw new ABInputError('star must be a boolean');
+    }
+    const session = this.session();
+    const key = this.key(request.chatId, request.messageId);
+    const intent = this.intent();
+    await this.mutate(intent.intent_id, function(client, callback) {
+      return client.SetMessageStar(
+        new messages.SetMessageStarRequest({
+          session: session,
+          key: key,
+          starred: request.star,
+          intent_id: intent.intent_id,
+          timestamp_ms: intent.timestamp_ms,
+        }),
+        callback,
+      );
+    });
+  }
+
+  async pinMessage(
+    chatId: string,
+    messageId: string,
+    duration: number,
+  ): Promise<boolean> {
+    if (![86400, 604800, 2592000].includes(duration)) {
+      throw new ABInputError(
+        'Pin duration must be 86400, 604800 or 2592000 seconds',
+      );
+    }
+    await this.messagePinned(chatId, messageId, true, duration);
+    return true;
+  }
