diff --git a/checkpoints/offline-ab/fixture-stack.cjs b/checkpoints/offline-ab/fixture-stack.cjs
new file mode 100644
index 0000000000000000000000000000000000000000..0f47076af62722fa8a9794685dd077cd70e1e060
--- /dev/null
+++ b/checkpoints/offline-ab/fixture-stack.cjs
@@ -0,0 +1,52 @@
+// Run inside the network-disabled build container. Only fake backend processes.
+const fs = require('node:fs');
+const path = require('node:path');
+const { spawn } = require('node:child_process');
+const readline = require('node:readline');
+
+function argument(name) {
+  const index = process.argv.indexOf(name);
+  return index === -1 ? undefined : process.argv[index + 1];
+}
+const children = [];
+function start(command, args) {
+  const child = spawn(command, args, { stdio: ['ignore', 'pipe', 'inherit'] });
+  children.push(child);
+  return child;
+}
+function ready(child) {
+  return new Promise(function (resolve, reject) {
+    const timer = setTimeout(function () { reject(new Error('Offline fixture readiness timed out')); }, 15000);
+    const lines = readline.createInterface({ input: child.stdout });
+    lines.once('line', function (line) {
+      clearTimeout(timer);
+      try { resolve(JSON.parse(line)); } catch (error) { reject(error); }
+    });
+    child.once('error', function (error) { clearTimeout(timer); reject(error); });
+    child.once('exit', function (code) { clearTimeout(timer); reject(new Error(`Fixture exited before readiness: ${code}`)); });
+  });
+}
+function stop() {
+  for (const child of children) child.kill('SIGTERM');
+}
+process.on('SIGTERM', stop);
+process.on('SIGINT', stop);
+async function main() {
+  const fixture = argument('--fixture');
+  if (!fixture) throw new Error('--fixture binary is required');
+  const backend = start(fixture, []);
+  const grpc = await ready(backend);
+  const runner = start(process.execPath, [path.join(__dirname, 'vertical.cjs'), grpc.address]);
+  runner.stdout.pipe(process.stdout);
+  const exit = await new Promise(function (resolve) { runner.once('exit', resolve); });
+  if (exit !== 0) throw new Error(`Offline vertical failed: ${exit}`);
+  const socketFile = argument('--socket-file');
+  if (!socketFile) { stop(); return; }
+  const bridge = start(process.execPath, [path.join(__dirname, 'http-bridge.cjs'), '--grpc', grpc.address, '--socket-file', socketFile]);
+  const http = await ready(bridge);
+  const result = { grpc: grpc.address, socket: http.socket, fixtureRouter: true, network: 'none' };
+  const readyFile = argument('--ready-file');
+  if (readyFile) fs.writeFileSync(readyFile, JSON.stringify(result) + '\n');
+  process.stdout.write(JSON.stringify(result) + '\n');
+}
+main().catch(function (error) { stop(); process.stderr.write(error.stack + '\n'); process.exitCode = 1; });
diff --git a/checkpoints/offline-ab/http-bridge.cjs b/checkpoints/offline-ab/http-bridge.cjs
new file mode 100644
index 0000000000000000000000000000000000000000..5bf223919476d81ab4772f741cf17625a582b5f3
--- /dev/null
+++ b/checkpoints/offline-ab/http-bridge.cjs
@@ -0,0 +1,173 @@
+// Offline fixture HTTP router. This is not NestJS and does not load session hooks,
+// credentials, an account, storage, or any WhatsApp-capable runtime.
+const fs = require('node:fs');
+const http = require('node:http');
+const grpc = require('@grpc/grpc-js');
+const { messages } = require('./build-api/core/engines/gows/grpc/gows');
+const { GowsABAdapter } = require('./build-api/core/engines/gows/ab.adapter');
+const { withABErrors, withABRequestIntent } = require('./build-api/api/ab.context');
+
+function argument(name) {
+  const index = process.argv.indexOf(name);
+  return index === -1 ? undefined : process.argv[index + 1];
+}
+
+const address = argument('--grpc');
+if (!/^127\.0\.0\.1:[1-9][0-9]*$/.test(address ?? '')) {
+  throw new Error('--grpc must be a loopback fixture address');
+}
+const client = new messages.MessageServiceClient(address, grpc.credentials.createInsecure(), {
+  'grpc.enable_retries': 0,
+});
+let calls = 0;
+function adapter(sessionId) {
+  return new GowsABAdapter({
+    client: function () { calls++; return client; },
+    session: function () { return new messages.Session({ id: sessionId }); },
+  });
+}
+
+function json(response, status, body) {
+  response.writeHead(status, { 'content-type': 'application/json' });
+  response.end(JSON.stringify(body));
+}
+
+async function body(request) {
+  const chunks = [];
+  let size = 0;
+  for await (const chunk of request) {
+    size += chunk.length;
+    if (size > 16384) throw new TypeError('Fixture request body too large');
+    chunks.push(chunk);
+  }
+  const raw = Buffer.concat(chunks).toString('utf8');
+  return raw ? JSON.parse(raw) : {};
+}
+
+async function route(request, response) {
+  const url = new URL(request.url, 'http://127.0.0.1');
+  if (request.method === 'GET' && url.pathname === '/__fixture/stats') {
+    return json(response, 200, { rpcCalls: calls });
+  }
+  if (request.method === 'POST' && url.pathname === '/__fixture/reset') {
+    calls = 0;
+    return json(response, 200, { rpcCalls: calls });
+  }
+  if (request.method === 'GET' && url.pathname === '/api/contacts/ab-capabilities') {
+    return json(response, 200, await adapter(url.searchParams.get('session')).getABCapabilities());
+  }
+  if (request.method === 'GET' && url.pathname === '/api/contacts/about') {
+    const session = adapter(url.searchParams.get('session'));
+    return json(response, 200, await session.getContactAbout(url.searchParams.get('contactId')));
+  }
+  // Synthetic source proof only. No history fetch or provider SDK is involved.
+  const source = url.pathname.match(/^\/api\/fixture-a\/(?:chats\/([^/]+)\/)?messages\/([^/]+)$/);
+  if (request.method === 'GET' && source) {
+    const identifier = decodeURIComponent(source[2]);
+    const key = identifier.match(/^(false|true)_15550001111@(c\.us|s\.whatsapp\.net)_SOURCE$/);
+    const chat = '15550001111@c.us';
+    const target = source[1] && decodeURIComponent(source[1]).replace(/@s\.whatsapp\.net$/, '@c.us');
+    if (!key || target && target !== chat) {
+      return json(response, 404, { error: 'No synthetic fixture source' });
+    }
+    return json(response, 200, {
+      id: identifier,
+      chatId: chat,
+      from: chat,
+      to: null,
+      fromMe: key[1] === 'true',
+      timestamp: 1792400000,
+      body: 'offline fixture source only',
+      _data: {
+        IsViewOnce: false,
+        IsViewOnceV2: false,
+        IsViewOnceV2Extension: false,
+        IsEphemeral: false,
+        Message: { conversation: 'offline fixture source only' },
+      },
+    });
+  }
+  const archiveState = url.pathname.match(/^\/api\/([^/]+)\/chats\/([^/]+)\/archive-state$/);
+  if (request.method === 'GET' && archiveState) {
+    return json(response, 200, await adapter(decodeURIComponent(archiveState[1])).readChatArchiveState(decodeURIComponent(archiveState[2])));
+  }
+  const data = await body(request);
+  if (request.method === 'POST' && /^\/api\/contacts\/(block|unblock)$/.test(url.pathname)) {
+    const session = adapter(data.session);
+    let result;
+    if (url.pathname.endsWith('/block')) {
+      result = await session.blockContact(data.contactId);
+    } else {
+      result = await session.unblockContact(data.contactId);
+    }
+    return json(response, 201, result);
+  }
+  if (request.method === 'PUT' && url.pathname === '/api/star') {
+    await adapter(data.session).setStar(data);
+    response.writeHead(200);
+    return response.end();
+  }
+  const chat = url.pathname.match(/^\/api\/([^/]+)\/chats\/([^/]+)\/(archive|unarchive)$/);
+  if (request.method === 'POST' && chat) {
+    const session = adapter(decodeURIComponent(chat[1]));
+    const chatId = decodeURIComponent(chat[2]);
+    let result;
+    if (chat[3] === 'archive') {
+      result = await session.chatsArchiveChat(chatId);
+    } else {
+      result = await session.chatsUnarchiveChat(chatId);
+    }
+    return json(response, 201, result);
+  }
+  const message = url.pathname.match(/^\/api\/([^/]+)\/chats\/([^/]+)\/messages\/([^/]+)\/(pin|unpin)$/);
+  if (request.method === 'POST' && message) {
+    const session = adapter(decodeURIComponent(message[1]));
+    const chatId = decodeURIComponent(message[2]);
+    const messageId = decodeURIComponent(message[3]);
+    let result;
+    if (message[4] === 'pin') {
+      result = await session.pinMessage(chatId, messageId, data.duration);
+    } else {
+      result = await session.unpinMessage(chatId, messageId);
+    }
+    return json(response, 201, { success: result });
+  }
+  json(response, 404, { error: 'No fixture route' });
+}
+
+const server = http.createServer(function (request, response) {
+  const operation = Promise.resolve().then(function () {
+    if (request.method === 'GET') return withABErrors(function () { return route(request, response); });
+    return withABRequestIntent(
+      request.headers['x-whatsapp-intent-id'],
+      request.headers['x-whatsapp-intent-timestamp-ms'],
+      function () { return route(request, response); },
+    );
+  });
+  operation.catch(function (error) {
+    if (typeof error?.getStatus === 'function') {
+      return json(response, error.getStatus(), error.getResponse());
+    }
+    json(response, 500, { error: error?.message ?? 'Fixture request failed' });
+  });
+});
+const socketFile = argument('--socket-file');
+function listening() {
+  const ready = socketFile
+    ? { socket: socketFile, fixtureRouter: true }
+    : { address: `http://127.0.0.1:${server.address().port}`, fixtureRouter: true };
+  const file = argument('--port-file');
+  if (file) fs.writeFileSync(file, JSON.stringify(ready) + '\n');
+  process.stdout.write(JSON.stringify(ready) + '\n');
+}
+if (socketFile) {
+  if (fs.existsSync(socketFile)) throw new Error('Fixture socket path already exists');
+  server.listen(socketFile, listening);
+} else {
+  server.listen(0, '127.0.0.1', listening);
+}
+function stop() {
+  server.close(function () { client.close(); });
+}
+process.on('SIGTERM', stop);
+process.on('SIGINT', stop);
