+package server
+
+import (
+	"context"
+	pb "github.com/devlikeapro/gows/proto"
+)
+
+func (s *Server) GetContactAbout(ctx context.Context, req *pb.JidRequest) (*pb.ContactAboutResponse, error) {
+	jid, err := abParseContactJID(req.GetJid())
+	if err != nil {
+		return nil, err
+	}
+	cli, err := s.abClient(req.GetSession())
+	if err != nil {
+		return nil, err
+	}
+	about, err := cli.GetContactAbout(ctx, jid)
+	if err != nil {
+		return nil, abError(err)
+	}
+	response := &pb.ContactAboutResponse{}
+	if about != nil {
+		response.About = &pb.OptionalString{Value: *about}
+	}
+	return response, nil
+}
+
+func (s *Server) SetContactBlocked(ctx context.Context, req *pb.SetContactBlockedRequest) (*pb.ABMutationResponse, error) {
+	jid, err := abParseContactJID(req.GetJid())
+	if err != nil {
+		return nil, err
+	}
+	intent, err := abParseIntent(req.GetIntentId(), req.GetTimestampMs())
+	if err != nil {
+		return nil, err
+	}
+	cli, err := s.abClient(req.GetSession())
+	if err != nil {
+		return nil, err
+	}
+	return abMutationResponse(cli.SetContactBlocked(ctx, jid, req.GetBlocked(), intent))
+}
