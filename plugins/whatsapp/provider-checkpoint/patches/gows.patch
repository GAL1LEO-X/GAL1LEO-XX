+func TestMessageMutationPreservesSourceRestrictions(t *testing.T) {
+	_, s := mutationTestStore(t, filepath.Join(t.TempDir(), "restricted.db"))
+	original := mutationOriginal("123@s.whatsapp.net", "123@s.whatsapp.net", false)
+	original.RawMessage = &waE2E.Message{ViewOnceMessageV2: &waE2E.FutureProofMessage{Message: original.Message.Message}}
+	original.Message.Message = &waE2E.Message{ExtendedTextMessage: &waE2E.ExtendedTextMessage{
+		Text: proto.String("original"), ContextInfo: &waE2E.ContextInfo{Expiration: proto.Uint32(60)},
+	}}
+	require.NoError(t, s.UpsertOneMessage(original))
+	require.NoError(t, s.UpsertOneMessage(mutationEvent(original, "edited", 200000, false)))
+	stored := requireCachedText(t, s, "edited")
+	require.True(t, stored.IsViewOnce)
+	require.True(t, stored.IsEphemeral)
+	require.Equal(t, uint32(60), stored.SourceWebMsg.GetEphemeralDuration())
+	require.Equal(t, uint64(100), stored.SourceWebMsg.GetEphemeralStartTimestamp())
+	// A stale receipt/history snapshot without flags must not clear restrictions.
+	stale := mutationOriginal("123@s.whatsapp.net", "123@s.whatsapp.net", false)
+	require.NoError(t, s.UpsertOneMessage(stale))
+	stored = requireCachedText(t, s, "edited")
+	require.True(t, stored.IsViewOnce)
+	require.True(t, stored.IsEphemeral)
+	require.Equal(t, uint32(60), stored.SourceWebMsg.GetEphemeralDuration())
+}
