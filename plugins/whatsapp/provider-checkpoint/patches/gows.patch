+type abStateCapture struct {
+	calls   int
+	patches []appstate.PatchInfo
+	err     error
+}
+
+func (capture *abStateCapture) SendAppState(_ context.Context, patch appstate.PatchInfo) error {
+	capture.calls++
+	capture.patches = append(capture.patches, patch)
+	return capture.err
+}
+
+func TestABStateUncertainNeverRetriesOrRefreshesIntent(t *testing.T) {
+	chat := abStateJID("12025550101@s.whatsapp.net")
+	// This intentionally old intent is preserved. Ordering and durable replay
+	// protection belong to the caller ledger, not an in-memory GoWS guess.
+	patch, err := BuildABArchivePatch(chat, true, abStateIntent, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, primitiveErr := range []error{nil, errors.New("no app state keys"), errors.New("409 conflict"), errors.New("failed fetching state after accepted send"), context.DeadlineExceeded} {
+		capture := &abStateCapture{err: primitiveErr}
+		result, err := abSubmitState(context.Background(), capture, patch, abStateIntent)
+		if err != nil {
+			t.Fatal(err)
+		}
+		outcome := ABMutationAccepted
+		if primitiveErr != nil {
+			outcome = ABMutationUncertain
+		}
+		if result.Outcome != outcome || result.IntentID != abStateIntent.ID || capture.calls != 1 {
+			t.Fatal("primitive error must remain uncertain with exactly one adapter call")
+		}
+		if capture.patches[0].Timestamp.UnixMilli() != abStateIntent.TimestampMS {
+			t.Fatal("old intent timestamp refreshed")
+		}
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	capture := &abStateCapture{}
+	if _, err := abSubmitState(ctx, capture, patch, abStateIntent); !errors.Is(err, context.Canceled) || capture.calls != 0 {
+		t.Fatal("canceled preflight must not dispatch")
+	}
+	patchAgain, err := BuildABArchivePatch(chat, true, abStateIntent, nil)
+	if err != nil || !reflect.DeepEqual(patch, patchAgain) {
+		t.Fatal("same intent produced a changed payload")
+	}
+}
