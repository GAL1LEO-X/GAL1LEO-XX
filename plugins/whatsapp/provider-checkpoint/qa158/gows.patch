+func TestReceiptAliasUnsupportedAdapterOrExpiredContextNeverQueries(t *testing.T) {
+	script := &aliasScript{}
+	s := aliasFake(t, script)
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	if s.ObserveReceiptAlias(ctx, aliasPN, aliasLID) != storage.AliasReadError {
+		t.Fatal("expired context")
+	}
+	if s.ObserveReceiptAlias(context.Background(), types.PSAJID, aliasLID) != storage.AliasNotApplicable {
+		t.Fatal("special target")
+	}
+	s.db = sqlx.NewDb(s.db.DB, "postgres")
+	if s.ObserveReceiptAlias(context.Background(), aliasPN, aliasLID) != storage.AliasUnavailable {
+		t.Fatal("remote SQL must not introduce network calls")
+	}
+	var missing *SqlLidmapStorage
+	if missing.ObserveReceiptAlias(context.Background(), aliasPN, aliasLID) != storage.AliasUnavailable {
+		t.Fatal("nil adapter")
+	}
+	script.mu.Lock()
+	defer script.mu.Unlock()
+	if script.calls != 0 {
+		t.Fatal("unexpected database query")
+	}
