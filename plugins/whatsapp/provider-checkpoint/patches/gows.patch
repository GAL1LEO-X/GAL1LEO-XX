index 0000000000000000000000000000000000000000..4d1b41cd3ae8474c6ae6756a934461606d2a6816
--- /dev/null
+++ b/src/gows/own_message_identity.go
@@ -0,0 +1,86 @@
+package gows
+
+import (
+	"errors"
+
+	"github.com/devlikeapro/gows/storage"
+	"go.mau.fi/whatsmeow/proto/waCommon"
+	"go.mau.fi/whatsmeow/types"
+	"google.golang.org/protobuf/proto"
+)
+
+// IsOwnMessageJID accepts only identities attested by this session's device
+// store. It does not resolve arbitrary PN/LID aliases.
+func (gows *GoWS) IsOwnMessageJID(jid types.JID) bool {
+	if gows == nil || gows.Client == nil || gows.Store == nil || jid.IsEmpty() {
+		return false
+	}
+	jid = jid.ToNonAD()
+	return jid == gows.Store.GetJID().ToNonAD() || jid == gows.Store.GetLID().ToNonAD()
+}
+
+// OwnMessageKey preserves the participant namespace of the cached original.
+func (gows *GoWS) OwnMessageKey(msg *storage.StoredMessage, chat types.JID, id types.MessageID) (storage.MessageKey, error) {
+	key := storage.MessageKey{Chat: chat.ToNonAD().String(), ID: id, FromMe: true}
+	if msg == nil || msg.Message == nil {
+		return key, storage.ErrInvalidMessageKey
+	}
+	if chat.Server == types.GroupServer {
+		if !gows.IsOwnMessageJID(msg.Info.Sender) {
+			return key, storage.ErrMessageKeyConflict
+		}
+		key.Participant = msg.Info.Sender.ToNonAD().String()
+	}
+	return key, storage.RequireMessageKey(msg, key)
+}
+
+func (gows *GoWS) ownRevocationKeys(key storage.MessageKey) []storage.MessageKey {
+	chat, err := types.ParseJID(key.Chat)
+	if err != nil || !key.FromMe || chat.Server != types.GroupServer {
+		return nil
+	}
+	participant, err := types.ParseJID(key.Participant)
+	if err != nil || !gows.IsOwnMessageJID(participant) {
+		return nil
+	}
+	var keys []storage.MessageKey
+	for _, own := range []types.JID{gows.Store.GetJID(), gows.Store.GetLID()} {
+		if !own.IsEmpty() {
+			alias := key
+			alias.Participant = own.ToNonAD().String()
+			keys = append(keys, alias)
+		}
+	}
+	return keys
+}
+
+func (gows *GoWS) ownMutationSource(info types.MessageInfo, wire *waCommon.MessageKey) (types.MessageInfo, *waCommon.MessageKey, error) {
+	if !info.IsFromMe || info.Chat.Server != types.GroupServer || !wire.GetFromMe() {
+		return info, wire, nil
+	}
+	if !gows.IsOwnMessageJID(info.Sender) {
+		return info, wire, storage.ErrMessageKeyConflict
+	}
+	target := info.Sender.ToNonAD()
+	if wire.GetParticipant() != "" {
+		parsed, err := types.ParseJID(wire.GetParticipant())
+		if err != nil || !gows.IsOwnMessageJID(parsed) {
+			return info, wire, storage.ErrMessageKeyConflict
+		}
+		target = parsed.ToNonAD()
+	}
+	if gows.Storage != nil && gows.Storage.Messages != nil {
+		original, err := gows.Storage.Messages.GetMessage(wire.GetID())
+		if err == nil {
+			if _, matchErr := gows.OwnMessageKey(original, info.Chat, wire.GetID()); matchErr == nil {
+				target = original.Info.Sender.ToNonAD()
+			}
+		} else if !errors.Is(err, storage.ErrNotFound) && !errors.Is(err, storage.ErrStorageDisabled) {
+			return info, wire, err
+		}
+	}
+	info.Sender = target
+	resolved := proto.Clone(wire).(*waCommon.MessageKey)
+	resolved.Participant = proto.String(target.String())
+	return info, resolved, nil
+}
