diff --git a/src/storage/sqlstorage/message_mutations.go b/src/storage/sqlstorage/message_mutations.go
new file mode 100644
index 0000000000000000000000000000000000000000..27129690f57d8e694ea612a97492d73732975d44
--- /dev/null
+++ b/src/storage/sqlstorage/message_mutations.go
@@ -0,0 +1,415 @@
+package sqlstorage
+
+import (
+	"database/sql"
+	"errors"
+	"fmt"
+
+	sq "github.com/Masterminds/squirrel"
+	"github.com/devlikeapro/gows/storage"
+	"github.com/jmoiron/sqlx"
+	"go.mau.fi/whatsmeow/proto/waCommon"
+	"go.mau.fi/whatsmeow/proto/waE2E"
+	"go.mau.fi/whatsmeow/proto/waWeb"
+	"go.mau.fi/whatsmeow/types"
+	"google.golang.org/protobuf/encoding/protojson"
+	"google.golang.org/protobuf/proto"
+	"google.golang.org/protobuf/reflect/protoreflect"
+)
+
+type messageMutation struct {
+	key     storage.MessageKey
+	kind    string
+	eventMS int64
+	data    string
+}
+
+func parseMutation(msg *storage.StoredMessage) (*messageMutation, error) {
+	// A history revocation marker dominates any retained (possibly edited)
+	// message payload in that record.
+	if msg.SourceWebMsg != nil && (msg.SourceWebMsg.GetMessageStubType() == waWeb.WebMessageInfo_REVOKE || msg.SourceWebMsg.GetRevokeMessageTimestamp() != 0) {
+		key, err := storage.MessageKeyFromInfo(msg.Info)
+		return &messageMutation{key: key, kind: "revoke", eventMS: msg.Info.Timestamp.UnixMilli()}, err
+	}
+	p := storage.EventMutationProtocol(msg.Message)
+	if p == nil || (p.GetType() != waE2E.ProtocolMessage_MESSAGE_EDIT && p.GetType() != waE2E.ProtocolMessage_REVOKE) {
+		return nil, nil
+	}
+	key, err := storage.ResolveMutationKey(msg.Info, p.GetKey())
+	if msg.MutationKey != nil {
+		key, err = *msg.MutationKey, nil
+		if key.Chat != msg.Info.Chat.ToNonAD().String() || key.ID != p.GetKey().GetID() {
+			return nil, storage.ErrMessageKeyConflict
+		}
+	}
+	if err != nil {
+		return nil, err
+	}
+	m := &messageMutation{key: key, kind: "revoke", eventMS: msg.Info.Timestamp.UnixMilli()}
+	if p.GetType() == waE2E.ProtocolMessage_MESSAGE_EDIT {
+		if !p.GetKey().GetFromMe() {
+			return nil, fmt.Errorf("%w: edit target is not its sender's message", storage.ErrMessageKeyConflict)
+		}
+		m.kind = "edit"
+		if p.GetTimestampMS() > 0 {
+			m.eventMS = p.GetTimestampMS()
+		}
+		if m.eventMS <= 0 || p.GetEditedMessage() == nil {
+			return nil, fmt.Errorf("edit lacks content or event timestamp")
+		}
+		data, err := protojson.Marshal(p.GetEditedMessage())
+		if err != nil {
+			return nil, err
+		}
+		m.data = string(data)
+	}
+	return m, nil
+}
+
+func loadStoredMessage(tx *sqlx.Tx, id string) (*storage.StoredMessage, error) {
+	var data string
+	if err := tx.Get(&data, "SELECT data FROM gows_messages WHERE id = $1", id); err != nil {
+		if errors.Is(err, sql.ErrNoRows) {
+			return nil, nil
+		}
+		return nil, err
+	}
+	var msg storage.StoredMessage
+	if err := messageMapper.Unmarshal([]byte(data), &msg); err != nil {
+		return nil, err
+	}
+	return &msg, nil
+}
+
+func loadMutation(tx *sqlx.Tx, key storage.MessageKey) (*messageMutation, error) {
+	m := &messageMutation{key: key}
+	err := tx.QueryRow("SELECT kind, event_ms, data FROM gows_message_mutations WHERE jid=$1 AND id=$2 AND from_me=$3 AND participant=$4",
+		key.Chat, key.ID, key.FromMe, key.Participant).Scan(&m.kind, &m.eventMS, &m.data)
+	if errors.Is(err, sql.ErrNoRows) {
+		return nil, nil
+	}
+	return m, err
+}
+
+func saveMutation(tx *sqlx.Tx, m *messageMutation) error {
+	_, err := tx.Exec(`INSERT INTO gows_message_mutations (jid,id,from_me,participant,kind,event_ms,data)
+		VALUES ($1,$2,$3,$4,$5,$6,$7) ON CONFLICT (jid,id,from_me,participant)
+		DO UPDATE SET kind=EXCLUDED.kind,event_ms=EXCLUDED.event_ms,data=EXCLUDED.data`,
+		m.key.Chat, m.key.ID, m.key.FromMe, m.key.Participant, m.kind, m.eventMS, m.data)
+	return err
+}
+
+func overlayMutation(msg *storage.StoredMessage, m *messageMutation) error {
+	if m == nil {
+		return nil
+	}
+	if err := storage.RequireMessageKey(msg, m.key); err != nil {
+		return err
+	}
+	content := &waE2E.Message{}
+	if err := protojson.Unmarshal([]byte(m.data), content); err != nil {
+		return err
+	}
+	var err error
+	content, err = applyCaptionEdit(msg.Message.Message, content)
+	if err != nil {
+		return err
+	}
+	retainSourceRestrictions(msg, msg)
+	msg.Message.Message = content
+	msg.RawMessage = proto.Clone(content).(*waE2E.Message)
+	if msg.SourceWebMsg != nil {
+		msg.SourceWebMsg.Message = proto.Clone(content).(*waE2E.Message)
+	}
+	msg.IsEdit = true
+	return nil
+}
+
+// Media edit payloads are deltas, not replacement attachments. Preserve binary
+// identity, download references, filenames and source context from the original;
+// only the caption is editable. Never merge protobufs indiscriminately.
+func applyCaptionEdit(original, edited *waE2E.Message) (*waE2E.Message, error) {
+	if original == nil {
+		return edited, nil
+	}
+	result := proto.Clone(original).(*waE2E.Message)
+	originalDoc := original.GetDocumentMessage()
+	resultDoc := result.GetDocumentMessage()
+	if originalDoc == nil {
+		originalDoc = original.GetDocumentWithCaptionMessage().GetMessage().GetDocumentMessage()
+		resultDoc = result.GetDocumentWithCaptionMessage().GetMessage().GetDocumentMessage()
+	}
+	editedDoc := edited.GetDocumentMessage()
+	if editedDoc == nil {
+		editedDoc = edited.GetDocumentWithCaptionMessage().GetMessage().GetDocumentMessage()
+	}
+	switch {
+	case original.GetImageMessage() != nil && edited.GetImageMessage() != nil:
+		result.ImageMessage.Caption = proto.String(edited.GetImageMessage().GetCaption())
+	case original.GetVideoMessage() != nil && edited.GetVideoMessage() != nil:
+		result.VideoMessage.Caption = proto.String(edited.GetVideoMessage().GetCaption())
+	case originalDoc != nil && editedDoc != nil:
+		resultDoc.Caption = proto.String(editedDoc.GetCaption())
+	case original.GetImageMessage() != nil || original.GetVideoMessage() != nil || originalDoc != nil ||
+		edited.GetImageMessage() != nil || edited.GetVideoMessage() != nil || editedDoc != nil:
+		return nil, fmt.Errorf("edit content type does not match original media")
+	default:
+		return edited, nil
+	}
+	return result, nil
+}
+
+// Editing text/caption must not make a previously restricted source eligible
+// for forward/pin/download. Preserve restrictive flags and the earliest known
+// expiry independently of the replacement content's context fields.
+func retainSourceRestrictions(dst, source *storage.StoredMessage) {
+	dst.IsEphemeral = dst.IsEphemeral || source.IsEphemeral
+	dst.IsViewOnce = dst.IsViewOnce || source.IsViewOnce
+	dst.IsViewOnceV2 = dst.IsViewOnceV2 || source.IsViewOnceV2
+	dst.IsViewOnceV2Extension = dst.IsViewOnceV2Extension || source.IsViewOnceV2Extension
+	expiration := source.SourceWebMsg.GetEphemeralDuration()
+	start := source.SourceWebMsg.GetEphemeralStartTimestamp()
+	if start == 0 && source.Info.Timestamp.Unix() > 0 {
+		start = uint64(source.Info.Timestamp.Unix())
+	}
+	var inspect func(*waE2E.Message, int)
+	inspect = func(content *waE2E.Message, depth int) {
+		if content == nil || depth > 8 {
+			return
+		}
+		content.ProtoReflect().Range(func(field protoreflect.FieldDescriptor, value protoreflect.Value) bool {
+			if field.Message() != nil && !field.IsList() && !field.IsMap() {
+				if c, ok := value.Message().Interface().(interface{ GetContextInfo() *waE2E.ContextInfo }); ok {
+					if e := c.GetContextInfo().GetExpiration(); e != 0 && (expiration == 0 || e < expiration) {
+						expiration = e
+						if source.Info.Timestamp.Unix() > 0 {
+							start = uint64(source.Info.Timestamp.Unix())
+						}
+					}
+				}
+			}
+			return true
+		})
+		for _, wrapper := range []*waE2E.FutureProofMessage{
+			content.GetEphemeralMessage(), content.GetViewOnceMessage(),
+			content.GetViewOnceMessageV2(), content.GetViewOnceMessageV2Extension(),
+			content.GetDocumentWithCaptionMessage(),
+		} {
+			inspect(wrapper.GetMessage(), depth+1)
+		}
+		dst.IsEphemeral = dst.IsEphemeral || content.GetEphemeralMessage() != nil
+		dst.IsViewOnce = dst.IsViewOnce || content.GetViewOnceMessage() != nil || content.GetViewOnceMessageV2() != nil || content.GetViewOnceMessageV2Extension() != nil
+	}
+	inspect(source.Message.Message, 0)
+	inspect(source.RawMessage, 0)
+	if expiration > 0 {
+		dst.IsEphemeral = true
+		if dst.SourceWebMsg == nil {
+			dst.SourceWebMsg = &waWeb.WebMessageInfo{Key: &waCommon.MessageKey{
+				ID: proto.String(dst.Info.ID), RemoteJID: proto.String(dst.Info.Chat.String()),
+				FromMe: proto.Bool(dst.Info.IsFromMe), Participant: proto.String(dst.Info.Sender.String()),
+			}}
+		}
+		// Never extend an existing expiry when history carries a different
+		// duration/start pair.
+		oldDuration, oldStart := dst.SourceWebMsg.GetEphemeralDuration(), dst.SourceWebMsg.GetEphemeralStartTimestamp()
+		if oldDuration == 0 || oldStart == 0 || start+uint64(expiration) < oldStart+uint64(oldDuration) {
+			dst.SourceWebMsg.EphemeralDuration = proto.Uint32(expiration)
+			dst.SourceWebMsg.EphemeralStartTimestamp = proto.Uint64(start)
+		}
+	}
+}
+
+func (s SqlMessageStore) writeMessage(tx *sqlx.Tx, msg *storage.StoredMessage) error {
+	fields := s.mapper.ToFields(msg)
+	data, err := s.mapper.Marshal(msg)
+	if err != nil {
+		return err
+	}
+	fields["data"] = string(data)
+	values := make([]interface{}, 0, len(s.table.Columns))
+	for _, c := range s.table.Columns {
+		values = append(values, fields[c])
+	}
+	query, args, err := sq.Insert(s.table.Name).Columns(s.table.Columns...).Values(values...).Suffix(s.onConflict).ToSql()
+	if err != nil {
+		return err
+	}
+	_, err = tx.Exec(query, args...)
+	return err
+}
+
+func (s SqlMessageStore) upsertMessageWithMutations(input *storage.StoredMessage) error {
+	if input == nil || input.Message == nil {
+		return storage.ErrInvalidMessageKey
+	}
+	// Clone before merging: dispatch, emission and receipt handling can share the
+	// input event. Database projection must not mutate an emitted event.
+	data, err := s.mapper.Marshal(input)
+	if err != nil {
+		return err
+	}
+	var msg storage.StoredMessage
+	if err = s.mapper.Unmarshal(data, &msg); err != nil {
+		return err
+	}
+	msg.MutationKey = input.MutationKey
+	mutation, err := parseMutation(&msg)
+	if err != nil {
+		return err
+	}
+	var key storage.MessageKey
+	if mutation != nil {
+		key = mutation.key
+	} else if key, err = storage.MessageKeyFromInfo(msg.Info); err != nil {
+		return err
+	}
+	// These aliases are derived only from the session's attested own identities
+	// by GoWS. Accept no changes of chat, ID or direction, and no aliases for
+	// edits. Revocation is terminal for both own namespaces, including when no
+	// original exists yet. They are committed with the projection in one tx.
+	revokeKeys := input.OwnRevokeKeys
+	if len(revokeKeys) > 0 {
+		if mutation == nil || mutation.kind != "revoke" || !key.FromMe || input.Info.Chat.Server != types.GroupServer || key.Participant == "" || len(revokeKeys) > 2 {
+			return storage.ErrMessageKeyConflict
+		}
+		for _, alias := range revokeKeys {
+			if alias.Chat != key.Chat || alias.ID != key.ID || !alias.FromMe || alias.Participant == "" {
+				return storage.ErrMessageKeyConflict
+			}
+		}
+	}
+	tx, err := s.db.Beginx()
+	if err != nil {
+		return err
+	}
+	defer tx.Rollback()
+	if _, err = tx.Exec("UPDATE gows_message_mutation_lock SET id=id WHERE id=1"); err != nil {
+		return err
+	}
+	original, err := loadStoredMessage(tx, key.ID)
+	if err != nil {
+		return err
+	}
+	if original != nil {
+		for _, alias := range revokeKeys {
+			if storage.RequireMessageKey(original, alias) == nil {
+				key = alias
+				mutation.key = alias
+				break
+			}
+		}
+	}
+	// The full-key ledger is independent of the legacy short-ID projection.
+	// Persist a valid mutation for B even when A occupies the short ID, while
+	// refusing any projection into A. Otherwise retention of A could resurrect B.
+	identityConflict := false
+	if original != nil {
+		if err = storage.RequireMessageKey(original, key); err != nil {
+			if mutation == nil {
+				return err
+			}
+			identityConflict = true
+			original = nil
+		}
+	}
+	if mutation != nil && mutation.kind == "edit" && original != nil && !original.IsReal {
+		// A key-distribution placeholder is not an attachment/edit base. Keep
+		// the delta pending until real content arrives, without losing it to a
+		// media-type mismatch or modifying the placeholder.
+		original = nil
+	}
+	// A history snapshot can already contain the edited original, with the
+	// original key and creation timestamp. It is a usable original only when
+	// the retained web record itself has that key; a separate edit envelope
+	// cannot supply the original timestamp and remains pending.
+	if !identityConflict && original == nil && mutation != nil && mutation.kind == "edit" && msg.SourceWebMsg != nil &&
+		msg.SourceWebMsg.GetKey().GetID() == key.ID && msg.Info.ID == key.ID && msg.SourceWebMsg.GetMessageTimestamp() > 0 {
+		if err = storage.RequireMessageKey(&msg, key); err != nil {
+			return err
+		}
+		msg.IsReal = true
+		original = &msg
+	}
+	current, err := loadMutation(tx, key)
+	if err != nil {
+		return err
+	}
+	conflict := false
+	if mutation != nil {
+		switch {
+		case current != nil && current.kind == "revoke":
+			// Revocation is terminal, regardless of event arrival order.
+		case mutation.kind == "revoke" || current == nil || mutation.eventMS > current.eventMS:
+			current = mutation
+		case mutation.eventMS == current.eventMS && mutation.kind == "edit" && current.kind == "edit":
+			a, b := &waE2E.Message{}, &waE2E.Message{}
+			if err = protojson.Unmarshal([]byte(current.data), a); err != nil {
+				return err
+			}
+			if err = protojson.Unmarshal([]byte(mutation.data), b); err != nil {
+				return err
+			}
+			if !proto.Equal(a, b) {
+				current.kind, current.data = "conflict", ""
+				conflict = true
+			}
+		}
+		if err = saveMutation(tx, current); err != nil {
+			return err
+		}
+		for _, alias := range revokeKeys {
+			if alias == key {
+				continue
+			}
+			tombstone := &messageMutation{key: alias, kind: "revoke", eventMS: mutation.eventMS}
+			if err = saveMutation(tx, tombstone); err != nil {
+				return err
+			}
+		}
+	}
+	if current != nil && (current.kind == "revoke" || current.kind == "conflict") {
+		// Keep the durable tombstone while hiding stale content from all legacy
+		// reads (including forwarding and media download).
+		if original != nil {
+			if _, err = tx.Exec("DELETE FROM gows_messages WHERE id=$1", key.ID); err != nil {
+				return err
+			}
+		}
+	} else if mutation != nil {
+		if original != nil {
+			if err = overlayMutation(original, current); err != nil {
+				return err
+			}
+			if err = s.writeMessage(tx, original); err != nil {
+				return err
+			}
+		}
+	} else {
+		if original != nil {
+			if original.IsReal {
+				msg.Info.Timestamp = original.Info.Timestamp
+			}
+			retainSourceRestrictions(&msg, original)
+			if original.Status != nil && (msg.Status == nil || *original.Status > *msg.Status) {
+				msg.Status = original.Status
+			}
+		}
+		if err = overlayMutation(&msg, current); err != nil {
+			return err
+		}
+		if err = s.writeMessage(tx, &msg); err != nil {
+			return err
+		}
+	}
+	if err = tx.Commit(); err != nil {
+		return err
+	}
+	if identityConflict {
+		return fmt.Errorf("%w: full-key mutation persisted without changing the colliding original", storage.ErrMessageKeyConflict)
+	}
+	if conflict {
+		return storage.ErrMessageMutationConflict
+	}
+	return nil
+}
