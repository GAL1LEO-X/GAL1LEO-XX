+  return ts.isClassDeclaration(statement) && statement.name.text === 'WhatsappSessionGoWSCore';
+});
+const methods = ['fileToMedia', 'sendMedia', 'sendVoice', 'sendVideo'].map(function (name) {
+  const method = sessionClass.members.find(function (member) {
