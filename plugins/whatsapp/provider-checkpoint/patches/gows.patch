+func TestMessageMutationMigrationFromV8PreservesOriginal(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "upgrade.db")
+	db, s := mutationTestStore(t, path)
+	original := mutationOriginal("123@s.whatsapp.net", "123@s.whatsapp.net", false)
+	require.NoError(t, s.EntityRepository.UpsertOne(original))
+	_, err := db.db.Exec("DROP TABLE gows_message_mutations")
+	require.NoError(t, err)
+	_, err = db.db.Exec("DROP TABLE gows_message_mutation_lock")
+	require.NoError(t, err)
+	_, err = db.db.Exec("UPDATE gows_migrations SET version=8")
+	require.NoError(t, err)
+	require.NoError(t, db.Close())
+	_, reopened := mutationTestStore(t, path)
+	requireCachedText(t, reopened, "original")
+	require.NoError(t, reopened.UpsertOneMessage(mutationEvent(original, "after upgrade", 200000, false)))
+	requireCachedText(t, reopened, "after upgrade")
+}
