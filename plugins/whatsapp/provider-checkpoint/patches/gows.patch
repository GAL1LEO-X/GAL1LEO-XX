+	"google.golang.org/protobuf/proto"
+)
+
+// The embedded interface deliberately exposes no live client. Only the pin
+// method below can execute; another method would fail the offline test.
+type abPinRPCFake struct {
+	gows.ABClient
+	calls    int
+	key      gows.ABMessageKey
+	pinned   bool
+	duration gows.ABPinDuration
+	intent   gows.ABIntent
+	result   gows.ABMutationResult
+	err      error
+}
+
+func (f *abPinRPCFake) SetMessagePin(_ context.Context, key gows.ABMessageKey, pinned bool, duration gows.ABPinDuration, intent gows.ABIntent) (gows.ABMutationResult, error) {
+	f.calls++
+	f.key, f.pinned, f.duration, f.intent = key, pinned, duration, intent
+	return f.result, f.err
+}
+
+func abPinRPCRequest() *pb.SetMessagePinRequest {
+	return &pb.SetMessagePinRequest{
+		Session: &pb.Session{Id: "owner-session"},
+		Key:     &pb.ABMessageKey{Chat: "120363000000001@g.us", Id: "SOURCE", FromMe: false, Participant: "1234567890@lid"},
+		Pinned:  true, Duration: pb.ABPinDuration_AB_PIN_DURATION_WEEK,
+		IntentId: "STABLE_PIN_1", TimestampMs: 1800000000000,
+	}
+}
+
+func TestABSetMessagePinRPCMapsCompleteIdentity(t *testing.T) {
+	for _, pinned := range []bool{true, false} {
+		for _, fromMe := range []bool{true, false} {
+			request := abPinRPCRequest()
+			request.Pinned, request.Key.FromMe = pinned, fromMe
+			if !pinned {
+				request.Duration = pb.ABPinDuration_AB_PIN_DURATION_UNSPECIFIED
+			}
+			fake := &abPinRPCFake{result: gows.ABMutationResult{Outcome: gows.ABMutationAccepted, IntentID: request.GetIntentId()}}
+			resolved := ""
+			server := &Server{ABClientResolver: func(session string) (gows.ABClient, error) { resolved = session; return fake, nil }}
+			response, err := server.SetMessagePin(context.Background(), request)
+			if err != nil || response.GetOutcome() != pb.ABMutationOutcome_AB_MUTATION_ACCEPTED || response.GetIntentId() != request.GetIntentId() {
+				t.Fatalf("unexpected result: %v %v", response, err)
+			}
+			if resolved != request.GetSession().GetId() || fake.calls != 1 || fake.key.Chat.String() != request.Key.Chat || fake.key.ID != request.Key.Id || fake.key.FromMe != fromMe || fake.key.Participant.String() != request.Key.Participant || fake.pinned != pinned || int32(fake.duration) != int32(request.Duration) || fake.intent.ID != request.IntentId || fake.intent.TimestampMS != request.TimestampMs {
+				t.Fatalf("request identity changed: session=%q fake=%+v", resolved, fake)
+			}
+		}
+	}
+}
+
+func TestABSetMessagePinRPCInvalidRequestNeverResolves(t *testing.T) {
+	for _, test := range []struct {
+		name   string
+		change func(*pb.SetMessagePinRequest)
+	}{
+		{"missing session", func(r *pb.SetMessagePinRequest) { r.Session = nil }},
+		{"empty session", func(r *pb.SetMessagePinRequest) { r.Session.Id = "" }},
+		{"missing key", func(r *pb.SetMessagePinRequest) { r.Key = nil }},
+		{"missing chat", func(r *pb.SetMessagePinRequest) { r.Key.Chat = "" }},
+		{"missing message id", func(r *pb.SetMessagePinRequest) { r.Key.Id = "" }},
+		{"invalid jid", func(r *pb.SetMessagePinRequest) { r.Key.Chat = "peer@invalid.example" }},
+		{"device participant", func(r *pb.SetMessagePinRequest) { r.Key.Participant = "1234567890:5@s.whatsapp.net" }},
+		{"missing incoming participant", func(r *pb.SetMessagePinRequest) { r.Key.Participant = "" }},
+		{"missing outgoing participant", func(r *pb.SetMessagePinRequest) { r.Key.FromMe = true; r.Key.Participant = "" }},
+		{"duration unspecified", func(r *pb.SetMessagePinRequest) { r.Duration = pb.ABPinDuration_AB_PIN_DURATION_UNSPECIFIED }},
+		{"duration unknown", func(r *pb.SetMessagePinRequest) { r.Duration = pb.ABPinDuration(86401) }},
+		{"duration negative", func(r *pb.SetMessagePinRequest) { r.Duration = pb.ABPinDuration(-1) }},
+		{"unpin with duration", func(r *pb.SetMessagePinRequest) { r.Pinned = false }},
+		{"missing stable id", func(r *pb.SetMessagePinRequest) { r.IntentId = "" }},
+		{"missing timestamp", func(r *pb.SetMessagePinRequest) { r.TimestampMs = 0 }},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			request := proto.Clone(abPinRPCRequest()).(*pb.SetMessagePinRequest)
+			test.change(request)
+			resolves := 0
+			server := &Server{ABClientResolver: func(string) (gows.ABClient, error) { resolves++; return &abPinRPCFake{}, nil }}
+			response, err := server.SetMessagePin(context.Background(), request)
+			if status.Code(err) != codes.InvalidArgument || response != nil || resolves != 0 {
+				t.Fatalf("invalid request reached resolver: response=%v resolves=%d err=%v", response, resolves, err)
+			}
+		})
+	}
+	if response, err := (&Server{}).SetMessagePin(context.Background(), nil); response != nil || status.Code(err) != codes.InvalidArgument {
+		t.Fatalf("nil request not rejected: %v %v", response, err)
+	}
+}
+
+func TestABSetMessagePinRPCRejectsFractionalDuration(t *testing.T) {
+	var request pb.SetMessagePinRequest
+	if err := protojson.Unmarshal([]byte(`{"duration":86400.5}`), &request); err == nil {
+		t.Fatal("protobuf JSON accepted a fractional duration")
+	}
+}
+
+func TestABSetMessagePinRPCMissingSessionAndBackendFailure(t *testing.T) {
+	for _, outcome := range []struct {
+		name     string
+		resolver func(string) (gows.ABClient, error)
+		want     codes.Code
+	}{
+		{"unknown", func(string) (gows.ABClient, error) { return nil, nil }, codes.NotFound},
+		{"unavailable", func(string) (gows.ABClient, error) { return nil, gows.ErrABUnavailable }, codes.Unavailable},
+		{"source unavailable", func(string) (gows.ABClient, error) { return &abPinRPCFake{err: gows.ErrABFailedPrecondition}, nil }, codes.FailedPrecondition},
+	} {
+		t.Run(outcome.name, func(t *testing.T) {
+			response, err := (&Server{ABClientResolver: outcome.resolver}).SetMessagePin(context.Background(), abPinRPCRequest())
+			if response != nil || status.Code(err) != outcome.want {
+				t.Fatalf("unexpected failure mapping: %v %v", response, err)
+			}
+		})
+	}
+}
+
+func TestABSetMessagePinRPCUncertainDoesNotBecomeRetryableError(t *testing.T) {
+	request := abPinRPCRequest()
+	fake := &abPinRPCFake{result: gows.ABMutationResult{Outcome: gows.ABMutationUncertain, IntentID: request.IntentId}, err: errors.New("sensitive provider error after send")}
+	server := &Server{ABClientResolver: func(string) (gows.ABClient, error) { return fake, nil }}
+	response, err := server.SetMessagePin(context.Background(), request)
+	if err != nil || response.GetOutcome() != pb.ABMutationOutcome_AB_MUTATION_UNCERTAIN || response.GetIntentId() != request.IntentId || fake.calls != 1 {
+		t.Fatalf("uncertainty became failure or was retried: %v calls=%d err=%v", response, fake.calls, err)
+	}
+}
