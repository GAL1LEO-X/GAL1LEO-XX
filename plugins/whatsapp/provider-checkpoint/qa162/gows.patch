+
+func verifiedReceiptFixture(t *testing.T) (*GContainer, *SqlMessageStore, *storage.StoredMessage, storage.MessageKey) {
+	t.Helper()
+	db, s := mutationTestStore(t, filepath.Join(t.TempDir(), "instance.db"))
+	original := mutationOriginal(aliasPN.String(), "15550009999@s.whatsapp.net", true)
+	require.NoError(t, s.UpsertOneMessage(original))
+	_, err := db.db.Exec("INSERT INTO whatsmeow_lid_map(lid,pn) VALUES(?,?)", aliasLID.User, aliasPN.User)
+	require.NoError(t, err)
+	key, err := storage.MessageKeyFromInfo(original.Info)
+	require.NoError(t, err)
+	return db, s, original, key
+}
+
+func TestReceiptVerifiedMutationIsolationAndMonotonicity(t *testing.T) {
+	one, a, original, key := verifiedReceiptFixture(t)
+	two, b, _, otherKey := verifiedReceiptFixture(t)
+	_, err := two.db.Exec("UPDATE whatsmeow_lid_map SET pn=?", "15550002222")
+	require.NoError(t, err)
+	require.NoError(t, a.UpsertOneMessage(mutationEvent(original, "edited", 400000, false)))
+	before, err := a.GetMessage(key.ID)
+	require.NoError(t, err)
+	require.Equal(t, storage.ReceiptApplied, a.AdvanceReceiptAlias(context.Background(), key, aliasLID, false, storage.StatusRead))
+	require.Equal(t, storage.ReceiptMapping, b.AdvanceReceiptAlias(context.Background(), otherKey, aliasLID, false, storage.StatusPlayed))
+	got := requireCachedText(t, a, "edited")
+	require.Equal(t, before.Info, got.Info)
+	require.Equal(t, storage.StatusRead, *got.Status)
+	require.Equal(t, storage.ReceiptCurrent, a.AdvanceReceiptAlias(context.Background(), key, aliasLID, false, storage.StatusDeliveryAck))
+	require.Equal(t, storage.ReceiptApplied, a.AdvanceReceiptAlias(context.Background(), key, aliasLID, false, storage.StatusPlayed))
+	require.Equal(t, storage.ReceiptCurrent, a.AdvanceReceiptAlias(context.Background(), key, aliasLID, false, storage.StatusRead))
+	untouched, err := b.GetMessage(key.ID)
+	require.NoError(t, err)
+	require.Equal(t, storage.StatusServerAck, *untouched.Status)
+	require.NoError(t, a.UpsertOneMessage(mutationEvent(original, "", 500000, true)))
+	require.Equal(t, storage.ReceiptSourceUnavailable, a.AdvanceReceiptAlias(context.Background(), key, aliasLID, false, storage.StatusRead))
+	require.NoError(t, a.UpsertOneMessage(original))
+	_, err = a.GetMessage(key.ID)
+	require.ErrorIs(t, err, storage.ErrNotFound)
+	var n int
+	require.NoError(t, one.db.Get(&n, "SELECT count(*) FROM gows_message_mutations WHERE kind='revoke'"))
+	require.Equal(t, 1, n)
+}
+
+type receiptWriteMapper struct {
+	Mapper[storage.StoredMessage]
+	beforeWrite func()
+}
+
+func (m receiptWriteMapper) Marshal(value *storage.StoredMessage) ([]byte, error) {
+	m.beforeWrite()
+	return m.Mapper.Marshal(value)
+}
+
+func TestReceiptVerifiedMappingCannotChangeBetweenReadAndWrite(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "atomic.db")
+	db, s := mutationTestStore(t, path)
+	original := mutationOriginal(aliasPN.String(), "15550009999@s.whatsapp.net", true)
+	require.NoError(t, s.UpsertOneMessage(original))
+	_, err := db.db.Exec("INSERT INTO whatsmeow_lid_map(lid,pn) VALUES(?,?)", aliasLID.User, aliasPN.User)
+	require.NoError(t, err)
+	key, err := storage.MessageKeyFromInfo(original.Info)
+	require.NoError(t, err)
+	writer, err := sql.Open("sqlite3", path+"?_busy_timeout=0")
+	require.NoError(t, err)
+	defer writer.Close()
+	called := false
+	s.mapper = receiptWriteMapper{s.mapper, func() {
+		called = true
+		_, writeErr := writer.Exec("UPDATE whatsmeow_lid_map SET pn=?", "15550002222")
+		require.ErrorContains(t, writeErr, "locked", "mapping mutation must not interleave")
+	}}
+	require.Equal(t, storage.ReceiptApplied, s.AdvanceReceiptAlias(context.Background(), key, aliasLID, false, storage.StatusRead))
+	require.True(t, called)
+	_, err = writer.Exec("UPDATE whatsmeow_lid_map SET pn=?", "15550002222")
+	require.NoError(t, err)
+	require.Equal(t, storage.ReceiptMapping, s.AdvanceReceiptAlias(context.Background(), key, aliasLID, false, storage.StatusPlayed))
+	got, err := s.GetMessage(key.ID)
+	require.NoError(t, err)
+	require.Equal(t, storage.StatusRead, *got.Status)
+}
+
+func TestReceiptVerifiedNegativeIdentityAndMappings(t *testing.T) {
+	for _, name := range []string{"missing", "other-pn", "other-lid", "duplicate", "conflict", "limit", "sql-error", "wrong-chat", "wrong-id", "incoming", "self", "participant", "invalid-status", "group", "broadcast", "newsletter", "psa", "bot", "integrator", "key-replaced"} {
+		t.Run(name, func(t *testing.T) {
+			db, s, original, key := verifiedReceiptFixture(t)
+			chat, fromMe, status := aliasLID, false, storage.StatusRead
+			expected := storage.ReceiptInvalid
+			switch name {
+			case "missing":
+				_, err := db.db.Exec("DELETE FROM whatsmeow_lid_map")
+				require.NoError(t, err)
+				expected = storage.ReceiptMapping
+			case "other-pn":
+				_, err := db.db.Exec("UPDATE whatsmeow_lid_map SET pn='15550002222'")
+				require.NoError(t, err)
+				expected = storage.ReceiptMapping
+			case "other-lid":
+				_, err := db.db.Exec("UPDATE whatsmeow_lid_map SET lid='654321'")
+				require.NoError(t, err)
+				expected = storage.ReceiptMapping
+			case "duplicate", "conflict", "limit":
+				// Deliberately corrupt synthetic mapping schema to test fail-closed reads.
+				_, err := db.db.Exec("DROP TABLE whatsmeow_lid_map; CREATE TABLE whatsmeow_lid_map(lid TEXT,pn TEXT)")
+				require.NoError(t, err)
+				pairs := [][2]string{{aliasLID.User, aliasPN.User}, {aliasLID.User, aliasPN.User}}
+				if name != "duplicate" {
+					pairs[1][1] = "15550002222"
+				}
+				if name == "limit" {
+					pairs = append(pairs, [2]string{aliasLID.User, "15550003333"})
+				}
+				for _, pair := range pairs {
+					_, err = db.db.Exec("INSERT INTO whatsmeow_lid_map VALUES(?,?)", pair[0], pair[1])
+					require.NoError(t, err)
+				}
+				expected = storage.ReceiptMapping
+			case "sql-error":
+				_, err := db.db.Exec("DROP TABLE whatsmeow_lid_map")
+				require.NoError(t, err)
+				expected = storage.ReceiptStoreError
+			case "wrong-chat":
+				key.Chat = "15550002222@s.whatsapp.net"
+			case "wrong-id":
+				key.ID = "different-id"
+				expected = storage.ReceiptSourceUnavailable
+			case "incoming":
+				key.FromMe = false
+			case "self":
+				fromMe = true
+			case "participant":
+				key.Participant = "15550002222@s.whatsapp.net"
+			case "invalid-status":
+				status = storage.Status(99)
+			case "group":
+				chat.Server = types.GroupServer
+			case "broadcast":
+				chat.Server = types.BroadcastServer
+			case "newsletter":
+				chat.Server = types.NewsletterServer
+			case "psa":
+				chat = types.PSAJID
+			case "bot":
+				chat = types.NewJID("13135550002", types.DefaultUserServer)
+			case "integrator":
+				chat.Integrator = 2
+			case "key-replaced":
+				require.NoError(t, s.DeleteMessage(key.ID))
+				replacement := mutationOriginal("15550002222@s.whatsapp.net", "15550009999@s.whatsapp.net", true)
+				require.NoError(t, s.UpsertOneMessage(replacement))
+			}
+			before, err := s.GetMessage(original.Info.ID)
+			require.NoError(t, err)
+			require.Equal(t, expected, s.AdvanceReceiptAlias(context.Background(), key, chat, fromMe, status))
+			after, err := s.GetMessage(original.Info.ID)
+			require.NoError(t, err)
+			require.Equal(t, before, after, "rejected receipt must change nothing")
+		})
+	}
+}
+
+func TestReceiptVerifiedBudgetGateAndBusySettingRestored(t *testing.T) {
+	db, s, _, key := verifiedReceiptFixture(t)
+	db.db.SetMaxOpenConns(2)
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	require.Equal(t, storage.ReceiptStoreBusy, s.AdvanceReceiptAlias(ctx, key, aliasLID, false, storage.StatusRead))
+	s.receiptUpdateGate <- struct{}{}
+	require.Equal(t, storage.ReceiptStoreBusy, s.AdvanceReceiptAlias(context.Background(), key, aliasLID, false, storage.StatusRead))
+	<-s.receiptUpdateGate
+	tx, err := db.db.Beginx()
+	require.NoError(t, err)
+	_, err = tx.Exec("UPDATE gows_message_mutation_lock SET id=id WHERE id=1")
+	require.NoError(t, err)
+	started := time.Now()
+	require.Equal(t, storage.ReceiptStoreError, s.AdvanceReceiptAlias(context.Background(), key, aliasLID, false, storage.StatusRead))
+	require.Less(t, time.Since(started), 300*time.Millisecond, "must not inherit the DSN's 10 second lock wait")
+	require.NoError(t, tx.Rollback())
+	db.db.SetMaxOpenConns(1)
+	var busy int
+	require.NoError(t, db.db.Get(&busy, "PRAGMA busy_timeout"))
+	require.Equal(t, 10000, busy)
+	require.Equal(t, storage.ReceiptApplied, s.AdvanceReceiptAlias(context.Background(), key, aliasLID, false, storage.StatusRead))
+	require.NoError(t, db.db.Get(&busy, "PRAGMA busy_timeout"))
+	require.Equal(t, 10000, busy)
+}
+
+func TestReceiptVerifiedConcurrentRevocationAndEdit(t *testing.T) {
+	for _, revoke := range []bool{false, true} {
+		t.Run(map[bool]string{false: "edit", true: "revoke"}[revoke], func(t *testing.T) {
+			_, s, original, key := verifiedReceiptFixture(t)
+			var wg sync.WaitGroup
+			wg.Add(2)
+			start := make(chan struct{})
+			var update storage.ReceiptUpdateResult
+			var mutationErr error
+			go func() {
+				defer wg.Done()
+				<-start
+				update = s.AdvanceReceiptAlias(context.Background(), key, aliasLID, false, storage.StatusRead)
+			}()
+			go func() {
+				defer wg.Done()
+				<-start
+				mutationErr = s.UpsertOneMessage(mutationEvent(original, "edited", 400000, revoke))
+			}()
+			close(start)
+			wg.Wait()
+			require.NoError(t, mutationErr)
+			require.Contains(t, []storage.ReceiptUpdateResult{storage.ReceiptApplied, storage.ReceiptStoreError, storage.ReceiptSourceUnavailable}, update)
+			if revoke {
+				_, err := s.GetMessage(key.ID)
+				require.ErrorIs(t, err, storage.ErrNotFound)
+			} else {
+				got := requireCachedText(t, s, "edited")
+				if update == storage.ReceiptApplied {
