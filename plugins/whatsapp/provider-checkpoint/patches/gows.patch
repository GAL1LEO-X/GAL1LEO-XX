+)
+
+type abContactFake struct {
+	label   string
+	mu      sync.Mutex
+	blocked []bool
+	calls   int
+}
+
+func (f *abContactFake) GetContactAbout(_ context.Context, jid types.JID) (*string, error) {
+	if jid.User == "4" {
+		return nil, context.DeadlineExceeded
+	}
+	if jid.User == "3" {
+		return nil, nil
+	}
+	value := f.label
+	if jid.User == "2" {
+		value = ""
+	}
+	return &value, nil
+}
+func (f *abContactFake) SetContactBlocked(_ context.Context, jid types.JID, blocked bool, intent gows.ABIntent) (gows.ABMutationResult, error) {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	f.calls++
+	f.blocked = append(f.blocked, blocked)
+	if jid.User == "5" {
+		return gows.ABMutationResult{Outcome: gows.ABMutationUncertain, IntentID: intent.ID}, context.DeadlineExceeded
+	}
+	return gows.ABMutationResult{Outcome: gows.ABMutationAccepted, IntentID: intent.ID}, nil
+}
