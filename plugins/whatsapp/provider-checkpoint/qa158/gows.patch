+package storage
+
+import (
+	"testing"
+
+	"go.mau.fi/whatsmeow/types"
+)
+
+func TestReceiptAliasPairCompatibility(t *testing.T) {
+	pn, lid := types.NewJID("15550001111", types.DefaultUserServer), types.NewJID("123456", types.HiddenUserServer)
+	ad := pn
+	ad.Device, ad.RawAgent = 7, 1
+	integrator := pn
+	integrator.Integrator = 1
+	for _, tc := range []struct {
+		name  string
+		a, b  types.JID
+		valid bool
+	}{
+		{"pn-lid", pn, lid, true}, {"lid-pn", lid, pn, true}, {"device", ad, lid, true},
+		{"pn-pn", pn, pn, false}, {"lid-lid", lid, lid, false}, {"empty", types.JID{}, lid, false},
+		{"empty-user", types.NewJID("", types.DefaultUserServer), lid, false},
+		{"legacy", types.NewJID(pn.User, types.LegacyUserServer), lid, false},
+		{"psa", types.PSAJID, lid, false}, {"legacy-psa", types.LegacyPSAJID, lid, false},
+		{"integrator", integrator, lid, false}, {"group", types.NewJID("1234", types.GroupServer), lid, false},
+		{"broadcast", types.StatusBroadcastJID, lid, false}, {"newsletter", types.NewJID("1234", types.NewsletterServer), lid, false},
+		{"malformed", types.NewJID("1234' OR 1=1", types.DefaultUserServer), lid, false},
+		{"long", types.NewJID("123456789012345678901234567", types.DefaultUserServer), lid, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			p, l, ok := ReceiptAliasPair(tc.a, tc.b)
+			if ok != tc.valid || ok && (p != pn || l != lid) {
+				t.Fatal("unexpected compatibility")
+			}
+		})
+	}
+}
+
+func TestReceiptAliasSnapshotClassifiesFiniteEvidence(t *testing.T) {
+	pn, lid := types.NewJID("15550001111", types.DefaultUserServer), types.NewJID("123456", types.HiddenUserServer)
+	row := func(l, p string) LidmapEntry {
+		return LidmapEntry{Lid: types.NewJID(l, types.HiddenUserServer), Pn: types.NewJID(p, types.DefaultUserServer)}
+	}
+	exact := row(lid.User, pn.User)
+	for _, tc := range []struct {
+		name string
+		rows []LidmapEntry
+		want ReceiptAliasRelation
+	}{
+		{"missing", nil, AliasMissing}, {"pair", []LidmapEntry{exact}, AliasPair},
+		{"lid-elsewhere", []LidmapEntry{row(lid.User, "15550002222")}, AliasElsewhere},
+		{"pn-elsewhere", []LidmapEntry{row("654321", pn.User)}, AliasElsewhere},
+		{"both-elsewhere", []LidmapEntry{row(lid.User, "15550002222"), row("654321", pn.User)}, AliasElsewhere},
+		{"lid-conflict", []LidmapEntry{exact, row(lid.User, "15550002222")}, AliasConflict},
+		{"pn-conflict", []LidmapEntry{exact, row("654321", pn.User)}, AliasConflict},
+		{"duplicate", []LidmapEntry{exact, exact}, AliasConflict},
+		{"limit", []LidmapEntry{exact, exact, exact}, AliasConflict},
+		{"irrelevant", []LidmapEntry{row("654321", "15550002222")}, AliasReadError},
+		{"malformed-row", []LidmapEntry{row(lid.User, "bad-private-data")}, AliasConflict},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			if got := ClassifyReceiptAliasSnapshot(pn, lid, tc.rows); got != tc.want {
+				t.Fatalf("got %s want %s", got, tc.want)
+			}
+		})
+	}
+	if ReceiptAliasRelation("private-error").Safe() != AliasReadError {
+		t.Fatal("unbounded diagnostic value")
+	}
+}
