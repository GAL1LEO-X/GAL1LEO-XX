new file mode 100644
index 0000000000000000000000000000000000000000..8c7e5e1a72bd6e43669fd461002510083ea96027
--- /dev/null
+++ b/src/storage/receipt_alias.go
@@ -0,0 +1,94 @@
+package storage
+
+import (
+	"context"
+	"time"
+
+	"go.mau.fi/whatsmeow/types"
+)
+
+// ReceiptAliasBudget bounds added diagnostic waiting, not WhatsApp transport.
+const ReceiptAliasBudget = 50 * time.Millisecond
+
+type ReceiptAliasRelation string
+
+const (
+	AliasNotApplicable ReceiptAliasRelation = "not_applicable"
+	AliasUnavailable   ReceiptAliasRelation = "mapping_unavailable"
+	AliasMissing       ReceiptAliasRelation = "mapping_missing"
+	AliasPair          ReceiptAliasRelation = "pair_in_local_snapshot"
+	AliasElsewhere     ReceiptAliasRelation = "mapped_elsewhere"
+	AliasConflict      ReceiptAliasRelation = "mapping_conflict"
+	AliasReadError     ReceiptAliasRelation = "mapping_read_error"
+)
+
+// ReceiptAliasObserver is optional. It must not resolve identities over the
+// network, update LID caches, retry reads, or return private data to the logger.
+type ReceiptAliasObserver interface {
+	ObserveReceiptAlias(context.Context, types.JID, types.JID) ReceiptAliasRelation
+}
+
+func (r ReceiptAliasRelation) Safe() ReceiptAliasRelation {
+	switch r {
+	case AliasNotApplicable, AliasUnavailable, AliasMissing, AliasPair, AliasElsewhere, AliasConflict, AliasReadError:
+		return r
+	default:
+		return AliasReadError
+	}
+}
+
+func receiptAliasUser(user string) bool {
+	if len(user) == 0 || len(user) > 25 || user[0] == '0' {
+		return false
+	}
+	for _, c := range user {
+		if c < '0' || c > '9' {
+			return false
+		}
+	}
+	return true
+}
+
+// ReceiptAliasPair accepts only native personal PN/LID pairs. ToNonAD removes
+// agent/device suffixes, but is never itself evidence of PN/LID equivalence.
+func ReceiptAliasPair(a, b types.JID) (pn, lid types.JID, ok bool) {
+	a, b = a.ToNonAD(), b.ToNonAD()
+	if a.Integrator != 0 || b.Integrator != 0 || !receiptAliasUser(a.User) || !receiptAliasUser(b.User) || a.IsBot() || b.IsBot() {
+		return pn, lid, false
+	}
+	if a.Server == types.DefaultUserServer && b.Server == types.HiddenUserServer {
+		return a, b, true
+	}
+	if b.Server == types.DefaultUserServer && a.Server == types.HiddenUserServer {
+		return b, a, true
+	}
+	return pn, lid, false
+}
+
+// ClassifyReceiptAliasSnapshot uses one bounded snapshot. A pair in this map
+// does not authorize receipt acceptance or prove an identity outside the map.
+func ClassifyReceiptAliasSnapshot(pn, lid types.JID, rows []LidmapEntry) ReceiptAliasRelation {
+	if len(rows) >= 3 {
+		return AliasConflict
+	}
+	if len(rows) == 0 {
+		return AliasMissing
+	}
+	seenPN, seenLID := make(map[types.JID]bool), make(map[types.JID]bool)
+	exact := false
+	for _, row := range rows {
+		p, l, valid := ReceiptAliasPair(row.Pn, row.Lid)
+		if !valid || p != row.Pn || l != row.Lid || seenPN[p] || seenLID[l] {
+			return AliasConflict
+		}
+		if p != pn && l != lid {
+			return AliasReadError // Unexpected query result; no identity conclusion.
+		}
+		seenPN[p], seenLID[l] = true, true
+		exact = exact || p == pn && l == lid
+	}
+	if exact {
+		return AliasPair
+	}
+	return AliasElsewhere
+}
