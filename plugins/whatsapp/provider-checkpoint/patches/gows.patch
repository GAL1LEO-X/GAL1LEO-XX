@@ -0,0 +1,490 @@
+package gows
+
+import (
+	"context"
+	"errors"
+	"reflect"
+	"testing"
+	"time"
+
+	"github.com/devlikeapro/gows/storage"
+	"go.mau.fi/whatsmeow"
+	"go.mau.fi/whatsmeow/proto/waE2E"
+	"go.mau.fi/whatsmeow/proto/waWeb"
+	waStore "go.mau.fi/whatsmeow/store"
+	"go.mau.fi/whatsmeow/types"
+	"go.mau.fi/whatsmeow/types/events"
+	"google.golang.org/protobuf/proto"
+	"google.golang.org/protobuf/reflect/protoreflect"
+)
+
+var abPinTestNow = time.UnixMilli(1800000000000)
+
+func abPinTestKey() ABMessageKey {
+	return ABMessageKey{Chat: types.NewJID("120363000000001", types.GroupServer), ID: "SOURCE", FromMe: false, Participant: types.NewJID("1234567890", types.DefaultUserServer)}
+}
+
+func abPinTestIntent() ABIntent {
+	return ABIntent{ID: "STABLE_CONTROL_1", TimestampMS: abPinTestNow.UnixMilli()}
+}
+
+func abPinTestSource(key ABMessageKey) *storage.StoredMessage {
+	return &storage.StoredMessage{Message: &events.Message{
+		Info:    types.MessageInfo{MessageSource: types.MessageSource{Chat: key.Chat, Sender: key.Participant, IsFromMe: key.FromMe, IsGroup: key.Chat.Server == types.GroupServer}, ID: key.ID, Timestamp: abPinTestNow.Add(-time.Minute)},
+		Message: &waE2E.Message{Conversation: proto.String("original remains untouched")},
+	}, IsReal: true}
+}
+
+type abPinFakeStore struct {
+	message *storage.StoredMessage
+	err     error
+	ids     []string
+}
+
+func (s *abPinFakeStore) GetMessage(id types.MessageID) (*storage.StoredMessage, error) {
+	s.ids = append(s.ids, id)
+	return s.message, s.err
+}
+
+type abPinFakeSender struct {
+	calls   int
+	to      types.JID
+	message *waE2E.Message
+	extra   whatsmeow.SendRequestExtra
+	err     error
+}
+
+func (s *abPinFakeSender) SendMessage(_ context.Context, to types.JID, message *waE2E.Message, extra whatsmeow.SendRequestExtra) (*events.Message, error) {
+	s.calls++
+	s.to, s.message, s.extra = to, message, extra
+	return &events.Message{}, s.err
+}
