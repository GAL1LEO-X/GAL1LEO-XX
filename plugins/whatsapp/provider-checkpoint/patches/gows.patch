index 0000000000000000000000000000000000000000..f3fcd12b1887707ca1ab8417ab1f6b6b67ce7c36
--- /dev/null
+++ b/docs/ab-checkpoint-contract.md
@@ -0,0 +1,105 @@
+# Private A/B checkpoint contract
+
+The immutable starting point is GOWS `v1.0.49`, commit
+`5f093fe7c38c41faead8e6ce78ee70cb7f815404`. The exact Whatsmeow replacement
+remains `github.com/devlikeapro/whatsmeow` at
+`v0.0.0-20261015073558-1114c41c7a3c`; no dependency reference is advanced.
+
+`proto/gows.proto`, package `messages`, service `MessageService`, adds:
+
+| RPC | Request | Result |
+| --- | --- | --- |
+| `GetABContract` | `Empty` | `ABContractResponse` |
+| `GetContactAbout` | `JidRequest` | `ContactAboutResponse` |
+| `SetContactBlocked` | `SetContactBlockedRequest` | `ABMutationResponse` |
+| `SetChatArchived` | `SetChatArchivedRequest` | `ABMutationResponse` |
+| `GetChatArchiveState` | `JidRequest` | `ABChatArchiveState` |
+| `SetMessageStar` | `SetMessageStarRequest` | `ABMutationResponse` |
+| `SetMessagePin` | `SetMessagePinRequest` | `ABMutationResponse` |
+
+The five operation families cover the eight existing About, block/unblock,
+archive/unarchive, star, and message-pin/unpin operations. The archive read RPC
+exposes cache observation; it is not another public plugin operation. No raw
+protobuf send or arbitrary app-state mutation RPC is added.
+
+Each request includes an explicit `Session`. The production resolver obtains
+only that session through `Sm.Get`. `Server.ABClientResolver` is an optional
+narrow dependency injection seam; the default behavior is unchanged. It is not
+an authorization mechanism: the existing trusted gRPC boundary and upstream
+owner/scope/session checks still apply.
+
+Contact targets must be canonical PN (`digits@s.whatsapp.net`) or LID
+(`digits@lid`) JIDs. Group, newsletter, broadcast, unknown-domain and device
+JIDs are rejected before session resolution. Contact membership in a local
+address book is not required. Chat targets additionally permit group JIDs.
+
+Every mutation requires `intent_id` (1–128 ASCII letters, digits, underscore or
+hyphen) and a positive `timestamp_ms`. The caller freezes both values. A complete
+message key consists of chat, id, from_me and participant where applicable;
+all group messages require a participant, including outgoing messages. A present incoming direct-message
+participant must equal its chat; unverified PN/LID aliases are not guessed.
+
+Pin accepts only the duration enum values 86400, 604800 or 2592000 seconds.
+Unpin requires duration zero. The adapter must validate a duration before any
+numeric narrowing or enum conversion. Archive accepts at most one explicit
+message-range anchor, with its timestamp no later than the intent timestamp.
+
+`AB_MUTATION_ACCEPTED` means the provider returned its expected acceptance
+response. It does not mean delivery, synchronization on a phone, or a verified
+final state. `AB_MUTATION_UNCERTAIN` means an invocation may have reached
+WhatsApp but the result was not established. It preserves the intent ID and
+suppresses private response details. No new retry loop is added. A timeout of
+the gRPC transport itself can prevent delivery of the uncertain result; callers
+must also treat such mutation transport errors as uncertain and must not retry
+blindly. Stable IDs support reconciliation but this checkpoint does not claim a
+durable deduplication ledger or exactly-once execution.
+
+Pre-dispatch argument/precondition/session failures return gRPC errors.
+Library failures after the blocklist/app-state/send invocation are classified
+conservatively as uncertain because those library APIs do not expose a
+reliable sent/not-sent boundary. The shared response helper never turns an
+uncertain result into a retryable gRPC error.
+
+About uses a dedicated status-only USync query with `IncludePrivacyToken=true`,
+preserving the pinned library's privacy-token behavior. An existing mapping
+from the same session converts LID to PN when available; otherwise direct LID
+is attempted without claiming that its live semantics are verified. A present
+empty status node becomes an explicitly present `OptionalString{value:""}`;
+an absent user/status becomes absent `about` (JSON null in WAHA), without
+assigning a cause. Synthetic fixtures with 401/403 status codes map to unavailable; unknown
+status errors, malformed content and transport errors remain errors. Business,
+picture, device and token fields are neither requested by this helper nor
+returned. The exact live response shapes, privacy cases and direct LID behavior
+remain part of later phone qualification.
+
+Block/unblock use the real pinned `UpdateBlocklist` method with an empty dhash
+to request an explicit response. Existing session PN/LID resolution remains in
+the library. The updated blocklist is discarded; only outcome and intent ID
+are returned. A nil or malformed response is uncertain.
+
+Archive observation is a snapshot of the local Whatsmeow chat-settings cache.
+`known` means a cache row exists, including rows that another chat setting may
+have created. It does not prove that an archive-specific event was observed.
+`phone_fresh` remains false. No synthetic cache success is written after a
+mutation.
+
+Offline coverage includes pure payload/parser tests, fake backend calls and
+real protobuf round trips over gRPC `bufconn`. The
+`cmd/ab-offline-fixture` command also serves the real protobuf handlers on an
+ephemeral `127.0.0.1` TCP port, with an `ABClient` fake. It constructs no session
+manager, WhatsApp client or database and exits on SIGTERM/SIGINT. Its initial
+stdout JSON contains `address`. Sessions `fixture-a` and `fixture-b` are valid;
+About targets 1/2/3/4 return value/empty/null/error, and mutation target 5 returns
+uncertain. This fixture is for the cross-language offline checkpoint only.
+
+No WhatsApp session, phone verification, history synchronization, production
+deployment, public release or new remote fork is part of this checkpoint.
+The private candidate's compatibility gate can recognize the implemented
+contract; this does not declare live qualification. PR58 and the qualified
+baseline remain unchanged.
+
+`GetABContract` is a static compatibility probe returning version `gows-ab-v1`
+and the eight existing operation names. It does not resolve a session, start
+a client or open a database. A prior provider lacking this RPC cannot satisfy
+the compatibility gate. This probe attests implementation compatibility; it
+does not claim live phone qualification or replace owner/scope checks.
diff --git a/docs/d01-message-cache-contract.md b/docs/d01-message-cache-contract.md
new file mode 100644
index 0000000000000000000000000000000000000000..7ec3d8f6ec8f5e5c4b985d31c9aa8d2a7c520977
--- /dev/null
+++ b/docs/d01-message-cache-contract.md
@@ -0,0 +1,72 @@
+# D01 persistent message mutation projection
+
+The cache applies protocol edits to the original message instead of storing only
+an edit envelope. It retains mutations in migration 009's additive
+`gows_message_mutations` table, keyed by chat, original ID, local direction and
+group participant. The existing short-ID lookup RPC and original table remain
+compatible. A conflicting full identity is explicitly refused; this change does
+not claim that the legacy schema supports two originals with the same short ID.
+
+Whatsmeow's wire `key.fromMe` is relative to the event sender. The provider
+resolves it using the authenticated event source and the local device identities
+before persisting a mutation. An incoming DM's wire remote JID can identify the
+local recipient, so the event envelope supplies the local chat. Group mutations
+require a resolved participant. PN/LID identities are not guessed equivalent.
+Unknown or conflicting identities fail closed. For own group messages only, the
+session's attested `Store.ID` and `Store.LID` are accepted and the original
+participant namespace is preserved through edit/revoke preparation and storage.
+The revoke builder checks complete JIDs, not just their User component; a foreign
+PN/LID sharing an own numeric User remains an explicit admin-revoke target and
+cannot be rewritten into an own-message target.
+For a verified own-message revocation, the session's PN and LID tombstones are
+saved together in the existing ledger. This also covers incoming admin revokes
+before the original arrives in the other own namespace or after a restart.
+The authenticated event sender is unchanged; foreign aliases are never inferred.
+
+Edits are ordered by their protocol timestamp, with the event timestamp as a
+fallback. Older events cannot replace newer content. Identical replays are
+idempotent; two distinct edits at the same timestamp hide the cached original
+until a later unambiguous edit and original/history record arrive. Revocation is
+terminal and survives restarts, late edits and history. Tombstones are retained
+independently of message retention; they are not pruned automatically.
+If another full identity occupies the legacy short-ID row, its content is left
+untouched while the valid mutation is still saved under its own full key. The
+returned projection-conflict error explicitly reports that the ledger persisted.
+
+Pending edits do not invent an original creation timestamp. A history snapshot
+may supply an original only if its own web-message key matches the target and
+contains a creation timestamp. Normal history protocol envelopes remain pending.
+The pinned whatsmeow history parser unwraps an edit into `Message`; the provider
+also checks its retained `RawMessage` for the mutation key and event timestamp.
+
+Applying an edit updates visible content, raw content and retained web-message
+content while preserving the original timestamp, monotonic delivery status and
+restrictive source metadata. View-once and ephemeral restrictions cannot be
+cleared by edits or stale history. Media caption payloads are applied as deltas:
+only the caption changes; original hashes, MIME, size, keys, download references,
+filenames and other attachment metadata remain intact. A key-only placeholder
+does not count as a media base; its edit remains pending until content arrives.
+An outgoing edit/revoke updates storage before
+the RPC succeeds; a cache failure after sending explicitly reports that the send
+already happened and must not be blindly repeated. Edit requests require an
+available, matching own-message original in the cache.
+
+The mutation/original transaction takes a database row lock before reading. This
+serializes cache writes across history workers and store instances and prevents
+last-write races. SQLite tests use the real driver and file-backed databases.
+The SQL is shared with PostgreSQL, but the offline test evidence does not certify
+a PostgreSQL deployment or live WhatsApp behavior.
+
+## Migration and rollback
+
+Migration 009 creates two new tables and an index without rewriting the original
+table or changing protobuf RPCs. Existing originals remain readable. Legacy
+cached content cannot reveal edits that were never received or persisted; a new
+event or history snapshot is required to reconcile it.
+
+Before a production migration, stop all writers and back up the entire session
+database. For a rollback that preserves the prior program's behavior, stop all
+writers and restore that backup with the prior binary. Merely running an old
+binary against the upgraded database leaves it unaware of tombstones and
+therefore does not preserve the new non-resurrection guarantee. No migration,
+rollback, server access or live verification has been performed by this task.
diff --git a/proto/gows.proto b/proto/gows.proto
index b87524e0a3cf5c38e86f5348bb1f4df10f74aecd..0d82d5b30ee82ba2a158c20476391c84ad92716c 100644
--- a/proto/gows.proto
+++ b/proto/gows.proto
@@ -174,6 +174,14 @@ service MessageService {
   rpc UpdateContact(UpdateContactRequest) returns (Empty);
   rpc GetContacts(GetContactsRequest) returns (JsonList);
   rpc GetContactById(EntityByIdRequest) returns (Json);
+  // Private A/B checkpoint: typed operations, no arbitrary protobuf or app-state RPC.
+  rpc GetABContract(Empty) returns (ABContractResponse);
+  rpc GetContactAbout(JidRequest) returns (ContactAboutResponse);
+  rpc SetContactBlocked(SetContactBlockedRequest) returns (ABMutationResponse);
+  rpc SetChatArchived(SetChatArchivedRequest) returns (ABMutationResponse);
+  rpc GetChatArchiveState(JidRequest) returns (ABChatArchiveState);
+  rpc SetMessageStar(SetMessageStarRequest) returns (ABMutationResponse);
+  rpc SetMessagePin(SetMessagePinRequest) returns (ABMutationResponse);
 
   //
   // Events
@@ -761,6 +769,90 @@ message GetContactsRequest {
   Pagination pagination = 3;
 }
 
+// Presence of about distinguishes an empty status from an unavailable status.
+message ABContractResponse {
+  string version = 1;
+  repeated string operations = 2;
+}
+
+message ContactAboutResponse {
+  OptionalString about = 1;
+}
+
+enum ABMutationOutcome {
+  AB_MUTATION_OUTCOME_UNSPECIFIED = 0;
+  AB_MUTATION_ACCEPTED = 1;
+  AB_MUTATION_UNCERTAIN = 2;
+}
+
+message ABMutationResponse {
+  // ACCEPTED is provider acceptance, not delivery or phone-side confirmation.
+  ABMutationOutcome outcome = 1;
+  string intent_id = 2;
+}
+
+// The caller must preserve intent_id and timestamp_ms for reconciliation.
+// An uncertain outcome must never cause an automatic retry.
+message SetContactBlockedRequest {
+  Session session = 1;
+  string jid = 2;
+  bool blocked = 3;
+  string intent_id = 4;
+  int64 timestamp_ms = 5;
+}
+
+message ABMessageKey {
+  string chat = 1;
+  string id = 2;
+  bool from_me = 3;
+  string participant = 4;
+}
+
+message ABMessageRange {
+  ABMessageKey key = 1;
+  int64 timestamp_ms = 2;
+}
+
+message SetChatArchivedRequest {
+  Session session = 1;
+  string jid = 2;
+  bool archived = 3;
+  string intent_id = 4;
+  int64 timestamp_ms = 5;
+  repeated ABMessageRange messages = 6;
+}
+
+message ABChatArchiveState {
+  bool known = 1;
+  bool archived = 2;
+  string source = 3;
+  bool phone_fresh = 4;
+}
+
+message SetMessageStarRequest {
+  Session session = 1;
+  ABMessageKey key = 2;
+  bool starred = 3;
+  string intent_id = 4;
+  int64 timestamp_ms = 5;
+}
+
+enum ABPinDuration {
+  AB_PIN_DURATION_UNSPECIFIED = 0;
+  AB_PIN_DURATION_DAY = 86400;
+  AB_PIN_DURATION_WEEK = 604800;
+  AB_PIN_DURATION_MONTH = 2592000;
+}
+
+message SetMessagePinRequest {
+  Session session = 1;
+  ABMessageKey key = 2;
+  bool pinned = 3;
+  ABPinDuration duration = 4;
+  string intent_id = 5;
+  int64 timestamp_ms = 6;
+}
+
 //
 // Storage - Chats
 //
diff --git a/src/cmd/ab-offline-fixture/main.go b/src/cmd/ab-offline-fixture/main.go
new file mode 100644
index 0000000000000000000000000000000000000000..eabf44730a8f90682f2c71e42a9c48eb79907139
--- /dev/null
+++ b/src/cmd/ab-offline-fixture/main.go
@@ -0,0 +1,86 @@
+// ab-offline-fixture exposes the real protobuf handlers with a fake ABClient.
+// It never constructs a SessionManager, WhatsApp client, store or database.
+package main
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"net"
+	"os"
+	"os/signal"
+	"syscall"
+
+	"github.com/devlikeapro/gows/gows"
+	pb "github.com/devlikeapro/gows/proto"
+	"github.com/devlikeapro/gows/server"
+	"go.mau.fi/whatsmeow/types"
+	"google.golang.org/grpc"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/status"
+)
+
+type fixture struct{ session string }
+
+func (f fixture) GetContactAbout(_ context.Context, jid types.JID) (*string, error) {
+	if jid.User == "4" {
+		return nil, context.DeadlineExceeded
+	}
+	if jid.User == "3" {
+		return nil, nil
+	}
+	value := "fixture-about-✓"
+	if f.session == "fixture-b" {
+		value = "fixture-b-about"
+	}
+	if jid.User == "2" {
+		value = ""
+	}
+	return &value, nil
+}
+func result(jid types.JID, intent gows.ABIntent) (gows.ABMutationResult, error) {
+	if jid.User == "5" {
+		return gows.ABMutationResult{Outcome: gows.ABMutationUncertain, IntentID: intent.ID}, context.DeadlineExceeded
+	}
+	return gows.ABMutationResult{Outcome: gows.ABMutationAccepted, IntentID: intent.ID}, nil
+}
+func (f fixture) SetContactBlocked(_ context.Context, jid types.JID, _ bool, intent gows.ABIntent) (gows.ABMutationResult, error) {
+	return result(jid, intent)
+}
+func (f fixture) SetChatArchived(_ context.Context, jid types.JID, _ bool, intent gows.ABIntent, _ []gows.ABMessageRange) (gows.ABMutationResult, error) {
+	return result(jid, intent)
+}
+func (f fixture) ReadChatArchived(context.Context, types.JID) (gows.ABChatArchiveState, error) {
+	return gows.ABChatArchiveState{Known: true, Archived: false, Source: "offline_fixture", PhoneFresh: false}, nil
+}
+func (f fixture) SetMessageStar(_ context.Context, key gows.ABMessageKey, _ bool, intent gows.ABIntent) (gows.ABMutationResult, error) {
+	return result(key.Chat, intent)
+}
+func (f fixture) SetMessagePin(_ context.Context, key gows.ABMessageKey, _ bool, _ gows.ABPinDuration, intent gows.ABIntent) (gows.ABMutationResult, error) {
+	return result(key.Chat, intent)
+}
+
+func main() {
+	lis, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		fmt.Fprintln(os.Stderr, err)
+		os.Exit(1)
+	}
+	gs := grpc.NewServer()
+	pb.RegisterMessageServiceServer(gs, &server.Server{ABClientResolver: func(session string) (gows.ABClient, error) {
+		if session != "fixture-a" && session != "fixture-b" {
+			return nil, status.Error(codes.NotFound, "fixture session not found")
+		}
+		return fixture{session: session}, nil
+	}})
+	ctx, stop := signal.NotifyContext(context.Background(), syscall.SIGTERM, syscall.SIGINT)
+	defer stop()
+	go func() { <-ctx.Done(); gs.GracefulStop() }()
+	if err := json.NewEncoder(os.Stdout).Encode(map[string]string{"address": lis.Addr().String(), "mode": "offline-fake-backend"}); err != nil {
+		os.Exit(1)
+	}
+	if err := gs.Serve(lis); err != nil {
+		fmt.Fprintln(os.Stderr, err)
+		os.Exit(1)
+	}
+}
diff --git a/src/gows/ab_contacts.go b/src/gows/ab_contacts.go
new file mode 100644
index 0000000000000000000000000000000000000000..323e23c7dccd9244ee586157f3b7beb37536f01c
--- /dev/null
+++ b/src/gows/ab_contacts.go
@@ -0,0 +1,202 @@
+package gows
+
+import (
+	"context"
+	"fmt"
+	"unicode/utf8"
+
+	"go.mau.fi/whatsmeow"
+	waBinary "go.mau.fi/whatsmeow/binary"
+	"go.mau.fi/whatsmeow/types"
+	"go.mau.fi/whatsmeow/types/events"
+)
+
+type abUSyncFunc func(context.Context, []types.JID, string, string, []waBinary.Node, ...whatsmeow.UsyncQueryExtras) (*waBinary.Node, error)
+type abPNLookupFunc func(context.Context, types.JID) (types.JID, error)
+
+func (g *GoWS) GetContactAbout(ctx context.Context, jid types.JID) (*string, error) {
+	if err := ValidateABContactJID(jid); err != nil {
+		return nil, err
+	}
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	if g == nil || g.Client == nil || g.Store == nil || g.int == nil {
+		return nil, ErrABUnavailable
+	}
+	var lookup abPNLookupFunc
+	if g.Store.LIDs != nil {
+		lookup = func(ctx context.Context, lid types.JID) (types.JID, error) {
+			pn, err := g.Store.LIDs.GetPNForLID(ctx, lid)
+			if err == nil && !pn.IsEmpty() && !g.validLIDPNPair(lid, pn) {
+				return types.EmptyJID, fmt.Errorf("%w: inconsistent session PN mapping", ErrABFailedPrecondition)
+			}
+			return pn, err
+		}
+	}
+	return abGetContactAbout(ctx, jid, lookup, g.int.Usync)
+}
+
+func abGetContactAbout(ctx context.Context, jid types.JID, lookup abPNLookupFunc, usync abUSyncFunc) (*string, error) {
+	if err := ValidateABContactJID(jid); err != nil {
+		return nil, err
+	}
+	// Prefer an existing, session-owned PN mapping. With no mapping, direct LID
+	// remains a protocol path whose live semantics require later phone tests.
+	if jid.Server == types.HiddenUserServer && lookup != nil {
+		pn, err := lookup(ctx, jid)
+		if err != nil {
+			return nil, err
+		}
+		if !pn.IsEmpty() {
+			if err := ValidateABContactJID(pn); err != nil || pn.Server != types.DefaultUserServer {
+				return nil, fmt.Errorf("%w: invalid session PN mapping", ErrABFailedPrecondition)
+			}
+			jid = pn
+		}
+	}
+	list, err := usync(ctx, []types.JID{jid}, "full", "background", []waBinary.Node{{Tag: "status"}}, whatsmeow.UsyncQueryExtras{IncludePrivacyToken: true})
+	if err != nil {
+		return nil, err
+	}
+	return abParseContactAbout(list, jid)
+}
+
+// An absent user/status means unavailable, without assigning a privacy cause.
+// Explicit 401/403 status errors also mean unavailable. Unknown error codes and
+// malformed content remain errors. This parser never exposes private siblings.
+func abParseContactAbout(list *waBinary.Node, target types.JID) (*string, error) {
+	if list == nil || list.Tag != "list" {
+		return nil, fmt.Errorf("malformed About list")
+	}
+	if list.Content != nil {
+		if _, ok := list.Content.([]waBinary.Node); !ok {
+			return nil, fmt.Errorf("malformed About list content")
+		}
+	}
+	var user *waBinary.Node
+	children := list.GetChildren()
+	for i := range children {
+		child := &children[i]
+		if child.Tag != "user" {
+			continue
+		}
+		jid, ok := child.Attrs["jid"].(types.JID)
+		if !ok {
+			return nil, fmt.Errorf("malformed About user")
+		}
+		if jid.ToNonAD() != target {
+			continue
+		}
+		if user != nil {
+			return nil, fmt.Errorf("duplicate About user")
+		}
+		user = child
+	}
+	if user == nil {
+		return nil, nil
+	}
+	if user.Content != nil {
+		if _, ok := user.Content.([]waBinary.Node); !ok {
+			return nil, fmt.Errorf("malformed About user content")
+		}
+	}
+	var statusNode *waBinary.Node
+	statusChildren := user.GetChildren()
+	for i := range statusChildren {
+		if statusChildren[i].Tag == "error" {
+			switch fmt.Sprint(statusChildren[i].Attrs["code"]) {
+			case "401", "403":
+				return nil, nil
+			default:
+				return nil, fmt.Errorf("unrecognized About user error")
+			}
+		}
+		if statusChildren[i].Tag == "status" {
+			if statusNode != nil {
+				return nil, fmt.Errorf("duplicate About status")
+			}
+			statusNode = &statusChildren[i]
+		}
+	}
+	if statusNode == nil {
+		return nil, nil
+	}
+	if code, exists := statusNode.Attrs["code"]; exists {
+		switch fmt.Sprint(code) {
+		case "401", "403":
+			return nil, nil
+		default:
+			return nil, fmt.Errorf("unrecognized About status error")
+		}
+	}
+	if _, exists := statusNode.Attrs["error"]; exists {
+		return nil, fmt.Errorf("unrecognized About status error")
+	}
+	if statusNode.Attrs["type"] == "error" {
+		return nil, fmt.Errorf("unrecognized About status error")
+	}
+	var value string
+	switch content := statusNode.Content.(type) {
+	case nil:
+		value = ""
+	case []byte:
+		value = string(content)
+	case string:
+		value = content
+	default:
+		return nil, fmt.Errorf("malformed About status content")
+	}
+	if !utf8.ValidString(value) {
+		return nil, fmt.Errorf("malformed About status encoding")
+	}
+	return &value, nil
+}
+
+type abBlockUpdateFunc func(context.Context, types.JID, events.BlocklistChangeAction) (*types.Blocklist, error)
+
+func (g *GoWS) SetContactBlocked(ctx context.Context, jid types.JID, blocked bool, intent ABIntent) (ABMutationResult, error) {
+	if err := ValidateABContactJID(jid); err != nil {
+		return ABMutationResult{}, err
+	}
+	if err := ValidateABIntent(intent); err != nil {
+		return ABMutationResult{}, err
+	}
+	if err := ctx.Err(); err != nil {
+		return ABMutationResult{}, err
+	}
+	if g == nil || g.Client == nil || g.Store == nil || g.Store.LIDs == nil {
+		return ABMutationResult{}, ErrABUnavailable
+	}
+	return abSetContactBlocked(ctx, jid, blocked, intent, func(ctx context.Context, target types.JID, action events.BlocklistChangeAction) (*types.Blocklist, error) {
+		// Empty dhash requests an explicit updated list in this pinned fork.
+		return g.UpdateBlocklist(ctx, target, action, "")
+	})
+}
+
+func abSetContactBlocked(ctx context.Context, jid types.JID, blocked bool, intent ABIntent, update abBlockUpdateFunc) (ABMutationResult, error) {
+	if err := ValidateABContactJID(jid); err != nil {
+		return ABMutationResult{}, err
+	}
+	if err := ValidateABIntent(intent); err != nil {
+		return ABMutationResult{}, err
+	}
+	if err := ctx.Err(); err != nil {
+		return ABMutationResult{}, err
+	}
+	action := events.BlocklistChangeActionUnblock
+	if blocked {
+		action = events.BlocklistChangeActionBlock
+	}
+	result := ABMutationResult{IntentID: intent.ID}
+	// The library resolves PN/LID and sends the IQ. It does not expose a
+	// reliable sent/not-sent boundary, so all invocation failures are uncertain.
+	list, err := update(ctx, jid, action)
+	if err != nil || list == nil {
+		result.Outcome = ABMutationUncertain
+		return result, err
+	}
+	result.Outcome = ABMutationAccepted
+	// Do not expose the returned blocklist, dhash or unrelated contacts.
+	return result, nil
+}
