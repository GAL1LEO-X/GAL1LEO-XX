+package gows
+
+import (
+	"context"
+	"database/sql"
+	"fmt"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/devlikeapro/gows/storage"
+	"github.com/devlikeapro/gows/storage/sqlstorage"
+	_ "github.com/mattn/go-sqlite3"
+	"go.mau.fi/whatsmeow"
+	"go.mau.fi/whatsmeow/types"
+	"go.mau.fi/whatsmeow/types/events"
+	waLog "go.mau.fi/whatsmeow/util/log"
+)
+
+type receiptAliasSpy struct {
+	storage.LidmapStorage
+	relation        storage.ReceiptAliasRelation
+	calls           int
+	wait            bool
+	deadlineMissing bool
+}
+
+func TestReceiptAliasRealInstanceStoreWiring(t *testing.T) {
+	pn, lid := types.NewJID("15550001111", types.DefaultUserServer), types.NewJID("123456", types.HiddenUserServer)
+	for _, tc := range []struct {
+		name, pn string
+		want     storage.ReceiptAliasRelation
+	}{
+		{"one", pn.User, storage.AliasPair}, {"two", "15550002222", storage.AliasElsewhere},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			path := filepath.Join(t.TempDir(), "instance.db")
+			container, err := sqlstorage.New("sqlite3", path+"?_foreign_keys=on", waLog.Noop)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer container.Close()
+			writer, err := sql.Open("sqlite3", path)
+			if err != nil {
+				t.Fatal(err)
+			}
+			_, err = writer.Exec("INSERT INTO whatsmeow_lid_map(lid,pn) VALUES(?,?)", lid.User, tc.pn)
+			writer.Close()
+			if err != nil {
+				t.Fatal(err)
+			}
+			instance := BuildStorage(container, &GoWS{Client: &whatsmeow.Client{Log: waLog.Noop}}, StorageConfig{})
+			msg := receiptStored(pn, true, nil)
+			h, messages, log := receiptHandler(map[types.MessageID]*storage.StoredMessage{"same-message-key": msg})
+			instance.Messages = messages
+			h.storage = instance
+			h.handleReceipt(&events.Receipt{MessageSource: types.MessageSource{Chat: lid}, MessageIDs: []types.MessageID{"same-message-key"}, Type: types.ReceiptTypeRead})
+			if messages.writes != 0 || msg.Status != nil || len(log.diagnostic()) != 1 || !strings.HasSuffix(log.diagnostic()[0].text, "alias_relation="+string(tc.want)) {
+				t.Fatal("instance wiring or receipt guard changed")
+			}
+		})
+	}
+}
+
+func (s *receiptAliasSpy) ObserveReceiptAlias(ctx context.Context, pn, lid types.JID) storage.ReceiptAliasRelation {
+	s.calls++
+	if _, ok := ctx.Deadline(); !ok {
+		s.deadlineMissing = true
+	}
+	if s.wait {
+		<-ctx.Done()
+		return storage.AliasReadError
+	}
+	return s.relation
+}
+
+func TestReceiptAliasDiagnosticNeverAcceptsMismatch(t *testing.T) {
+	pn, lid := types.NewJID("15550001111", types.DefaultUserServer), types.NewJID("123456", types.HiddenUserServer)
+	for _, relation := range []storage.ReceiptAliasRelation{storage.AliasUnavailable, storage.AliasMissing, storage.AliasPair, storage.AliasElsewhere, storage.AliasConflict, storage.AliasReadError, "PRIVATE-RAW-ERROR"} {
+		for _, own := range []bool{false, true} {
+			for _, receiptOwn := range []bool{false, true} {
+				for _, step := range []struct {
+					kind types.ReceiptType
+					name string
+				}{{types.ReceiptTypeDelivered, "delivered"}, {types.ReceiptTypeRead, "read"}, {types.ReceiptTypePlayed, "played"}} {
+					t.Run(fmt.Sprintf("%s/%t/%t/%s", relation, own, receiptOwn, step.name), func(t *testing.T) {
+						msg := receiptStored(pn, own, nil)
+						h, s, log := receiptHandler(map[types.MessageID]*storage.StoredMessage{"PRIVATE-MESSAGE-ID": msg})
+						observer := &receiptAliasSpy{relation: relation}
+						h.storage.Lidmap = observer
+						h.handleReceipt(&events.Receipt{MessageSource: types.MessageSource{Chat: lid, IsFromMe: receiptOwn}, MessageIDs: []types.MessageID{"PRIVATE-MESSAGE-ID"}, Type: step.kind})
+						want := fmt.Sprintf("receipt.cache.skipped reason=chat_mismatch cached_chat_kind=pn receipt_chat_kind=lid cached_from_me=%t receipt_from_me=%t receipt_kind=%s alias_relation=%s", own, receiptOwn, step.name, relation.Safe())
+						d := log.diagnostic()
+						if s.writes != 0 || msg.Status != nil || observer.calls != 1 || observer.deadlineMissing || len(d) != 1 || d[0].level != "warn" || d[0].text != want {
+							t.Fatal("receipt guard/finite diagnostic changed")
+						}
+						for _, secret := range []string{pn.User, lid.User, "PRIVATE-MESSAGE-ID", "PRIVATE-RAW-ERROR", "@"} {
+							if strings.Contains(d[0].text, secret) {
+								t.Fatal("private data in new diagnostic")
+							}
+						}
+					})
+				}
+			}
+		}
+	}
+}
+
+func TestReceiptAliasIneligibleCasesNeverLookup(t *testing.T) {
+	pn, lid := types.NewJID("15550001111", types.DefaultUserServer), types.NewJID("123456", types.HiddenUserServer)
+	integrator := pn
+	integrator.Integrator = 2
+	for _, chat := range []types.JID{types.JID{}, types.NewJID("123", types.GroupServer), types.NewJID("123", types.BroadcastServer), types.NewJID("123", types.NewsletterServer), types.NewJID(pn.User, types.LegacyUserServer), types.PSAJID, integrator} {
+		h, s, _ := receiptHandler(map[types.MessageID]*storage.StoredMessage{"id": receiptStored(chat, true, nil)})
+		observer := &receiptAliasSpy{relation: storage.AliasPair}
+		h.storage.Lidmap = observer
+		h.handleReceipt(&events.Receipt{MessageSource: types.MessageSource{Chat: lid}, MessageIDs: []types.MessageID{"id"}, Type: types.ReceiptTypeRead})
+		if observer.calls != 0 || s.writes != 0 {
+			t.Fatal("ineligible chat queried or accepted")
+		}
+	}
+	h, s, log := receiptHandler(map[types.MessageID]*storage.StoredMessage{"id": receiptStored(pn, true, nil)})
+	h.handleReceipt(&events.Receipt{MessageSource: types.MessageSource{Chat: lid}, MessageIDs: []types.MessageID{"id"}, Type: types.ReceiptTypeRead})
+	if s.writes != 0 || !strings.HasSuffix(log.diagnostic()[0].text, "alias_relation=mapping_unavailable") {
+		t.Fatal("absent adapter")
+	}
+}
+
+func TestReceiptAliasOneBudgetPerBatchAndValidNextItem(t *testing.T) {
+	pn, lid := types.NewJID("15550001111", types.DefaultUserServer), types.NewJID("123456", types.HiddenUserServer)
+	h, s, log := receiptHandler(map[types.MessageID]*storage.StoredMessage{
+		"first": receiptStored(pn, true, nil), "second": receiptStored(pn, false, nil), "valid": receiptStored(lid, true, nil)})
+	observer := &receiptAliasSpy{wait: true}
+	h.storage.Lidmap = observer
+	start := time.Now()
+	h.handleReceipt(&events.Receipt{MessageSource: types.MessageSource{Chat: lid}, MessageIDs: []types.MessageID{"first", "second", "valid"}, Type: types.ReceiptTypeRead})
+	if elapsed := time.Since(start); elapsed > 500*time.Millisecond {
+		t.Fatal("diagnostic batch wait not bounded")
+	}
+	if observer.calls != 2 || observer.deadlineMissing || s.writes != 1 || len(log.diagnostic()) != 2 {
+		t.Fatal("batch behavior changed")
+	}
+	if s.messages["first"].Status != nil || s.messages["second"].Status != nil || *s.messages["valid"].Status != storage.StatusRead {
+		t.Fatal("wrong cached status")
+	}
+}
