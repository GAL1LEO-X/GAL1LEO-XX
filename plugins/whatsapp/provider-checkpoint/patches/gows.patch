+func TestABStateRPCOfflineBufconn(t *testing.T) {
+	fake := &abStateRPCCapture{outcome: gows.ABMutationAccepted}
+	var sessions []string
+	service := &Server{ABClientResolver: func(session string) (gows.ABClient, error) {
+		sessions = append(sessions, session)
+		if session != "synthetic-owner-a" {
+			return nil, nil
+		}
+		return fake, nil
+	}}
+	listener := bufconn.Listen(1024 * 1024)
+	grpcServer := grpc.NewServer()
+	pb.RegisterMessageServiceServer(grpcServer, service)
+	go func() { _ = grpcServer.Serve(listener) }()
+	t.Cleanup(grpcServer.Stop)
+	t.Cleanup(func() { _ = listener.Close() })
+	connection, err := grpc.NewClient("passthrough:///offline-ab-state", grpc.WithTransportCredentials(insecure.NewCredentials()), grpc.WithContextDialer(func(ctx context.Context, _ string) (net.Conn, error) { return listener.DialContext(ctx) }))
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = connection.Close() })
+	client := pb.NewMessageServiceClient(connection)
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	session := &pb.Session{Id: "synthetic-owner-a"}
+	const timestampMS int64 = 1672531200123
+	for _, value := range []bool{true, false} {
+		req := &pb.SetChatArchivedRequest{Session: session, Jid: "12025550101@s.whatsapp.net", Archived: value, IntentId: "archive_intent", TimestampMs: timestampMS}
+		response, err := client.SetChatArchived(ctx, req)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if response.GetOutcome() != pb.ABMutationOutcome_AB_MUTATION_ACCEPTED || response.GetIntentId() != req.GetIntentId() || fake.archived != value || fake.chat.String() != req.GetJid() || fake.intent.TimestampMS != timestampMS || len(fake.ranges) != 0 {
+			t.Fatal("archive request mapping mismatch")
+		}
+		key := &pb.ABMessageKey{Chat: "12025550101-123@g.us", Id: "FULL_MESSAGE_ID", FromMe: false, Participant: "900001@lid"}
+		star := &pb.SetMessageStarRequest{Session: session, Key: key, Starred: value, IntentId: "star_intent", TimestampMs: timestampMS}
+		response, err = client.SetMessageStar(ctx, star)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if response.GetOutcome() != pb.ABMutationOutcome_AB_MUTATION_ACCEPTED || fake.starred != value || fake.key.Chat.String() != key.GetChat() || fake.key.Participant.String() != key.GetParticipant() || fake.key.ID != key.GetId() || fake.key.FromMe || fake.intent.TimestampMS != timestampMS {
+			t.Fatal("full star identity mapping mismatch")
+		}
+	}
+	if fake.archiveCalls != 2 || fake.starCalls != 2 || !reflect.DeepEqual(sessions, []string{session.Id, session.Id, session.Id, session.Id}) {
+		t.Fatal("wrong session isolation or unexpected dispatch count")
+	}
+	fake.state = gows.ABChatArchiveState{Known: false, Archived: true, Source: "synthetic_cache", PhoneFresh: false}
+	observed, err := client.GetChatArchiveState(ctx, &pb.JidRequest{Session: session, Jid: "900001@lid"})
+	if err != nil || observed.GetKnown() || observed.GetArchived() || observed.GetPhoneFresh() || observed.GetSource() != "synthetic_cache" {
+		t.Fatal("unknown cache incorrectly became observed false/phone fresh")
+	}
+	fake.state = gows.ABChatArchiveState{Known: true, Archived: false, Source: "synthetic_cache", PhoneFresh: false}
+	observed, err = client.GetChatArchiveState(ctx, &pb.JidRequest{Session: session, Jid: "900001@lid"})
+	if err != nil || !observed.GetKnown() || observed.GetArchived() || observed.GetPhoneFresh() {
+		t.Fatal("observed unarchived cache lost")
+	}
+	before := fake.archiveCalls
+	_, err = client.SetChatArchived(ctx, &pb.SetChatArchivedRequest{Session: &pb.Session{Id: "synthetic-owner-b"}, Jid: "900001@lid", Archived: true, IntentId: "wrong_session", TimestampMs: timestampMS})
+	if status.Code(err) != codes.NotFound || fake.archiveCalls != before {
+		t.Fatal("wrong session reached owner-a backend")
+	}
+	fake.outcome = gows.ABMutationUncertain
+	fake.err = errors.New("private post-send failure")
+	response, err := client.SetMessageStar(ctx, &pb.SetMessageStarRequest{Session: session, Key: &pb.ABMessageKey{Chat: "900001@lid", Id: "M"}, Starred: true, IntentId: "uncertain_intent", TimestampMs: timestampMS})
+	if err != nil || response.GetOutcome() != pb.ABMutationOutcome_AB_MUTATION_UNCERTAIN || response.GetIntentId() != "uncertain_intent" || fake.starCalls != 3 {
+		t.Fatal("uncertain RPC must remain uncertain and invoke backend once")
+	}
+}
